<% content_for :title, t(".title") %>
<%# The newest two versions open, older ones folded. A version this device updated to since you last
    came here gets a New tag (app-update controller), and opening the page checks for updates %>
<% entries = AppVersion.entries %>
<% entry_card = ->(entry) do %>
  <div class="space-y-1.5 rounded-xl border bg-white p-4" data-version="<%= entry.version %>">
    <p class="flex flex-wrap items-center gap-2 font-semibold"><span><%= entry.version %> · <%= l(entry.date, format: :long) %></span><span hidden data-new-tag class="rounded-full bg-blue-700 px-2 py-0.5 text-xs font-bold text-white"><%= t(".new") %></span></p>
    <ul class="list-disc space-y-0.5 pl-5 text-sm"><% entry.notes.each do |note| %><li><%= note %></li><% end %></ul>
  </div>
<% end %>
<div class="w-full mx-auto max-w-2xl space-y-6 py-4" data-app-update-target="about">
  <section id="app-version" class="flex flex-col items-center gap-2 rounded-xl border bg-white p-5 text-center">
    <%= image_tag "logo-sticker.png", alt: "", class: "h-16 w-16 object-contain" %>
    <h1 class="text-xl font-bold">Household Tracker</h1>
    <p><span class="block text-sm text-gray-600"><%= t(".version") %></span><span class="text-3xl font-extrabold tracking-wide"><%= AppVersion.current %></span></p>
    <span class="text-sm text-gray-600" data-app-update-target="status" aria-live="polite"></span>
    <button type="button" data-action="app-update#checkNow" class="btn-press min-h-11 rounded-xl bg-blue-200 text-fit text-gray-900 cursor-pointer px-4 py-2 font-medium"><%= t(".check_updates") %></button>
    <p class="text-sm text-gray-500"><%= t(".auto_update_hint") %></p>
  </section>

  <section id="whats_new" class="space-y-3">
    <h2 class="text-lg font-semibold"><%= t(".whats_new") %></h2>
    <% entries.first(2).each { |entry| entry_card.(entry) } %>
    <% if entries.size > 2 %>
      <details class="space-y-3">
        <summary class="cursor-pointer text-center text-sm font-semibold text-blue-800"><%= t(".older") %></summary>
        <div class="space-y-3"><% entries.drop(2).each { |entry| entry_card.(entry) } %></div>
      </details>
    <% end %>
  </section>
</div>
