<% field = "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
<%= form_with model: [ Current.household, category ], class: "space-y-4" do |form| %>
  <% if category.errors.any? %>
    <ul class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><% category.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  <% end %>
  <% if category.new_record? %>
    <%= form.label :record_type, class: "block text-sm font-medium" %>
    <%= form.select :record_type, Category::RECORD_TYPES.values.map { |v| [ t("records.types.#{v}"), v ] }, {}, class: field %>
  <% else %>
    <p class="text-sm text-gray-600"><%= record_type_label(category.record_type) %></p>
  <% end %>
  <%= form.label :name_zh, class: "block text-sm font-medium" %>
  <%= form.text_field :name_zh, required: true, maxlength: 40, class: field %>
  <%= form.label :name_en, class: "block text-sm font-medium" %>
  <%= form.text_field :name_en, maxlength: 40, class: field %>
  <div class="flex gap-3">
    <%= form.button type: "submit", name: nil, class: "btn-press inline-flex items-center gap-1.5 rounded-xl bg-blue-200 text-gray-900 cursor-pointer px-3.5 py-2 font-medium" do %><%= image_tag "icons/save.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("records.form.save") %></span><% end %>
    <%= cancel_link(household_categories_path(Current.household)) %>
  </div>
<% end %>
