<% content_for :title, t(".title") %>
<% writer = policy(Category).write? %>
<% content_for :settings_section do %>
<div class="w-full mx-auto max-w-2xl space-y-6 py-4">
  <%= render "shared/flash" %>
  <%= page_title("categories.png", t(".title")) %>
  <p class="text-sm text-gray-600"><%= t(".intro") %></p>
  <% @categories.group_by(&:record_type).each do |type, categories| %>
    <section class="space-y-2">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold"><%= record_type_label(type) %></h2>
        <% if writer %><%= link_to new_household_category_path(Current.household, record_type: type), class: "inline-flex items-center gap-1 text-sm underline" do %><%= image_tag "icons/add.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".new") %></span><% end %><% end %>
      </div>
      <ul class="divide-y rounded-lg border">
        <% categories.each do |category| %>
          <% count = @counts[category.id].to_i %>
          <li class="space-y-1 px-4 py-2 <%= 'text-gray-400' if category.archived_at %>">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span><%= category.name_zh %><%= " / #{category.name_en}" if category.name_en.present? %>
                <span class="text-sm text-gray-500"><%= t(".records", count:) %><%= " · #{t('.detail', label: category.detail_label)}" if category.detail_required %><%= " · #{t('.archived')}" if category.archived_at %></span></span>
              <% if writer %>
                <span class="flex gap-3 text-sm">
                  <%= link_to edit_household_category_path(Current.household, category), class: "inline-flex items-center gap-1 underline" do %><%= image_tag "icons/edit.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".edit") %></span><% end %>
                  <% if count.zero? %>
                    <%= button_to household_category_path(Current.household, category), method: :delete, form: { data: { turbo_confirm: t(".delete_confirm") } }, class: "inline-flex items-center gap-1 cursor-pointer text-red-700 underline" do %><%= image_tag "icons/delete.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".delete") %></span><% end %>
                  <% else %>
                    <%= button_to archive_household_category_path(Current.household, category), class: "inline-flex items-center gap-1 cursor-pointer underline" do %><% if category.archived_at %><%= t(".unarchive") %><% else %><%= image_tag "icons/archive.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".archive") %></span><% end %><% end %>
                  <% end %>
                </span>
              <% end %>
            </div>
            <% if category.category_aliases.any? %>
              <%# Names from the sheet the import sorts into this category; removing one only forgets the link %>
              <div class="space-y-1 text-xs text-gray-600">
                <p class="font-medium"><%= t(".aliases") %></p>
                <ul class="flex flex-wrap gap-1.5">
                  <% category.category_aliases.sort_by(&:alias).each do |item| %>
                    <li class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border border-gray-300 bg-white py-0.5 pl-2.5 <%= writer ? 'pr-1' : 'pr-2.5' %>">
                      <span><%= item.alias %></span>
                      <% if writer %>
                        <%= button_to destroy_alias_household_categories_path(Current.household, alias_id: item.id), method: :delete,
                              form: { data: { turbo_confirm: t(".remove_alias_confirm", alias: item.alias) } },
                              title: t(".remove_alias", alias: item.alias), "aria-label": t(".remove_alias", alias: item.alias),
                              class: "inline-flex cursor-pointer items-center gap-0.5 rounded-full px-1.5 py-0.5 text-red-700 hover:bg-red-50" do %><%= image_tag "icons/delete.png", alt: "", class: "h-3.5 w-3.5 object-contain" %><span><%= t(".remove") %></span><% end %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
                <p class="text-gray-500"><%= t(".aliases_hint") %></p>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
  <%# The ledger's own supply categories (the item form's Category list). Each ledger starts with six;
      "Other" always stays, and one with items is archived, not deleted %>
  <section id="supplies" class="scroll-mt-24 space-y-2">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-semibold"><%= image_tag "icons/ledger.png", alt: "", class: "inline h-[1.2em] w-[1.2em] object-contain align-[-0.25em]" %> <%= t(".supplies") %></h2>
      <% if policy(SupplyCategory).write? %><%= link_to new_household_supply_category_path(Current.household), class: "inline-flex items-center gap-1 text-sm underline" do %><%= image_tag "icons/add.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".new") %></span><% end %><% end %>
    </div>
    <p class="text-sm text-gray-600"><%= t(".supplies_intro") %></p>
    <ul class="divide-y rounded-lg border">
      <% @supply_categories.each do |category| %>
        <% count = @supply_counts[category.id].to_i %>
        <%# One name only, and someone reads the ledger in the other language: a tag that opens Edit %>
        <% missing = (supply_category_missing_name(category) if policy(category).update?) %>
        <li class="px-4 py-2 <%= 'text-gray-400' if category.archived_at %>">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span><%= category.names.join(" / ") %>
              <span class="text-sm text-gray-500"><%= safe_join([ t(".items", count:), (t(".perishable") if category.perishable?), (t(".always_kept") if category.fallback?), (t(".archived") if category.archived_at) ].compact, " · ") %></span>
              <% if missing %><%= link_to t(".add_name.#{missing}"), edit_household_supply_category_path(Current.household, category), class: "ml-1 inline-block rounded-full border border-amber-400 bg-amber-100 px-2.5 py-0.5 align-middle text-xs font-bold whitespace-nowrap text-amber-900" %><% end %></span>
            <% if policy(category).update? %>
              <span class="flex gap-3 text-sm">
                <%= link_to edit_household_supply_category_path(Current.household, category), class: "inline-flex items-center gap-1 underline" do %><%= image_tag "icons/edit.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".edit") %></span><% end %>
                <% if category.fallback? %>
                <% elsif count.zero? %>
                  <%= button_to household_supply_category_path(Current.household, category), method: :delete, form: { data: { turbo_confirm: t(".delete_confirm") } }, class: "inline-flex items-center gap-1 cursor-pointer text-red-700 underline" do %><%= image_tag "icons/delete.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".delete") %></span><% end %>
                <% else %>
                  <%= button_to archive_household_supply_category_path(Current.household, category), class: "inline-flex items-center gap-1 cursor-pointer underline" do %><% if category.archived_at %><%= t(".unarchive") %><% else %><%= image_tag "icons/archive.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".archive") %></span><% end %><% end %>
                <% end %>
              </span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
</div>
<% end %>
<%= render "household_settings/layout", current: :categories %>
