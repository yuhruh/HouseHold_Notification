<%# One chart card: the ECharts canvas plus a "view as table" toggle (PRD §8 accessibility) %>
<section class="space-y-2 rounded-lg border-2 border-taupe-600 p-3">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="font-semibold"><%= title %></h2>
    <%= local_assigns[:extra] %>
  </div>
  <div class="h-72 w-full" role="img" aria-label="<%= title %>" data-controller="chart"
       data-chart-option-value="<%= option.to_json %>" data-chart-frame-value="drilldown"
       data-chart-drill-url-value="<%= drilldown_household_dashboard_path(Current.household) %>"
       data-chart-record-url-value="<%= household_record_path(Current.household, 'RECORD_ID') %>"></div>
  <details class="text-sm">
    <summary class="cursor-pointer text-gray-600"><%= t("dashboards.show.as_table") %></summary>
    <div class="mt-2 overflow-x-auto">
      <table class="w-full text-left border-separate border-spacing-0">
        <thead class="[&_th]:border-b [&_th]:border-gray-400"><tr><th class="pr-3 text-center"></th><% table[:columns].each do |c| %><th class="pr-3 text-center"><%= c %></th><% end %></tr></thead>
        <tbody>
          <% table[:rows].each do |label, values| %>
            <tr><th class="pr-3 font-sm text-center"><%= label %></th><% values.each do |v| %><td class="pr-3 text-center"><%= v.is_a?(Numeric) ? money(v, @query.currency) : v %></td><% end %></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </details>
</section>
