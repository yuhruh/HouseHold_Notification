<%= turbo_frame_tag "drilldown" do %>
  <section class="space-y-2 rounded-lg border p-3">
    <h2 class="font-semibold"><%= t(".title", count: @rows.size) %>
      <span class="text-sm font-normal text-gray-600">· <%= @query.year || t("dashboards.show.all_years") %><%= " #{t("date.abbr_month_names")[@month.to_i]}" if @month %> · <%= t("dashboards.show.modes.#{@query.mode}") %> · <%= @query.currency %></span></h2>
    <% if @group&.dig(:stats) %>
      <% box = @group[:stats][:box] %>
      <p class="text-sm text-gray-600"><%= t(".quartiles", q1: money(box[1], @query.currency), median: money(box[2], @query.currency), q3: money(box[3], @query.currency)) %></p>
    <% end %>
    <% rows = @box ? @rows.sort_by { |r, _| r.amount_paid } : @rows %>
    <%# One card per record on a phone, a table from sm up. A bill split across periods shows its share here,
        with the full amount under it, so the rows add up to the total %>
    <ul class="space-y-2 sm:hidden">
      <% rows.each do |record, amount| %>
        <% shown = @box ? record.amount_paid : amount %>
        <li class="card-raised-sm space-y-1 rounded-xl bg-white px-3 py-2.5">
          <div class="flex items-baseline gap-2"><%= link_to record.title, household_record_path(Current.household, record), data: { turbo_frame: "_top" }, class: "min-w-0 flex-1 break-words font-semibold text-blue-700 underline" %>
            <span class="whitespace-nowrap text-right"><span class="block font-bold"><%= money(shown, record.currency) %></span>
              <% if shown != record.amount_paid %><span class="block text-xs text-gray-500"><%= t(".of_full", amount: money(record.amount_paid, record.currency)) %></span><% end %></span></div>
          <p class="text-xs text-gray-600"><%= safe_join([ record.period.to_s, "#{t("records.index.paid_on")} #{l(record.paid_on)}", record.payment_method&.name ].compact_blank, " · ") %></p>
          <% if record.details.present? %><p class="line-clamp-2 text-xs text-gray-500"><%= record.details %></p><% end %>
        </li>
      <% end %>
    </ul>
    <% unless @box %>
      <p class="flex justify-between border-t-2 border-zinc-500 pt-2 font-bold sm:hidden"><span><%= t(".total") %></span><span><%= money(@total, @query.currency) %></span></p>
    <% end %>
    <div class="hidden overflow-x-auto sm:block">
      <table class="w-full text-sm border-separate border-spacing-0 rounded-lg border-2 border-zinc-500">
        <thead class="text-left [&_th]:border-b [&_th]:border-gray-400"><tr>
          <th class="py-1 pr-2"><%= t("records.index.period") %></th><th class="py-1 pr-2"><%= t("records.index.item") %></th>
          <th class="py-1 pr-2 text-right"><%= t("records.index.paid") %></th>
          <th class="py-1 pr-2"><%= t("records.index.paid_on") %></th><th class="py-1 pr-2"><%= Record.human_attribute_name(:payment_method) %></th></tr></thead>
        <tbody>
          <% rows.each do |record, amount| %>
            <% shown = @box ? record.amount_paid : amount %>
            <tr class="align-top"><td class="whitespace-nowrap py-1 pr-2"><%= record.period %></td>
              <td class="py-1 pr-2"><%= link_to record.title, household_record_path(Current.household, record), data: { turbo_frame: "_top" }, class: "text-blue-700 underline" %><span class="block text-xs text-gray-500"><%= record.details %></span></td>
              <td class="whitespace-nowrap py-1 pr-2 text-right font-medium"><%= money(shown, record.currency) %>
                <% if shown != record.amount_paid %><span class="block text-xs font-normal text-gray-500"><%= t(".of_full", amount: money(record.amount_paid, record.currency)) %></span><% end %></td>
              <td class="whitespace-nowrap py-1 pr-2"><%= l(record.paid_on) %></td>
              <td class="py-1 pr-2"><%= record.payment_method&.name %></td></tr>
          <% end %>
        </tbody>
        <% unless @box %>
          <tfoot><tr class="font-semibold"><td colspan="2" class="py-1 pr-2 text-right"><%= t(".total") %></td>
            <td class="whitespace-nowrap py-1 pr-2 text-right" id="drilldown-total"><%= money(@total, @query.currency) %></td><td colspan="2"></td></tr></tfoot>
        <% end %>
      </table>
    </div>
  </section>
<% end %>
