<% content_for :title, t(".title") %>
<% q = @query %>
<div class="w-full space-y-6 py-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <%= page_title("dashboard.png", t(".title")) %>
  </div>

  <%= form_with url: household_dashboard_path(Current.household), method: :get, class: "flex flex-wrap items-center gap-2 text-sm" do |f| %>
    <%= f.select :year, [ [ t(".all_years"), DashboardQuery::ALL ] ] + q.years, { selected: q.year_param }, class: "rounded-md border border-gray-400 px-2 py-1.5", "aria-label": t("records.index.year"), onchange: "this.form.requestSubmit()" %>
    <%= f.select :currency, Household::CURRENCIES, { selected: q.currency }, class: "rounded-md border border-gray-400 px-2 py-1.5", "aria-label": Record.human_attribute_name(:currency), onchange: "this.form.requestSubmit()" %>
    <%= f.select :type, Category::RECORD_TYPES.values.map { |v| [ t("records.types.#{v}"), v ] }, { include_blank: t("records.index.all_types"), selected: q.record_type }, class: "rounded-md border border-gray-400 px-2 py-1.5", "aria-label": t("records.index.type"), onchange: "this.form.requestSubmit()" %>
    <%= hidden_field_tag :mode, q.mode %>
    <%= hidden_field_tag :utility_mode, @utility_query.mode %>
    <%= hidden_field_tag :cycle_category, @cycle_category&.id %>
    <%= hidden_field_tag :cycle_view, @cycle_view %>
    <noscript><%= f.submit t("records.index.filter"), name: nil, class: "btn-press rounded-xl bg-gray-200 text-gray-900 cursor-pointer px-3 py-1.5 font-medium" %></noscript>
  <% end %>

  <div class="flex flex-wrap items-center gap-2 text-sm" data-controller="remember-mode" data-remember-mode-key-value="dashboard-mode" data-remember-mode-current-value="<%= q.mode %>" data-remember-mode-param-value="mode">
    <span class="text-gray-600"><%= t(".count_by") %></span>
    <% DashboardQuery::MODES.each do |mode| %>
      <%= link_to t(".modes.#{mode}"), household_dashboard_path(Current.household, year: q.year_param, currency: q.currency, type: q.record_type, mode:, utility_mode: @utility_query.mode, cycle_category: @cycle_category&.id, cycle_view: @cycle_view),
            class: "btn-press press-sm rounded-full px-3 py-1 text-gray-900 #{q.mode == mode ? 'bg-blue-200' : 'bg-white'}", aria: { current: (q.mode == mode) },
            data: { action: "remember-mode#save", remember_mode_mode_param: mode } %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
    <%= link_to drilldown_household_dashboard_path(Current.household, mode: q.mode, year: q.year_param, currency: q.currency, record_type: q.record_type),
          class: "btn-press rounded-xl bg-white p-3 hover:bg-green-100", title: t(".show_paid"), data: { turbo_frame: "drilldown" } do %><p class="text-sm text-gray-600"><%= q.all_years? ? t(".spend_all") : t(".spend", year: q.year) %></p><p class="text-xl font-semibold"><%= money(q.total, q.currency) %></p><% end %>
    <%= link_to household_records_path(Current.household, status: "unpaid"), class: "btn-press rounded-xl bg-white p-3 hover:bg-red-100" do %><p class="text-sm text-gray-600"><%= t("records.status.unpaid") %></p><p class="text-xl font-semibold text-red-700"><%= @counts[:unpaid] %></p><% end %>
    <%= link_to household_records_path(Current.household, status: "overdue"), class: "btn-press rounded-xl bg-white p-3 hover:bg-amber-100" do %><p class="text-sm text-gray-600"><%= t("records.status.overdue") %></p><p class="text-xl font-semibold text-red-700"><%= @counts[:overdue] %></p><% end %>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <%= render "chart", title: q.all_years? ? t(".yearly") : t(".monthly"), option: @charts.monthly,
          table: { columns: @charts.labels, rows: q.monthly_by_type.map { |type, values| [ t("records.types.#{type}"), values ] } } %>
    <%= render "chart", title: t(".utilities"), option: @charts.utilities,
          extra: link_to(t(".switch_to", mode: t(".modes.#{(DashboardQuery::MODES - [ @utility_query.mode ]).first}")), household_dashboard_path(Current.household, year: q.year_param, currency: q.currency, type: q.record_type, mode: q.mode, utility_mode: (DashboardQuery::MODES - [ @utility_query.mode ]).first, cycle_category: @cycle_category&.id, cycle_view: @cycle_view), class: "text-xs text-blue-700 underline"),
          table: { columns: @charts.labels(@utility_query), rows: @utility_query.utility_trend.map { |c, values| [ c.name, values ] } } %>
    <% if @cycle_category %>
      <div class="lg:col-span-2">
        <% cycles = q.cycles(@cycle_category, gaps: @cycle_view == "timeline") %>
        <% keep = { year: q.year_param, currency: q.currency, type: q.record_type, mode: q.mode, utility_mode: @utility_query.mode } %>
        <% pill = ->(on) { "btn-press press-sm rounded-full px-2.5 py-0.5 text-xs text-gray-900 #{on ? 'bg-blue-200' : 'bg-white'}" } %>
        <% switches = capture do %>
          <div class="flex flex-wrap items-center gap-1.5">
            <% q.utility_categories.each do |c| %>
              <%= link_to c.name, household_dashboard_path(Current.household, **keep, cycle_category: c.id, cycle_view: @cycle_view), class: pill.(c == @cycle_category), aria: { current: (c == @cycle_category) } %>
            <% end %>
            <span class="mx-1 text-gray-400">|</span>
            <% DashboardsController::CYCLE_VIEWS.each do |view| %>
              <%= link_to t(".cycle_views.#{view}"), household_dashboard_path(Current.household, **keep, cycle_category: @cycle_category.id, cycle_view: view), class: pill.(view == @cycle_view), aria: { current: (view == @cycle_view) } %>
            <% end %>
          </div>
        <% end %>
        <%= render "chart", title: t(".cycles"), option: @cycle_view == "timeline" ? @charts.cycle_timeline(cycles) : @charts.cycle_yoy(cycles),
              extra: switches, table: @cycle_view == "timeline" ? @charts.cycle_timeline_table(cycles) : @charts.cycle_yoy_table(cycles) %>
        <p class="mt-1 text-xs text-gray-500"><%= t(".cycles_hint") %></p>
      </div>
    <% end %>
    <%= render "chart", title: t(".categories"), option: @charts.categories,
          table: { columns: [ t(".amount") ], rows: q.by_category.map { |c, v| [ c.name, [ v ] ] } } %>
    <%= render "chart", title: t(".payment_methods"), option: @charts.payment_methods,
          table: { columns: [ t(".amount") ], rows: q.by_payment_method.map { |pm, v| [ pm&.name || t(".no_payment_method"), [ v ] ] } } %>
    <div class="lg:col-span-2">
      <%= render "chart", title: t(".boxplot"), option: @charts.boxplot,
            table: { columns: [ t(".min"), "Q1", t(".median"), "Q3", t(".max"), t(".count") ],
                     rows: q.box_groups.map { |g| [ g[:category].name, (g[:stats] ? g[:stats][:box] : [ "–" ] * 5) + [ g[:records].size.to_s ] ] } } %>
      <p class="mt-1 text-xs text-gray-500"><%= t(".box_hint", min: DashboardQuery::BOX_MIN) %></p>
    </div>
  </div>

  <%= turbo_frame_tag "drilldown", autoscroll: true, data: { autoscroll_block: "nearest", autoscroll_behavior: "smooth" } do %>
    <p class="rounded-lg border border-dashed p-4 text-sm text-gray-500"><%= t(".drill_hint") %></p>
  <% end %>
</div>
