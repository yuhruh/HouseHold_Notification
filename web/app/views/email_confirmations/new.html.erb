<% content_for :title, t(".title") %>
<div class="mx-auto w-full max-w-sm space-y-6 py-8">
  <%= render "shared/flash" %>
  <h1 class="text-center text-3xl font-bold"><%= t(".title") %></h1>
  <%= form_with url: email_confirmations_path, class: "space-y-4" do |form| %>
    <%= form.label :email_address, t("auth.email"), class: "block text-sm font-medium" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", class: "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
    <%= form.submit t(".submit"), class: "btn-press rounded-xl bg-blue-200 text-gray-900 w-full cursor-pointer px-3.5 py-2.5 font-medium" %>
  <% end %>
</div>
