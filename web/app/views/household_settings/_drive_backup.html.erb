<%# Owner only; hidden until the Google client and encryption keys are set %>
<% backup = Current.household.drive_backup %>
<section id="drive-backup" class="card-raised-sm space-y-3 rounded-xl bg-white p-4">
  <h2 class="flex items-center gap-2 text-lg font-semibold"><%= image_tag "icons/google_connect.png", alt: "", class: "h-7 w-7 object-contain" %><%= t(".title") %></h2>
  <% button = "btn-press inline-flex items-center gap-2 rounded-xl bg-blue-200 text-gray-900 cursor-pointer px-3 py-2 font-medium" %>
  <% if backup.nil? %>
    <p class="text-gray-700"><%= t(".intro") %></p>
    <p class="text-sm text-gray-600"><%= t(".privacy") %></p>
    <%= button_to household_drive_backup_path(Current.household), method: :post, class: button, form: { data: { turbo: false } } do %><%= image_tag "icons/google_connect.png", alt: "", class: "h-5 w-5 object-contain" %><%= t(".connect") %><% end %>
  <% else %>
    <% if backup.problem %><p class="rounded-lg bg-amber-100 px-3 py-2 text-sm text-amber-900"><%= t("drive_backups.problems.#{backup.problem}") %></p><% end %>
    <p class="text-gray-700"><%= t(".connected_as", email: backup.google_email) %></p>
    <% if backup.restoring? %><%= link_to t(".restoring"), household_drive_restore_path(Current.household), class: "font-medium text-blue-700 underline" %><% end %>
    <% offer_restore = backup.found_backups.any? && !Current.household.records.exists? %>
    <% if offer_restore %>
      <% backup.found_backups.each do |found| %>
        <div class="space-y-2 rounded-lg bg-blue-100 px-3 py-2.5">
          <p class="font-bold"><%= t(".found") %></p>
          <p class="text-sm text-gray-800"><%= t(".found_detail", name: found["name"], date: l(Time.zone.parse(found["saved_at"]).to_date, format: :long), bills: found["bills"], photos: found["photos"]) %></p>
          <%= link_to t(".check_backup"), household_drive_restore_path(Current.household, folder: found["folder_id"]), class: "btn-press inline-flex items-center rounded-xl bg-blue-200 text-gray-900 px-3 py-2 font-medium" %>
        </div>
      <% end %>
      <p class="text-sm text-gray-600"><%= t(".found_hint") %></p>
      <%= button_to t(".start_fresh"), household_drive_restore_path(Current.household), method: :delete, class: "cursor-pointer text-blue-700 underline" %>
    <% end %>
    <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 text-sm">
      <dt class="text-gray-600"><%= t(".last_backup") %></dt>
      <dd class="font-medium"><%= backup.last_backup_at ? t(".last_backup_detail", time: l(backup.last_backup_at, format: :short), bills: backup.bills_count, photos: backup.photos_count) : t(".not_yet") %></dd>
      <% unless backup.needs_reconnect? || offer_restore %><dt class="text-gray-600"><%= t(".next_backup") %></dt><dd><%= t(".next_backup_detail") %></dd><% end %>
    </dl>
    <div class="flex flex-wrap items-center gap-3">
      <% if backup.needs_reconnect? %>
        <%= button_to household_drive_backup_path(Current.household), method: :post, class: button, form: { data: { turbo: false } } do %><%= image_tag "icons/google_connect.png", alt: "", class: "h-5 w-5 object-contain" %><%= t(".connect_again") %><% end %>
      <% elsif !offer_restore %>
        <%= button_to run_household_drive_backup_path(Current.household), method: :post, disabled: backup.running?, class: "#{button} disabled:cursor-not-allowed disabled:opacity-60" do %><%= image_tag "icons/back_up_now.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= backup.running? ? t(".running") : t(".back_up_now") %></span><% end %>
      <% end %>
      <% if backup.folder_url %><%= link_to backup.folder_url, target: "_blank", rel: "noopener", class: "btn-press inline-flex items-center gap-1.5 rounded-xl bg-white text-gray-900 px-3 py-2 font-medium" do %><%= image_tag "icons/open_folder.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t(".open_folder") %></span><% end %><% end %>
    </div>
    <%= button_to household_drive_backup_path(Current.household), method: :delete, class: "inline-flex cursor-pointer items-center gap-1 text-red-700 underline", form: { data: { turbo_confirm: t(".disconnect_confirm") } } do %><%= image_tag "icons/disconnect.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t(".disconnect") %></span><% end %>
    <p class="text-sm text-gray-600"><%= t(".disconnect_hint") %></p>
  <% end %>
</section>
