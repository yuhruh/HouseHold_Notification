<% content_for :title, t("accounts.show.danger_zone") %>
<% content_for :settings_section do %>
<div class="w-full mx-auto max-w-2xl space-y-8 py-4">
  <section class="space-y-3 rounded-lg shadow-md shadow-red-100 border-2 border-red-200 p-4">
    <h2 class="text-lg font-semibold text-red-700"><%= t("accounts.show.danger_zone") %></h2>
    <div class="grid grid-cols-1 gap-3 pr-1 md:grid-cols-3">
      <%= link_to new_household_ownership_transfer_path(Current.household), class: "btn-press flex items-center justify-center gap-1.5 min-w-0 rounded-xl bg-slate-200 text-center text-fit text-gray-900 cursor-pointer px-2 py-2 font-medium break-words" do %><%= image_tag "icons/transfer_ownership.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("household_settings.show.transfer") %></span><% end %>
      <%= link_to new_household_record_purge_path(Current.household), class: "btn-press flex items-center justify-center gap-1.5 min-w-0 rounded-xl bg-white text-center text-fit cursor-pointer px-2 py-2 font-medium text-red-700 break-words" do %><%= image_tag "icons/delete.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("household_settings.show.delete_records") %></span><% end %>
      <%= link_to new_household_deletion_path(Current.household), class: "btn-press flex items-center justify-center gap-1.5 min-w-0 rounded-xl bg-red-200 text-center text-fit text-red-900 cursor-pointer px-2 py-2 font-medium break-words" do %><%= image_tag "icons/delete.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("household_settings.show.delete") %></span><% end %>
    </div>
  </section>
</div>
<% end %>
<%= render "household_settings/layout", current: :danger %>
