<% content_for :title, t(".title") %>
<% owner = policy(Current.household).manage? %>
<div class="w-full mx-auto max-w-2xl space-y-8 py-4">
  <%= render "shared/flash" %>
  <h1 class="flex justify-center items-center gap-3 text-3xl font-bold"><%= image_tag "/household.png", alt: "", class: "h-10 w-10 object-contain" %><span><%= t(".title") %></span></h1>

  <%= form_with model: Current.household, url: household_settings_path(Current.household), method: :patch, class: "space-y-4" do |form| %>
    <% if Current.household.errors.any? %>
      <ul class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><% Current.household.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    <% end %>
    <fieldset class="space-y-4" <%= "disabled" unless owner %>>
      <%= form.label :name, class: "block text-sm font-medium" %>
      <%= form.text_field :name, required: true, maxlength: 60, class: "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
      <%= form.label :default_currency, class: "block text-sm font-medium" %>
      <%= form.select :default_currency, Household::CURRENCIES, {}, class: "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
      <%= form.label :reminder_lead_days, class: "block text-sm font-medium" %>
      <%= form.number_field :reminder_lead_days, min: 0, max: 30, required: true, class: "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
      <p class="text-sm text-gray-500"><%= t(".lead_days_hint") %></p>
      <% if owner %><%= form.button type: "submit", name: nil, class: "btn-press inline-flex items-center gap-1.5 rounded-xl bg-blue-200 text-gray-900 cursor-pointer px-3.5 py-2 font-medium" do %><%= image_tag "icons/save.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t(".save") %></span><% end %><% end %>
    </fieldset>
  <% end %>

  <p class="grid grid-cols-2 gap-3 pr-1 sm:flex sm:flex-wrap sm:gap-4"><%= link_to nav_label("members.png", t("households.show.members")), household_members_path(Current.household), class: "btn-press rounded-xl flex min-w-0 items-center justify-center gap-1 bg-amber-200 text-center text-fit text-gray-900 cursor-pointer px-2 py-2 font-medium sm:px-3.5 [&>img]:shrink-0" %>
    <% if owner %><%= link_to nav_label("reminder_delivery.png", t("reminder_deliveries.index.title")), household_reminder_deliveries_path(Current.household), class: "btn-press rounded-xl flex min-w-0 items-center justify-center gap-1 bg-teal-200 text-center text-fit text-gray-900 cursor-pointer px-2 py-2 font-medium sm:px-3.5 [&>img]:shrink-0" %><% end %></p>

  <% if owner %>
    <section class="space-y-3 rounded-lg shadow-md shadow-red-100 border-2 border-red-200 p-4">
      <h2 class="text-lg font-semibold text-red-700"><%= t("accounts.show.danger_zone") %></h2>
      <div class="grid grid-cols-1 gap-3 pr-1 md:grid-cols-3">
        <%= link_to t(".transfer"), new_household_ownership_transfer_path(Current.household), class: "btn-press block min-w-0 rounded-xl bg-slate-200 text-center text-fit text-gray-900 cursor-pointer px-2 py-2 font-medium break-words" %>
        <%= link_to new_household_record_purge_path(Current.household), class: "btn-press flex items-center justify-center gap-1.5 min-w-0 rounded-xl bg-white text-center text-fit cursor-pointer px-2 py-2 font-medium text-red-700 break-words" do %><%= image_tag "icons/delete.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t(".delete_records") %></span><% end %>
        <%= link_to new_household_deletion_path(Current.household), class: "btn-press flex items-center justify-center gap-1.5 min-w-0 rounded-xl bg-red-200 text-center text-fit text-red-900 cursor-pointer px-2 py-2 font-medium break-words" do %><%= image_tag "icons/delete.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t(".delete") %></span><% end %>
      </div>
    </section>
  <% end %>

  <section class="space-y-3 rounded-lg border p-4" id="app-version">
    <h2 class="text-lg font-semibold"><%= t(".app_version") %></h2>
    <p><%= t(".version_now", version: AppVersion.current) %></p>
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" data-action="app-update#checkNow" class="btn-press rounded-xl bg-blue-200 text-fit text-gray-900 cursor-pointer px-3.5 py-2 font-medium"><%= t(".check_updates") %></button>
      <span class="text-sm text-gray-600" data-app-update-target="status" aria-live="polite"></span>
    </div>
    <p class="text-sm text-gray-500"><%= t(".auto_update_hint") %></p>
    <details id="whats_new" class="text-sm">
      <summary class="cursor-pointer font-semibold text-blue-800"><%= t(".whats_new") %></summary>
      <div class="mt-3 space-y-3 rounded-lg border border-blue-200 bg-blue-50 p-3">
        <% AppVersion.entries.first(5).each do |entry| %>
          <div>
            <p class="font-semibold"><%= entry.version %> · <%= l(entry.date, format: :long) %></p>
            <ul class="list-disc space-y-0.5 pl-5"><% entry.notes.each do |note| %><li><%= note %></li><% end %></ul>
          </div>
        <% end %>
      </div>
    </details>
  </section>

  <%# Folded like What's New: the log can get long %>
  <details id="activity" class="space-y-2">
    <summary class="cursor-pointer text-lg font-semibold text-blue-800"><h2 class="inline"><%= t(".activity") %> (<%= @events.size %>)</h2></summary>
    <ul class="mt-2 divide-y rounded-lg border text-sm">
      <% @events.each do |event| %>
        <li class="px-4 py-2"><%= activity_line(event, @event_users) %>
          <span class="block text-gray-500"><%= l(event.created_at, format: :short) %></span></li>
      <% end %>
    </ul>
  </details>
</div>
