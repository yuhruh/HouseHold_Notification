<% content_for :title, Current.household.name %>
<div class="w-full max-w-2xl space-y-6 py-4">
  <%= render "shared/flash" %>
  <h1 class="text-3xl font-bold"><%= Current.household.name %></h1>
  <p class="text-sm text-gray-600"><%= t(".role", role: t("roles.#{Current.membership.role}")) %></p>
  <ul class="flex flex-col space-y-2 pt-4 text-sm">
    <% [ [ t("layouts.header.upcoming"), household_upcoming_path(Current.household) ], [ t(".records"), household_records_path(Current.household) ], [ t("layouts.header.dashboard"), household_dashboard_path(Current.household) ], [ t(".templates"), household_recurring_templates_path(Current.household) ], [ t(".categories"), household_categories_path(Current.household) ], [ t(".payment_methods"), household_payment_methods_path(Current.household) ],
         *([ [ t(".import"), new_household_import_path(Current.household) ] ] if policy(Current.household).write?),
         [ t(".members"), household_members_path(Current.household) ], [ t("layouts.header.settings"), household_settings_path(Current.household) ] ].each do |label, path| %>
      <li><%= link_to label, path, class: "block rounded-lg border px-4 py-3 font-medium hover:bg-sky-200 hover:text-sky-800 hover:border-sky-800 hover:underline underline-offset-4 hover:duration-300 ease-in" %></li>
    <% end %>
  </ul>
</div>
