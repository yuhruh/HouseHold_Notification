<% content_for :title, t(".title") %>
<div class="w-full max-w-3xl space-y-6 py-4">
  <h1 class="text-3xl font-bold text-red-700"><%= t(".title") %></h1>
  <p><%= t(".intro") %></p>
  <% if @result.file_errors.any? %>
    <ul class="list-disc rounded-lg bg-red-50 py-2 pl-8 pr-3 text-red-800"><% @result.file_errors.each do |e| %><li><%= e %></li><% end %></ul>
  <% else %>
    <p class="text-sm text-gray-600"><%= t(".count", count: @result.error_rows.size) %></p>
    <div class="overflow-x-auto rounded-lg border">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left border-b border-gray-400"><tr><th class="px-3 py-2"><%= t(".line") %></th><th class="px-3 py-2">ID</th><th class="px-3 py-2"><%= t(".errors") %></th></tr></thead>
        <tbody>
          <% @result.error_rows.each do |row| %>
            <tr class="align-top"><td class="px-3 py-1.5"><%= row.line %></td><td class="px-3 py-1.5"><%= row.id %></td>
              <td class="px-3 py-1.5"><ul><% row.errors.each do |e| %><li><%= e %></li><% end %></ul></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <p><%= link_to t(".again"), new_household_import_path(Current.household), class: "text-blue-700 underline" %></p>
</div>
