<% content_for :title, t(".title") %>
<div class="mx-auto w-full max-w-sm space-y-4 py-8">
  <h1 class="text-3xl font-bold"><%= t(".title") %></h1>
  <p><%= t(".body", household: @invitation.household.name, email: @email) %></p>
  <div class="flex flex-col gap-2">
    <%= link_to t("sessions.new.title"), new_session_path(email_address: @email), class: "btn-press rounded-xl bg-blue-200 text-gray-900 cursor-pointer px-3.5 py-2.5 font-medium text-center" %>
    <%= link_to t("registrations.new.title"), new_registration_path(email: @email), class: "btn-press rounded-xl bg-white text-gray-900 cursor-pointer px-3.5 py-2 font-medium text-center" %>
  </div>
</div>
