<% content_for :title, t(".title") %>
<div class="mx-auto w-full max-w-sm space-y-4 py-8">
  <h1 class="text-3xl font-bold"><%= t(".title") %></h1>
  <p><%= t(".body", household: @invitation.household.name, email: @email) %></p>
  <div class="flex flex-col gap-2">
    <%= link_to t("sessions.new.title"), new_session_path(email_address: @email), class: "cursor-pointer rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500 text-center" %>
    <%= link_to t("registrations.new.title"), new_registration_path(email: @email), class: "cursor-pointer rounded-md border border-gray-400 px-3.5 py-2 font-medium hover:bg-gray-50 text-center" %>
  </div>
</div>
