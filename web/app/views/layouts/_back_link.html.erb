<%# ‹ Back on every signed-in page except the household home it falls back to, and the guide and
    features pages, which have their own sticky "← Household Tracker" (back_controller.js) %>
<% unless (controller_name == "households" && action_name == "show") || (controller_name == "pages" && action_name.in?(%w[home guide features])) %>
  <% home = Current.household || Current.user.home_household %>
  <div class="container mx-auto px-4 pt-4 text-sm">
    <%= link_to t("layouts.back"), home ? household_path(home) : root_path, data: { controller: "back", action: "back#go" }, class: "text-blue-700 hover:underline" %>
  </div>
<% end %>
