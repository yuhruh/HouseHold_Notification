<%# Bills menu (computer, from 1550px): Pending, Records and Expense Analysis in one dropdown, the page
    you're on ticked. New Record is its own button in the bar, not in here %>
<% items = [
  [ "upcoming.png", t("layouts.header.pending"), t("layouts.header.pending_hint"), household_pending_path(household), current == :pending ],
  [ "records.png", t("layouts.header.records"), t("layouts.header.records_hint"), household_records_path(household), current == :records ],
  [ "dashboard.png", t("layouts.header.dashboard"), t("layouts.header.dashboard_hint"), household_dashboard_path(household), current == :dashboard ]
] %>
<details class="relative" data-controller="dropdown">
  <summary class="inline-flex cursor-pointer list-none items-center gap-1 rounded-lg px-2 py-1 hover:underline hover:font-bold <%= 'bg-sky-100 font-bold' if current %>">
    <%= image_tag "icons/records.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("layouts.header.bills") %></span>
    <% if due.positive? %><span class="rounded-full bg-red-600 px-1.5 text-xs text-white" aria-label="<%= t("layouts.header.due_count", count: due) %>"><%= due %></span><% end %>
    <span aria-hidden="true" class="text-gray-500">▾</span>
  </summary>
  <ul class="card-raised absolute left-0 z-50 mt-2 flex w-80 flex-col gap-1 rounded-2xl bg-white p-2">
    <% items.each_with_index do |(icon, label, hint, path, here), index| %>
      <li><%= link_to path, class: "flex items-center gap-3 rounded-xl p-2.5 hover:bg-gray-50 #{'bg-blue-50' if here}", "aria-current": (here ? "page" : nil) do %>
        <%= image_tag "icons/#{icon}", alt: "", class: "h-8 w-8 object-contain" %>
        <span class="flex flex-1 flex-col"><span class="font-bold"><%= label %></span><span class="text-xs text-gray-600"><%= hint %></span></span>
        <% if index.zero? && due.positive? %><span class="rounded-full bg-red-600 px-2 text-xs font-bold text-white"><%= due %></span><% end %>
        <% if here %><span aria-hidden="true" class="text-blue-700">✓</span><% end %>
      <% end %></li>
    <% end %>
  </ul>
</details>
