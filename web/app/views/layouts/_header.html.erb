<%# Signed-in header: Apartment menu (households + new household), pending invitations, sign out (PRD §12a) %>
<% households = Current.user.households.order(:name).to_a %>
<% pending = Invitation.pending_for(Current.user).count %>
<% unread = Current.user.notifications.unread.count %>
<%# Pages outside a household (inbox, My account) still link to the last one used %>
<% nav_household = Current.household || households.find { |h| h.id == Current.user.last_household_id } || households.first %>
<header class="border-b">
  <div class="container mx-auto flex flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm">
    <%= link_to features_path, class: "flex items-center gap-2 font-semibold" do %>
      <%= image_tag "logo-sticker.png", alt: "", class: "h-7 w-auto" %>
      <span>Household Tracker</span>
    <% end %>
    <nav class="flex flex-wrap items-center gap-3">
      <span data-controller="install"><button type="button" hidden data-install-target="button" data-action="install#install" class="cursor-pointer rounded-md bg-blue-300 px-2 py-1 text-blue-900 transition-transform duration-150 hover:bg-blue-400 motion-safe:hover:scale-110"><span class="flex items-center gap-1"><%= nav_label("install.png", t("layouts.header.install")) %></span></button></span>
      <% if pending.positive? %>
        <%= link_to t("layouts.header.invitations", count: pending), invitations_path, class: "rounded-md bg-amber-100 px-2 py-1 text-amber-900" %>
      <% end %>
      <%= link_to notifications_path, class: "relative px-2 py-1", "aria-label": t("layouts.header.inbox", count: unread) do %><%= image_tag "icons/reminder.png", alt: "", class: "h-6 w-6 object-contain" %><% if unread.positive? %><span class="absolute -right-1 -top-1 rounded-full bg-red-600 px-1.5 text-xs text-white"><%= unread %></span><% end %><% end %>
      <% if nav_household %>
        <%= render "layouts/household_menu", households:, current: nav_household %>
        <%= link_to nav_label("upcoming.png", t("layouts.header.upcoming")), household_upcoming_path(nav_household), class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
        <%= link_to nav_label("records.png", t("layouts.header.records")), household_records_path(nav_household), class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
        <%= link_to nav_label("dashboard.png", t("layouts.header.dashboard")), household_dashboard_path(nav_household), class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
        <%= link_to nav_label("settings.png", t("layouts.header.settings")), household_settings_path(nav_household), class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
      <% end %>
      <%= link_to nav_label("guide.png", t("layouts.header.guide")), guide_path, class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
      <%= link_to nav_label("account.png", t("layouts.header.account")), account_path, class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
      <%= button_to nav_label("logout.png", t("layouts.header.sign_out")), session_path, method: :delete, class: "inline-flex cursor-pointer items-center gap-1 rounded-md px-2 py-1 text-gray-700 underline" %>
      <%= render "layouts/theme_switch" %>
      <%= render "layouts/language_switch" %>
    </nav>
  </div>
</header>
