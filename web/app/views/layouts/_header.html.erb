<%# Signed-in header (PRD §12a): the logo and the household menu (switch households, its Settings and
    Members) on the left, then Bills and Expense Analysis from 1550px; the inbox, New Record (from 1550px)
    and your menu (My Account, theme, language, Getting Started, Sign Out) on the right. Under 1550px the
    tab bar at the bottom has Bills, Analysis and New Record, and the two menus open as sheets on a phone %>
<% households = Current.user.households.order(:name).to_a %>
<% pending = Invitation.pending_for(Current.user).count %>
<% unread = Current.user.notifications.unread.count %>
<%# Pages outside a household (inbox, My account) still link to the last one used %>
<% nav_household = Current.household || households.find { |h| h.id == Current.user.last_household_id } || households.first %>
<%# Bills (To Pay and All) or Expense Analysis: the page you're on, the unpaid bills due today or earlier
    for the red count, and New Record for owners and co-owners %>
<% bills_page = { "pending" => :bills, "records" => (:bills if action_name == "index"), "dashboards" => :dashboard }[controller_name] %>
<%# The other links' page, tinted like the Bills page you're on: Settings covers the pages it opens %>
<% nav_page = case controller_path
   when "household_settings", "members", "memberships", "household_invitations", "invitation_links", "reminder_deliveries",
        "ownership_transfers", "household_deletions", "record_purges" then :settings
   when "accounts", %r{\Aaccount/} then :account
   when "notifications" then :inbox
   when "pages" then (:guide if action_name == "guide")
   end %>
<% due = nav_household ? nav_household.records.where(settled: false, due_on: ..Date.current).count : 0 %>
<% writer = nav_household && Current.user.memberships.find_by(household: nav_household)&.can_write? %>
<% inbox = capture do %>
  <%= link_to notifications_path, class: "relative rounded-lg p-1.5 hover:scale-110 #{'bg-blue-100' if nav_page == :inbox}", "aria-label": t("layouts.header.inbox", count: unread) do %><%= image_tag "icons/reminder.png", alt: "", class: "h-6 w-6 object-contain" %><% if unread.positive? %><span class="absolute -right-1 -top-1 rounded-full bg-red-600 px-1.5 text-xs text-white"><%= unread %></span><% end %><% end %>
<% end %>
<%# Pinned at the top of every page, above the tab bar (z-40) so its menus and sheets cover it %>
<header class="sticky top-0 z-50 border-b bg-mauve-100">
  <div class="container mx-auto flex items-center justify-between gap-3 px-4 py-2.5 text-sm">
    <div class="flex min-w-0 items-center gap-3">
      <%= link_to features_path, class: "flex shrink-0 items-center gap-2 font-semibold", "aria-label": "Household Tracker" do %>
        <%= image_tag "logo-sticker.png", alt: "", class: "h-7 w-auto" %>
        <span class="hidden sm:inline">Household Tracker</span>
      <% end %>
      <% if nav_household %>
        <%= render "layouts/household_menu", households:, current: nav_household, pending:, here: nav_page == :settings %>
        <nav class="hidden items-center gap-1 min-[1550px]:flex">
          <%= link_to household_pending_path(nav_household), class: "inline-flex items-center gap-1 rounded-lg px-2 py-1 hover:underline hover:font-bold #{'bg-blue-100 font-bold text-blue-900' if bills_page == :bills}", "aria-current": (bills_page == :bills ? "page" : nil) do %>
            <%= nav_label("records.png", t("layouts.header.bills")) %>
            <% if due.positive? %><span class="rounded-full bg-red-600 px-1.5 text-xs text-white" aria-label="<%= t("layouts.header.due_count", count: due) %>"><%= due %></span><% end %>
          <% end %>
          <%= link_to nav_label("dashboard.png", t("layouts.header.dashboard")), household_dashboard_path(nav_household), class: "inline-flex items-center gap-1 rounded-lg px-2 py-1 hover:underline hover:font-bold #{'bg-blue-100 font-bold text-blue-900' if bills_page == :dashboard}", "aria-current": (bills_page == :dashboard ? "page" : nil) %>
        </nav>
      <% elsif pending.positive? %>
        <%= link_to t("layouts.header.invitations", count: pending), invitations_path, class: "rounded-md bg-amber-100 px-2 py-1 text-amber-900" %>
      <% end %>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <%= inbox %>
      <% if writer %>
        <%= link_to nav_label("new_entry.png", t("layouts.header.new_record")), new_household_record_path(nav_household), class: "btn-press btn-new press-sm hidden items-center gap-1 rounded-xl px-3 py-1.5 font-bold min-[1550px]:inline-flex" %>
      <% end %>
      <%= render "layouts/you_menu", nav_page:, here: %i[account guide].include?(nav_page) %>
    </div>
  </div>
</header>
<% if nav_household %>
  <%= render "layouts/tab_bar", household: nav_household, current: bills_page, due:, writer: %>
<% end %>
