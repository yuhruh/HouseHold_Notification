<%# Signed-in header: household switcher (only with 2+ memberships), pending invitations, sign out (PRD §12a) %>
<% households = Current.user.households.order(:name).to_a %>
<% pending = Invitation.pending_for(Current.user).count %>
<% unread = Current.user.notifications.unread.count %>
<%# Pages outside a household (inbox, My account) still link to the last one used %>
<% nav_household = Current.household || households.find { |h| h.id == Current.user.last_household_id } || households.first %>
<header class="border-b">
  <div class="container mx-auto flex flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm">
    <%= link_to root_path, class: "flex items-center gap-2 font-semibold" do %>
      <%= image_tag "logo-sticker.png", alt: "", class: "h-7 w-auto" %>
      <span>Household Tracker</span>
    <% end %>
    <nav class="flex flex-wrap items-center gap-3">
      <span data-controller="install"><button type="button" hidden data-install-target="button" data-action="install#install" class="cursor-pointer rounded-md bg-blue-600 px-2 py-1 text-white"><%= t("layouts.header.install") %></button></span>
      <% if households.size > 1 %>
        <details class="relative" data-controller="dropdown">
          <summary class="cursor-pointer rounded-md border border-gray-300 px-2 py-1"><%= t("layouts.header.switch") %></summary>
          <ul class="absolute right-0 z-10 mt-1 min-w-48 rounded-md border bg-white py-1 shadow">
            <% households.each do |household| %>
              <li><%= link_to household.name, household_path(household), class: "block px-3 py-2 hover:bg-gray-50 #{'font-semibold' if household == Current.household}" %></li>
            <% end %>
            <li class="border-t"><%= link_to t("layouts.header.new_household"), onboarding_path, class: "block px-3 py-2 text-blue-700 hover:bg-gray-50" %></li>
          </ul>
        </details>
      <% end %>
      <% if pending.positive? %>
        <%= link_to t("layouts.header.invitations", count: pending), invitations_path, class: "rounded-md bg-amber-100 px-2 py-1 text-amber-900" %>
      <% end %>
      <%= link_to notifications_path, class: "relative px-2 py-1", "aria-label": t("layouts.header.inbox", count: unread) do %>🔔<% if unread.positive? %><span class="absolute -right-1 -top-1 rounded-full bg-red-600 px-1.5 text-xs text-white"><%= unread %></span><% end %><% end %>
      <% if nav_household %>
        <%= link_to nav_label("📅", t("layouts.header.upcoming")), household_upcoming_path(nav_household), class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
        <%= link_to nav_label("📋", t("layouts.header.records")), household_records_path(nav_household), class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
        <%= link_to nav_label("📊", t("layouts.header.dashboard")), household_dashboard_path(nav_household), class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
        <%= link_to nav_label("⚙️", t("layouts.header.settings")), household_settings_path(nav_household), class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
      <% end %>
      <%= link_to nav_label("📖", t("layouts.header.guide")), guide_path, class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
      <%= link_to nav_label("👤", t("layouts.header.account")), account_path, class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
      <%= button_to nav_label("🚪", t("layouts.header.sign_out")), session_path, method: :delete, class: "inline-flex cursor-pointer items-center gap-1 rounded-md px-2 py-1 text-gray-700 underline" %>
      <%= render "layouts/language_switch" %>
    </nav>
  </div>
</header>
