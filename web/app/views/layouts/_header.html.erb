<%# Signed-in header: Apartment menu (households + new household), pending invitations, sign out (PRD §12a).
    From 1550px wide every link is in the bar, with Pending, Records and Expense Analysis in the Bills menu;
    narrower screens get the logo, theme toggle, inbox and a hamburger for the rest of the links, and
    the tab bar at the bottom for Bills and New Record %>
<% households = Current.user.households.order(:name).to_a %>
<% pending = Invitation.pending_for(Current.user).count %>
<% unread = Current.user.notifications.unread.count %>
<%# Pages outside a household (inbox, My account) still link to the last one used %>
<% nav_household = Current.household || households.find { |h| h.id == Current.user.last_household_id } || households.first %>
<%# Bills (Pending, Records, Expense Analysis): the page you're on, the unpaid bills due today or earlier
    for the red count, and New Record for owners and co-owners %>
<% bills_page = { "pending" => :pending, "records" => (:records if action_name == "index"), "dashboards" => :dashboard }[controller_name] %>
<%# The other links' page, tinted like the Bills page you're on: Settings covers the pages it opens %>
<% nav_page = case controller_path
   when "household_settings", "members", "memberships", "household_invitations", "invitation_links", "reminder_deliveries",
        "ownership_transfers", "household_deletions", "record_purges" then :settings
   when "accounts", %r{\Aaccount/} then :account
   when "notifications" then :inbox
   when "pages" then (:guide if action_name == "guide")
   end %>
<% due = nav_household ? nav_household.records.where(settled: false, due_on: ..Date.current).count : 0 %>
<% writer = nav_household && Current.user.memberships.find_by(household: nav_household)&.can_write? %>
<%# Export CSV: on Records, the records the filters show; anywhere else, every record %>
<% export_path = nav_household && household_records_path(nav_household, (bills_page == :records && @filter ? @filter.params : {}).merge(format: :csv)) %>
<% inbox = capture do %>
  <%= link_to notifications_path, class: "relative rounded-lg px-2 py-1 hover:scale-125 #{'bg-blue-50' if nav_page == :inbox}", "aria-label": t("layouts.header.inbox", count: unread) do %><%= image_tag "icons/reminder.png", alt: "", class: "h-6 w-6 object-contain" %><% if unread.positive? %><span class="absolute -right-1 -top-1 rounded-full bg-red-600 px-1.5 text-xs text-white"><%= unread %></span><% end %><% end %>
<% end %>
<header class="border-b">
  <div class="container mx-auto flex flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm">
    <%= link_to features_path, class: "flex items-center gap-2 font-semibold" do %>
      <%= image_tag "logo-sticker.png", alt: "", class: "h-7 w-auto" %>
      <span>Household Tracker</span>
    <% end %>
    <nav class="hidden flex-wrap items-center gap-3 min-[1550px]:flex">
      <span data-controller="install"><button type="button" hidden data-install-target="button" data-action="install#install" class="btn-press rounded-xl bg-blue-200 text-gray-900 cursor-pointer px-2 py-1"><span class="flex items-center gap-1"><%= nav_label("install.png", t("layouts.header.install")) %></span></button></span>
      <% if pending.positive? %>
        <%= link_to t("layouts.header.invitations", count: pending), invitations_path, class: "rounded-md bg-amber-100 px-2 py-1 text-amber-900" %>
      <% end %>
      <%= inbox %>
      <% if nav_household %>
        <%= render "layouts/household_menu", households:, current: nav_household %>
        <%= render "layouts/bills_menu", household: nav_household, current: bills_page, due:, writer:, export_path: %>
        <%= link_to nav_label("settings.png", t("layouts.header.settings")), household_settings_path(nav_household), class: "inline-flex items-center gap-1 rounded-lg px-2 py-1 hover:underline hover:font-bold #{'bg-blue-50 font-bold' if nav_page == :settings}" %>
      <% end %>
      <%= link_to nav_label("account.png", t("layouts.header.account")), account_path, class: "inline-flex items-center gap-1 rounded-lg px-2 py-1 hover:underline hover:font-bold #{'bg-blue-50 font-bold' if nav_page == :account}" %>
      <%= link_to nav_label("guide.png", t("layouts.header.guide")), guide_path, class: "inline-flex items-center gap-1 rounded-lg px-2 py-1 hover:underline hover:font-bold #{'bg-blue-50 font-bold' if nav_page == :guide}" %>
      <%= render "layouts/theme_switch" %>
      <%= render "layouts/language_switch" %>
      <% if writer %>
        <%= link_to nav_label("new_entry.png", t("layouts.header.new_record")), new_household_record_path(nav_household), class: "btn-press btn-new press-sm inline-flex items-center gap-1 rounded-xl px-3 py-1 font-bold" %>
      <% end %>
      <%= button_to nav_label("logout.png", t("layouts.header.sign_out")), session_path, method: :delete, class: "inline-flex items-center gap-1 btn-press rounded-xl bg-red-200 text-red-900 cursor-pointer px-2 py-1" %>
    </nav>

    <div class="flex items-center gap-2 min-[1550px]:hidden" data-controller="menu">
      <%= render "layouts/theme_switch" %>
      <%= inbox %>
      <button type="button" class="cursor-pointer rounded-md p-2 hover:scale-110" data-action="menu#open" aria-label="<%= t("layouts.header.menu") %>" aria-haspopup="dialog">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <%= render "layouts/menu", households:, current: nav_household, pending:, unread:, nav_page:, writer:, export_path: %>
    </div>
  </div>
</header>
<% if nav_household %>
  <%= render "layouts/tab_bar", household: nav_household, current: bills_page, due:, writer: %>
<% end %>
