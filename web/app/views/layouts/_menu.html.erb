<%# Full-screen menu for screens under 1550px: the header's links with the same icons, one per row.
    Signed out it has only Install App, Getting Started and Languages %>
<% signed_in = authenticated? %>
<% row = "flex w-full items-center justify-center gap-3 py-4 text-lg font-medium hover:bg-gray-100" %>
<% sub = "flex w-full items-center justify-center gap-2 py-2 hover:bg-gray-100" %>
<% icon = ->(name) { image_tag("icons/#{name}", alt: "", class: "h-7 w-7 object-contain") } %>
<dialog data-menu-target="dialog" aria-label="<%= t("layouts.header.menu") %>"
        class="m-0 h-dvh max-h-none w-screen max-w-none overflow-y-auto bg-white/95 p-0 text-gray-900 backdrop:bg-transparent backdrop-blur-sm">
  <div class="sticky top-0 flex justify-end px-4 py-3">
    <button type="button" class="cursor-pointer rounded-md p-2 hover:scale-125" data-action="menu#close" aria-label="<%= t("layouts.header.close_menu") %>">
      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <ul class="mx-auto max-w-xl divide-y divide-gray-300 px-4 pb-10 text-center">
    <li data-controller="install"><button type="button" hidden data-install-target="button" data-action="install#install" class="<%= row %> cursor-pointer"><%= icon.("install.png") %><span><%= t("layouts.header.install") %></span></button></li>
    <% if signed_in && pending.positive? %>
      <li><%= link_to t("layouts.header.invitations", count: pending), invitations_path, class: "#{row} text-amber-900" %></li>
    <% end %>
    <% if signed_in %><li><%= link_to notifications_path, class: row do %><%= icon.("reminder.png") %><span><%= t("layouts.header.inbox_label") %></span><% if unread.positive? %><span class="rounded-full bg-red-600 px-2 text-sm text-white"><%= unread %></span><% end %><% end %></li><% end %>
    <% if current %>
      <li class="py-2">
        <p class="<%= row %> hover:bg-transparent"><%= icon.("apartment.png") %><span><%= t("layouts.header.apartment") %></span></p>
        <% households.each do |household| %>
          <%= link_to household_path(household), class: "#{sub} #{'font-semibold' if household == current}", "aria-current": (household == current ? "true" : nil) do %>
            <span><%= household.name %></span><% if household == current %><span aria-hidden="true" class="text-blue-600">✓</span><% end %>
          <% end %>
        <% end %>
        <%= link_to t("layouts.header.new_household"), onboarding_path, class: "#{sub} text-blue-700" %>
      </li>
      <li><%= link_to household_pending_path(current), class: row do %><%= icon.("upcoming.png") %><span><%= t("layouts.header.pending") %></span><% end %></li>
      <li><%= link_to household_records_path(current), class: row do %><%= icon.("records.png") %><span><%= t("layouts.header.records") %></span><% end %></li>
      <li><%= link_to household_dashboard_path(current), class: row do %><%= icon.("dashboard.png") %><span><%= t("layouts.header.dashboard") %></span><% end %></li>
      <li><%= link_to household_settings_path(current), class: row do %><%= icon.("settings.png") %><span><%= t("layouts.header.settings") %></span><% end %></li>
    <% end %>
    <li><%= link_to guide_path, class: row do %><%= icon.("guide.png") %><span><%= t("layouts.header.guide") %></span><% end %></li>
    <% if signed_in %><li><%= link_to account_path, class: row do %><%= icon.("account.png") %><span><%= t("layouts.header.account") %></span><% end %></li><% end %>
    <li class="py-2">
      <p class="<%= row %> hover:bg-transparent"><%= icon.("language.png") %><span><%= t("layouts.header.languages") %></span></p>
      <% [ [ "en", "🇺🇸", "English" ], [ "zh-TW", "🇹🇼", "繁體中文" ] ].each do |code, flag, name| %>
        <%= button_to locale_path, method: :patch, params: { locale: code }, lang: code, class: "#{sub} cursor-pointer #{'font-semibold' if I18n.locale.to_s == code}",
              "aria-current": (I18n.locale.to_s == code ? "true" : nil) do %>
          <span aria-hidden="true"><%= flag %></span><span><%= name %></span><% if I18n.locale.to_s == code %><span aria-hidden="true" class="text-blue-600">✓</span><% end %>
        <% end %>
      <% end %>
    </li>
    <% if signed_in %><li><%= button_to session_path, method: :delete, class: "#{row} cursor-pointer" do %><%= icon.("logout.png") %><span><%= t("layouts.header.sign_out") %></span><% end %></li><% end %>
  </ul>
</dialog>
