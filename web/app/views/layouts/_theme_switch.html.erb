<%# Theme toggle: shows the theme you'd switch to (Dark on a light page, Light on a dark one). Both
    buttons are rendered and CSS shows the right one, so it also works while the cookie still says
    "system". It reloads the whole page (no Turbo), because Turbo swaps only <body> and data-theme
    lives on <html> %>
<% [ [ "dark", "dark_mode.png", "dark:hidden" ], [ "light", "light_mode.png", "hidden dark:block" ] ].each do |theme, icon, visibility| %>
  <%= button_to theme_path, method: :patch, params: { theme: }, form: { class: visibility, data: { turbo: false } },
        class: "inline-flex items-center gap-1 px-2 py-1 hover:underline hover:font-bold",
        title: t("layouts.header.theme") do %>
    <%= nav_label(icon, t("layouts.header.themes.#{theme}")) %>
  <% end %>
<% end %>
