<!DOCTYPE html>
<html data-theme="<%= current_theme %>">
  <head>
    <title><%= content_for(:title) || "Household Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Household Tracker">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# A new deploy changes the build, and Turbo then reloads the whole page on the next click %>
    <meta name="app-build" content="<%= AppVersion.build %>" data-turbo-track="reload">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.png?v=2" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="app-update" data-app-update-url-value="<%= app_version_path %>" data-app-update-version-value="<%= AppVersion.current %>"
        data-app-update-build-value="<%= AppVersion.build %>" data-app-update-strings-value="<%= t("app_update").slice(:updated, :ready, :checking, :latest, :updating, :failed).to_json %>">
    <% if authenticated? %>
      <%= render "layouts/header" %>
      <%= render "layouts/back_link" %>
    <% else %>
      <%# Signed out: the same links; under 1550px the theme toggle stays and the rest is in the hamburger menu %>
      <div class="container mx-auto flex items-center justify-end gap-3 px-4 pt-3 text-sm">
        <nav class="hidden flex-wrap items-center justify-end gap-3 min-[1550px]:flex">
          <span data-controller="install"><button type="button" hidden data-install-target="button" data-action="install#install" class="btn-press rounded-xl bg-blue-200 text-gray-900 cursor-pointer px-2 py-1"><span class="flex items-center gap-1"><%= nav_label("install.png", t("layouts.header.install")) %></span></button></span>
          <%= link_to nav_label("guide.png", t("layouts.header.guide")), guide_path, class: "inline-flex items-center gap-1 px-2 py-1 underline" %>
          <%= render "layouts/theme_switch" %>
          <%= render "layouts/language_switch" %>
        </nav>
        <div class="flex items-center gap-2 min-[1550px]:hidden" data-controller="menu">
          <%= render "layouts/theme_switch" %>
          <button type="button" class="cursor-pointer rounded-md p-2 hover:bg-gray-50" data-action="menu#open" aria-label="<%= t("layouts.header.menu") %>" aria-haspopup="dialog">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <%= render "layouts/menu", households: [], current: nil, pending: 0, unread: 0 %>
        </div>
      </div>
    <% end %>
    <%# Signed in, under 1550px: room at the bottom for the tab bar (layouts/_tab_bar) %>
    <main class="container mx-auto mt-10 px-4 flex <%= 'pb-28 min-[1550px]:pb-0' if authenticated? %>">
      <%= yield %>
    </main>
    <div hidden data-app-update-target="toast" role="status" class="fixed inset-x-4 <%= authenticated? ? 'bottom-28 min-[1550px]:bottom-4' : 'bottom-4' %> z-50 mx-auto max-w-md rounded-xl border-2 border-gray-800 bg-white p-4 shadow-[4px_4px_0_var(--color-gray-800)]">
      <p class="font-semibold" data-app-update-target="title"></p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm" data-app-update-target="notes"></ul>
      <div class="mt-3 flex justify-end gap-2">
        <button type="button" hidden data-app-update-target="reload" data-action="app-update#reload" class="btn-press rounded-xl bg-blue-200 text-gray-900 cursor-pointer px-3 py-1.5 font-medium"><%= t("app_update.update_now") %></button>
        <button type="button" data-action="app-update#dismiss" class="btn-press rounded-xl bg-white text-gray-900 cursor-pointer px-3 py-1.5 font-medium"><%= t("app_update.close") %></button>
      </div>
    </div>
  </body>
</html>
