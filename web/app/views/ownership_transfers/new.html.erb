<% content_for :title, t(".title") %>
<div class="mx-auto w-full max-w-md space-y-6 py-8">
  <%= render "shared/flash" %>
  <h1 class="text-3xl font-bold"><%= t(".title") %></h1>
  <p class="text-gray-700"><%= t(".explain") %></p>
  <% if @candidates.empty? %>
    <p class="text-gray-500"><%= t(".no_members") %></p>
  <% else %>
    <%= form_with url: household_ownership_transfer_path(Current.household), class: "space-y-4" do |form| %>
      <%= form.select :membership_id, @candidates.map { |m| [ "#{m.user.display_name.presence || m.user.email_address} (#{t("roles.#{m.role}")})", m.id ] }, {}, class: "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
      <%= form.submit t(".submit"), class: "btn-press rounded-xl bg-blue-200 text-gray-900 cursor-pointer px-3.5 py-2 font-medium", data: { turbo_confirm: t(".confirm") } %>
    <% end %>
  <% end %>
</div>
