<% content_for :title, "Features · Household Tracker" %>
<% feature = ->(icon, title, items) { render "pages/feature", icon:, title:, items: } %>
<article class="mx-auto w-full max-w-2xl space-y-8 pb-8 leading-relaxed">
  <div class="sticky top-0 z-10 -mx-4 border-b px-4 py-2 text-sm backdrop-blur">
    <%= link_to "← Household Tracker", root_path, class: "font-medium text-blue-700 hover:underline" %>
  </div>
  <header class="space-y-2">
    <h1 class="flex items-center gap-3 text-3xl font-bold"><%= image_tag "logo-sticker.png", alt: "", class: "h-10 w-auto" %><span>Features</span></h1>
    <p class="text-gray-700">Household Tracker replaces the family's Google Sheet for bills, maintenance and taxes, and reminds everyone before things are due. It works on computers and Android phones, and installs as an app.</p>
  </header>

  <%= feature.("records.png", "Records", [
        "Expense, Maintenance and Tax: category, period (e.g. Jan. - Feb., Full Year), required and paid amounts, due date, paid date, payment method, notes and photos.",
        "Status is worked out for you (unpaid, partial, paid ✅, overdue), using each person's own date.",
        "One-tap Mark paid; filter by year, month, type, category, status, payment method and search, with Paid totals.",
        "Every record keeps a history of changes, and the list exports to CSV." ]) %>
  <%= feature.("recurring.png", "Recurring bills", [
        "Set a bill up once (water every 2 months, management fee yearly) and the next one is created ahead of time.",
        "Fixed amounts are filled in; variable bills show the last amount as a hint." ]) %>
  <%= feature.("reminder.png", "Reminders", [
        "At most one combined reminder a day per person, at their chosen time (09:00 by default): due soon, due today and overdue.",
        "By push notification (phone and computer), email and the in-app inbox.",
        "If a reminder doesn't arrive, the owner gets a daily summary and can resend it." ]) %>
  <%= feature.("apartment.png", "Household and members", [
        "Owner, co-owner (edits records) and viewer (read-only). Invite family by email.",
        "Sign in with email and password or Google; one account can belong to several households.",
        "The activity log shows who did what." ]) %>
  <%= feature.("records.png", "Photos", [
        "Attach receipt photos to a bill; they're downsized and location data is removed.",
        "Only household members can see them." ]) %>
  <%= feature.("dashboard.png", "Expense Analysis", [
        "Spending by type per month (or per year), the water, electricity and gas trend, spending by category and payment method, and a spread of bill amounts.",
        "Click a chart to see the records behind it; choose one year or all years." ]) %>
  <%= feature.("import.png", "Sheet import", [
        "Upload the sheet's CSV, review the preview (new, changed, unchanged), then commit.",
        "Re-importing the same sheet never duplicates records; keywords in payment notes can set payment methods in one go." ]) %>

  <p class="rounded-lg bg-blue-50 px-4 py-3 text-blue-900">New here? See <%= link_to "Getting Started", guide_path, class: "font-medium underline" %> to install the app and turn on notifications.</p>
</article>
