<% content_for :title, "功能介紹 · Household Tracker" %>
<% feature = ->(icon, title, items) { render "pages/feature", icon:, title:, items: } %>
<article class="mx-auto w-full max-w-2xl space-y-8 pb-8 leading-relaxed">
  <div class="sticky top-0 z-10 -mx-4 border-b bg-white/95 px-4 py-2 text-sm backdrop-blur">
    <%= link_to "← Household Tracker", root_path, class: "font-medium text-blue-700 hover:underline" %>
  </div>
  <header class="space-y-2">
    <h1 class="flex items-center gap-3 text-3xl font-bold"><%= image_tag "logo-sticker.png", alt: "", class: "h-10 w-auto" %><span>功能介紹</span></h1>
    <p class="text-gray-700">Household Tracker 取代家裡的 Google 試算表，記錄水電、保養和稅金，並在到期前提醒每位家人。電腦和 Android 手機都能用，可以安裝成 App。</p>
  </header>

  <%= feature.("records.png", "帳單記錄", [
        "支出、保養、稅金三種類型：類別、期間（例如 1月-2月、全年）、應繳／已繳金額、到期日、繳費日、付款方式、備註和照片。",
        "狀態自動判斷（未繳、部分繳、已繳 ✅、逾期），用每個人自己的日期計算。",
        "一鍵「標記已繳」；可依年度、月份、類型、類別、狀態、付款方式和關鍵字篩選，摘要列出已繳金額。",
        "每筆記錄都有修改歷史，也可以匯出 CSV。" ]) %>
  <%= feature.("recurring.png", "定期帳單", [
        "設定一次（例如水電瓦斯每兩個月、管理費每年），之後會自動提前建立下一期的帳單。",
        "固定金額會自動填入；金額不固定的帳單會顯示上次金額當參考。" ]) %>
  <%= feature.("reminder.png", "提醒", [
        "每人每天最多一則彙整提醒，在自己設定的時間（預設 09:00）送出：快到期、今天到期、已逾期。",
        "推播通知（手機和電腦）、Email 和 App 內的收件匣，三個管道都會收到。",
        "提醒沒送達時，擁有者會收到每日摘要，可以重新寄送。" ]) %>
  <%= feature.("apartment.png", "家庭與成員", [
        "擁有者、共同擁有者（可編輯記錄）、檢視者（只能看）。用 Email 邀請家人加入。",
        "可以用 Email 密碼或 Google 登入；一個帳號可以加入多個家庭。",
        "活動記錄會列出誰做了什麼。" ]) %>
  <%= feature.("records.png", "照片", [
        "帳單可以附上收據照片；上傳前會縮小，位置等隱藏資訊會被移除。",
        "只有家庭成員看得到。" ]) %>
  <%= feature.("dashboard.png", "支出分析", [
        "每月（或每年）各類型支出、水電瓦斯趨勢、依類別和付款方式的分布，以及帳單金額分布圖。",
        "點圖表就能看到背後的每一筆記錄；可選單一年度或全部年度。" ]) %>
  <%= feature.("import.png", "從試算表匯入", [
        "上傳試算表的 CSV，先看預覽（新增／更新／未變更），確認後才寫入。",
        "重複匯入同一份試算表不會產生重複記錄；付款備註裡的關鍵字可以一次設定成付款方式。" ]) %>

  <p class="rounded-lg bg-blue-50 px-4 py-3 text-blue-900">第一次使用？請看 <%= link_to "使用說明", guide_path, class: "font-medium underline" %>：安裝 App、開啟通知。</p>
</article>
