<% content_for :title, t(".page_title") %>
<article class="mx-auto w-full max-w-2xl space-y-8 pb-8 leading-relaxed">
  <div class="sticky top-(--header-h) z-10 -mx-4 border-b px-4 py-2 text-sm backdrop-blur">
    <%= link_to "← Household Tracker", root_path, class: "font-medium text-blue-700 hover:underline" %>
  </div>
  <header class="space-y-1">
    <%= page_title("guide.png", t(".title")) %>
    <p class="text-sm text-gray-600"><%= t(".intro") %></p>
  </header>

  <%# Steps 1-3 are numbered lists, 5-6 bullet lists; step 4 is one paragraph %>
  <% { accept: {}, install: { host: request.host },
       notifications: { link: link_to(t(".notifications.link"), account_path(anchor: "notifications"), class: "text-blue-700 underline") } }.each do |step, values| %>
    <section class="space-y-2">
      <h2 class="text-lg font-semibold"><%= t(".#{step}.title") %></h2>
      <ol class="list-decimal space-y-1 pl-6"><% t(".#{step}.items_html", **values).each do |item| %><li><%= item %></li><% end %></ol>
      <% if step == :notifications %><p class="text-sm text-gray-600"><%= t(".notifications.note") %></p><% end %>
    </section>
  <% end %>

  <section class="space-y-2">
    <h2 class="text-lg font-semibold"><%= t(".on_time.title") %></h2>
    <p><%= t(".on_time.body_html") %></p>
  </section>

  <% %i[daily trouble].each do |step| %>
    <section class="space-y-2">
      <h2 class="text-lg font-semibold"><%= t(".#{step}.title") %></h2>
      <ul class="list-disc space-y-1 pl-6"><% t(".#{step}.items_html").each do |item| %><li><%= item %></li><% end %></ul>
    </section>
  <% end %>

  <p class="text-sm"><%= link_to t(".privacy"), privacy_path, class: "text-blue-700 underline" %></p>
</article>
