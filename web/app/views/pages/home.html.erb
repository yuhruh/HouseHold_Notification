<%# Signed-in visitors are redirected by PagesController#home %>
<div class="mx-auto w-full max-w-md space-y-6 py-12 text-center">
  <%= render "shared/flash" %>
  <%= image_tag "planning.png", alt: "", class: "mx-auto h-24 w-24 rounded-lg object-cover" %>
  <h1 class="text-3xl font-bold">Household Tracker</h1>
  <p class="text-gray-700">家庭帳單、維修與稅務提醒。僅限受邀的家庭成員使用。</p>
  <p class="text-gray-700">Household bills, maintenance and tax reminders. For invited family members only.</p>
  <div class="flex justify-center gap-3">
    <%= link_to t(".sign_in"), new_session_path, class: "rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white" %>
    <%= link_to t(".sign_up"), new_registration_path, class: "rounded-md border border-gray-400 px-3.5 py-2.5 font-medium" %>
  </div>
  <p><%= link_to "隱私權政策 / Privacy policy", privacy_path, class: "text-blue-700 underline" %></p>
  <%# M0 spike pages (basic auth) are otherwise unreachable from the installed PWA; removed after M5. %>
  <p class="text-sm"><%= link_to "M0 checks", spike_checks_path, class: "text-gray-500 underline" %></p>
</div>
