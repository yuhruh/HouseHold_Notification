<% field = "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
<%= form_with model: [ Current.household, payment_method ], class: "space-y-4" do |form| %>
  <% if payment_method.errors.any? %>
    <ul class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><% payment_method.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  <% end %>
  <%= form.label :name, class: "block text-sm font-medium" %>
  <%= form.text_field :name, required: true, maxlength: 40, class: field %>
  <%= form.label :kind, class: "block text-sm font-medium" %>
  <%= form.select :kind, PaymentMethod.kinds.keys.map { |k| [ t("payment_methods.kinds.#{k}"), k ] }, {}, class: field %>
  <%= form.label :last4, class: "block text-sm font-medium" %>
  <%= form.text_field :last4, maxlength: 4, inputmode: "numeric", pattern: "\\d{4}", class: field %>
  <div class="flex gap-3">
    <%= form.submit t("records.form.save"), class: "cursor-pointer rounded-md bg-blue-600 px-3.5 py-2 font-medium text-white hover:bg-blue-500" %>
    <%= link_to t("records.form.cancel"), household_payment_methods_path(Current.household), class: "px-3.5 py-2 underline" %>
  </div>
<% end %>
