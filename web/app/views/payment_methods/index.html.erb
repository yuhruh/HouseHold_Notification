<% content_for :title, t(".title") %>
<% writer = policy(PaymentMethod).write? %>
<div class="w-full mx-auto max-w-2xl space-y-6 py-4">
  <%= render "shared/flash" %>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <%= page_title("payment.png", t(".title")) %>
    <% if writer %><%= link_to t(".new"), new_household_payment_method_path(Current.household), class: "btn-press rounded-xl bg-blue-200 text-gray-900 px-3.5 py-2 font-medium" %><% end %>
  </div>
  <% if writer %>
    <p class="text-sm"><%= link_to t(".from_notes"), from_notes_household_payment_methods_path(Current.household), class: "text-blue-700 underline" %>
      <span class="text-gray-500"><%= t(".from_notes_hint") %></span></p>
  <% end %>
  <% if @payment_methods.empty? %>
    <p class="text-gray-600"><%= t(".empty") %></p>
  <% else %>
    <ul class="divide-y rounded-lg border">
      <% @payment_methods.each do |pm| %>
        <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-2 <%= 'text-gray-400' if pm.archived_at %>">
          <span><%= pm.name %><%= " ··#{pm.last4}" if pm.last4.present? %> <span class="text-sm text-gray-500"><%= t("payment_methods.kinds.#{pm.kind}") %><%= " · #{t('.archived')}" if pm.archived_at %></span></span>
          <% if writer %>
            <span class="flex gap-3 text-sm">
              <%= link_to edit_household_payment_method_path(Current.household, pm), class: "inline-flex items-center gap-1 underline" do %><%= image_tag "icons/edit.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".edit") %></span><% end %>
              <%= button_to archive_household_payment_method_path(Current.household, pm), class: "inline-flex items-center gap-1 cursor-pointer underline" do %><% if pm.archived_at %><%= t(".unarchive") %><% else %><%= image_tag "icons/archive.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".archive") %></span><% end %><% end %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
