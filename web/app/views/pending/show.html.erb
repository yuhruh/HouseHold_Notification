<% content_for :title, t("records.bills_switch.to_pay_title") %>
<% sections = @to_pay.sections %>
<%# On a computer the groups sit side by side: overdue | due soon and maintenance | no due date (from
    1280px; narrower, the third column wraps under the first so cards stay one line wide), with tighter
    spacing and smaller buttons (a mouse doesn't need the 44px phone buttons). What isn't due yet is on
    Coming Up; "Next up" says what joins this page next %>
<% columns = [ %i[overdue], %i[soon maintenance], %i[no_due] ].map { |keys| sections.select { |key, list| keys.include?(key) && list.any? } }.reject(&:empty?) %>
<% next_up = @to_pay.next_up %>
<div class="w-full mx-auto space-y-6 py-4 lg:space-y-3 <%= columns.size > 1 ? 'max-w-3xl lg:max-w-none' : 'max-w-3xl' %>">
  <%= render "shared/flash" %>
  <%# The title, tabs and intro stay pinned under the header while the bills scroll under them
      (opaque, a little wider to hide the cards' shadow) %>
  <div class="sticky top-(--header-h) z-20 -mx-2 space-y-2 bg-mauve-100 px-2 py-3 lg:py-2">
    <%= render "records/bills_switch", current: :to_pay, to_pay: @to_pay %>
    <p class="text-sm text-gray-700"><%= t(".intro") %></p>
  </div>
  <% if next_up %>
    <% title = next_up.is_a?(Records::ToPay::Scheduled) ? next_up.template.title : next_up.title %>
    <%= link_to household_coming_up_path(Current.household), class: "flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-xl border-2 border-sky-300 bg-sky-50 px-4 py-2.5 text-sm font-semibold text-sky-900 hover:bg-sky-100 dark:bg-sky-50/60" do %>
      <span><%= t(".next_up", title:, date: l(@to_pay.to_pay_on(next_up))) %></span>
      <span class="whitespace-nowrap"><%= t(".see_coming_up") %> ›</span>
    <% end %>
  <% end %>
  <% if sections.all? { |_, list| list.empty? } %>
    <p class="text-gray-600"><%= t(".empty") %></p>
  <% end %>
  <div class="grid items-start gap-6 lg:gap-4 <%= { 2 => "lg:grid-cols-2", 3 => "lg:grid-cols-2 xl:grid-cols-3" }[columns.size] %>">
    <% columns.each do |column| %>
      <div class="space-y-6 lg:space-y-4">
        <% column.each do |key, list| %>
        <section class="space-y-3 lg:space-y-2">
          <div>
            <h2 class="text-lg font-semibold <%= 'text-red-700' if key.in?(%i[overdue soon]) %>"><%= t(".#{key}") %> (<%= list.size %>)</h2>
            <p class="text-sm text-gray-600"><%= t(".hints.#{key}") %></p>
          </div>
          <ul class="flex flex-col space-y-3 lg:space-y-2">
            <% list.each do |record| %><%= render "record_card", record:, key: %><% end %>
          </ul>
        </section>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
