<% content_for :title, t(".title") %>
<div class="mx-auto w-full max-w-md space-y-6 py-8">
  <%= render "shared/flash" %>
  <h1 class="text-center text-3xl font-bold"><%= t(".title") %></h1>
  <p class="text-gray-700"><%= t(".explain", count: @count, name: Current.household.name) %></p>
  <ul class="list-disc space-y-1 pl-6 text-sm text-gray-700">
    <li><%= t(".removes") %></li>
    <li><%= t(".keeps") %></li>
    <li><%= t(".reimport") %></li>
  </ul>
  <%= form_with url: household_record_purge_path(Current.household), class: "space-y-4" do |form| %>
    <% if @templates.positive? %>
      <label class="flex items-start gap-2 text-sm">
        <%= check_box_tag :delete_templates, "1", true, class: "mt-1" %>
        <span><%= t(".delete_templates", count: @templates) %>
          <span class="block text-gray-500"><%= t(".keep_templates_hint") %></span></span>
      </label>
    <% end %>
    <%= form.label :confirm_name, t("account.deletions.show.type_name", name: Current.household.name), class: "block text-sm font-medium" %>
    <%= form.text_field :confirm_name, required: true, autocomplete: "off", class: "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
    <%= form.button type: "submit", name: nil, class: "btn-press inline-flex items-center gap-1.5 rounded-xl bg-red-200 text-red-900 cursor-pointer px-3.5 py-2 font-medium", data: { turbo_confirm: t(".final_confirm", count: @count) } do %><%= image_tag "icons/delete.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t(".submit") %></span><% end %>
  <% end %>
</div>
