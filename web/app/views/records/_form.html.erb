<%# The record form. `mode`: :new (New Record: billing and payment details), :details (Edit Details: only
    the bill), :pay (Record Payment / Mark Done: only the payment, filled in) or :edit_payment (Edit Payment /
    Edit Done Details). The payment forms show the bill as a summary on top %>
<% mode = local_assigns[:mode] || :new %>
<% section = "card-raised space-y-4 rounded-xl bg-white p-4" %>
<% heading = "text-lg font-semibold" %>
<% task = record.maintenance? %>
<%= form_with model: [ Current.household, record ], url: (record.persisted? ? household_record_path(Current.household, record) : household_records_path(Current.household)), class: "space-y-4",
      data: (record.new_record? ? { controller: "default-payment", default_payment_map_value: last_payment_methods.to_json } : {}) do |form| %>
  <% if record.errors.any? %>
    <ul class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><% record.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  <% end %>
  <%= form.hidden_field :lock_version %>
  <% if record.new_record? %><%= form.hidden_field :bill_number %><% end %><%# from a bill scan: warns when the same bill is scanned again %>
  <% if mode == :pay %><%= hidden_field_tag :pay, 1 %><% elsif mode == :edit_payment %><%= hidden_field_tag :payment, 1 %><% end %>
  <% if @continues %><%= hidden_field_tag :continues_id, @continues.id %>
    <p class="rounded-lg bg-blue-50 px-3 py-2 text-sm text-blue-900"><%= t("records.form.continues", title: @continues.title, details: @continues.details.presence || "–") %></p>
  <% end %>

  <% if mode == :details %>
    <% only = task ? (record.settled ? "task_only_done" : "task_only_undone") : (record.paid_on || record.amount_paid.to_d.positive? ? "details_only_paid" : "details_only_unpaid") %>
    <p class="rounded-lg bg-blue-50 px-3 py-2 text-sm text-blue-900"><%= t("records.form.#{only}") %></p>
  <% elsif mode != :new %>
    <%# The bill this payment is for: read only here; Edit Details changes it %>
    <div class="space-y-0.5 rounded-xl border border-gray-300 bg-gray-50 px-4 py-3">
      <p class="font-bold"><%= record.title %> · <%= record.period %></p>
      <% summary = [ (t(task ? "records.form.expected_amount" : "records.form.due_amount", amount: money(record.amount_required, record.currency)) if record.amount_required),
                     (t("records.index.due_on", date: l(record.due_on)) if record.due_on) ].compact %>
      <p class="text-sm text-gray-700"><%= summary.any? ? summary.join(" · ") : (t("records.form.no_amount_yet") unless task) %></p>
      <%= link_to t(task ? "records.form.wrong_task" : "records.form.wrong_amount"), edit_household_record_path(Current.household, record), class: "text-sm font-semibold text-blue-800 underline" %>
    </div>
  <% end %>

  <% doing = mode != :new && task %>
  <div class="space-y-4" <% unless mode == :details || doing %>data-controller="paid-amount" data-paid-amount-whole-value="<%= Household::WHOLE_CURRENCIES.to_json %>"<% end %>>
    <% if mode.in?(%i[new details]) %>
      <section class="<%= section %>" aria-labelledby="billing_heading" data-controller="due-reminder">
        <h2 id="billing_heading" class="flex items-center gap-2 <%= heading %>"><%= nav_label("details.png", t(task && mode == :details ? "records.form.task" : "records.form.billing")) %></h2>
        <%= render "records/details_fields", form:, record: %>
      </section>
    <% end %>
    <% unless mode == :details %>
      <%= render "records/payment_fields", form:, record:, mode: %>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.button type: "submit", name: nil, class: "btn-press inline-flex items-center gap-1.5 rounded-xl bg-blue-200 text-gray-900 cursor-pointer px-3.5 py-2 font-medium disabled:cursor-not-allowed disabled:opacity-50" do %><%= image_tag "icons/save.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= mode == :pay && !doing ? t("records.form.save_payment") : t("records.form.save") %></span><% end %>
    <% if record.new_record? && policy(RecurringTemplate).new? %>
      <%# Saves, then opens New recurring bill filled in from this record %>
      <%= form.button type: "submit", name: "make_recurring", value: "1", class: "btn-press inline-flex items-center gap-1.5 rounded-xl bg-white cursor-pointer px-3.5 py-2 font-medium text-blue-700 disabled:cursor-not-allowed disabled:opacity-50" do %><%= image_tag "icons/recurring.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("records.form.save_recurring") %></span><% end %>
    <% end %>
    <%= cancel_link(record.persisted? ? household_record_path(Current.household, record) : household_records_path(Current.household)) %>
  </div>
<% end %>
