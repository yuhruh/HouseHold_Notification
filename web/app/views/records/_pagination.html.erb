<%# Records list paging: "1–20 of 130", rows per page (remembered on this device) and page links %>
<% custom = !Records::Filter::PER_PAGE.include?(filter.per) %>
<% link = "rounded-md border border-gray-400 px-2.5 py-1 hover:bg-gray-50" %>
<div class="flex flex-wrap items-center justify-between gap-3 text-sm">
  <p class="text-gray-600"><%= t("records.pagination.showing", from: (filter.page - 1) * filter.per + 1, to: [ filter.page * filter.per, filter.total ].min, total: filter.total) %></p>

  <%= form_with url: household_records_path(Current.household), method: :get, class: "flex flex-wrap items-center gap-2", data: { controller: "per-page" } do %>
    <% filter.params.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
    <%= label_tag :per, t("records.pagination.per_page") %>
    <%= select_tag :per, options_for_select(Records::Filter::PER_PAGE.map { |n| [ n, n ] } + [ [ t("records.pagination.custom"), "custom" ] ], custom ? "custom" : filter.per),
          class: "h-9 rounded-md border border-gray-400 px-2", data: { per_page_target: "select", action: "per-page#change" } %>
    <span class="flex items-center gap-2" data-per-page-target="custom" <%= "hidden" unless custom %>>
      <%= number_field_tag :per_custom, (filter.per if custom), min: 1, max: Records::Filter::MAX_PER_PAGE,
            class: "h-9 w-20 rounded-md border border-gray-400 px-2", "aria-label": t("records.pagination.custom_label") %>
      <%= submit_tag t("records.pagination.go"), name: nil, class: "cursor-pointer rounded-md bg-gray-800 px-3 py-1.5 font-medium text-white" %>
    </span>
  <% end %>

  <% if filter.pages > 1 %>
    <nav class="flex flex-wrap items-center gap-1" aria-label="<%= t("records.pagination.label") %>">
      <% if filter.page > 1 %><%= link_to t("records.pagination.previous"), household_records_path(Current.household, filter.params.merge(page: filter.page - 1)), class: link, rel: "prev" %><% end %>
      <% page_window(filter.page, filter.pages).each do |n| %>
        <% if n.nil? %>
          <span class="px-1 text-gray-500">…</span>
        <% elsif n == filter.page %>
          <span class="rounded-md bg-gray-800 px-2.5 py-1 font-medium text-white" aria-current="page"><%= n %></span>
        <% else %>
          <%= link_to n, household_records_path(Current.household, filter.params.merge(page: n)), class: link %>
        <% end %>
      <% end %>
      <% if filter.page < filter.pages %><%= link_to t("records.pagination.next"), household_records_path(Current.household, filter.params.merge(page: filter.page + 1)), class: link, rel: "next" %><% end %>
    </nav>
  <% end %>
</div>
