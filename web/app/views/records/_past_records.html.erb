<%# Past Records: a cyan press button that opens the latest earlier records of the same item as raised
    cards; closes on a click outside it or Escape, like the header menus %>
<details id="past_records" class="group" data-controller="dropdown">
  <summary class="btn-press inline-flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-xl bg-cyan-100 px-3.5 py-2 font-medium text-cyan-900 dark:bg-cyan-100/70 [&::-webkit-details-marker]:hidden">
    <%= image_tag("icons/details.png", alt: "", class: "h-5 w-5 object-contain") %><span><%= t("records.show.past_records", count:) %></span>
    <svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
  </summary>
  <div class="mt-3 space-y-3 rounded-xl border border-gray-300 bg-white p-3 shadow-lg">
    <p class="text-sm text-gray-600"><%= t("records.show.past_hint") %></p>
    <ul class="flex flex-col space-y-3">
      <% past.each do |old| %>
        <li id="past_<%= dom_id(old) %>">
          <%= render "records/mini_card", record: old %>
        </li>
      <% end %>
    </ul>
    <%= link_to t("records.show.past_see_all"), household_records_path(Current.household, category_id: record.category_id, q: record.details.presence, from: record.id), class: "inline-block text-sm text-blue-700 underline" %>
  </div>
</details>
