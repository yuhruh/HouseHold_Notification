<%# Payment details: what was paid, when and how. `mode`: :new (New Record, under the billing details),
    :pay (Record Payment / Mark Done: filled in for you) or :edit_payment (Edit Payment / Edit Done Details).
    Record Payment draws its outline and shadow in emerald (dark mode: the softer emerald-400, as card-raised
    softens its mauve) %>
<% field = "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
<% section = "card-raised space-y-4 rounded-xl bg-white p-4" %>
<% heading = "text-lg font-semibold" %>
<% doing = mode != :new && record.maintenance? %><%# Mark Done: maintenance is done (with what it cost), not paid %>
<section class="<%= section %> <%= "[--card-line:var(--color-emerald-700)] dark:[--card-line:var(--color-emerald-400)]" if mode == :pay %>" aria-labelledby="payment_heading">
  <% if doing %>
    <h2 id="payment_heading" class="flex items-center gap-2 <%= heading %>"><%= nav_label("details.png", t("records.form.done")) %></h2>
    <% if mode == :pay %>
      <p class="rounded-lg bg-green-50 px-3 py-2 text-sm text-green-900"><%= record.amount_required ? t("records.form.prefilled_done_cost", amount: money(record.amount_required, record.currency)) : t("records.form.prefilled_done") %></p>
    <% end %>
    <div class="grid grid-cols-2 gap-2">
      <div>
        <%= form.label :paid_on, t("records.form.done_on"), class: "block text-sm font-medium" %>
        <%= form.date_field :paid_on, class: field %>
      </div>
      <div>
        <%= form.label :amount_paid, "#{t("records.form.cost")} (#{record.currency})", class: "block text-sm font-medium" %>
        <%= form.number_field :amount_paid, value: amount_value(record.amount_paid, record.currency), min: 0, step: amount_step(record.currency), class: field %>
      </div>
      <p class="col-span-2 text-sm text-gray-500"><%= t("records.form.cost_hint") %></p>
    </div>
    <%= tag.div class: "space-y-3", data: new_payment_method_data do %>
      <div class="grid grid-cols-2 gap-2">
        <div>
          <%= form.label :payment_method_id, class: "block text-sm font-medium" %>
          <%= form.select :payment_method_id, payment_method_options(record, add: true), { include_blank: t("records.form.none"), selected: payment_method_choice(record) }, class: field,
                data: { new_payment_method_target: "menu", action: "new-payment-method#toggle" } %>
        </div>
        <% unless record.recurring_template_id %>
          <div>
            <%= form.label :next_due_on, class: "block text-sm font-medium" %>
            <%= form.date_field :next_due_on, class: field %>
          </div>
          <p class="col-span-2 text-sm text-gray-500"><%= t("records.form.next_due_hint") %></p>
        <% end %>
      </div>
      <%= render "payment_methods/inline_fields", method: @new_payment_method&.new_record? ? @new_payment_method : nil %>
    <% end %>
    <div>
      <%= form.label :payment_note, t("records.form.note"), class: "block text-sm font-medium" %>
      <%= form.text_area :payment_note, rows: 2, maxlength: 2000, class: field %>
    </div>
  <% else %>
    <%# Amount paid: Not paid yet / Paid in full (copies the amount due) / Partly paid (up to the amount due),
        as big radio tiles; Record Payment leaves out Not paid yet. Choosing a payment fills an empty paid
        date with today. Without JavaScript the plain fields show %>
    <% options = mode == :pay ? %w[full partial] : %w[none full partial] %>
    <% choice = if record.paid_on.blank? && record.amount_paid.to_d.zero? then "none"
                elsif record.amount_paid.blank? || record.amount_paid == record.amount_required then "full"
                else "partial" end %>
    <% choice = "full" unless choice.in?(options) %>
    <% if mode == :new %>
      <h2 id="payment_heading" class="flex items-center gap-2 <%= heading %>"><%= nav_label("details.png", t("records.form.payment")) %></h2>
    <% elsif record.amount_required.nil? || record.errors[:amount_required].any? %>
      <%# No amount due yet: asked for here, so Paid in full has something to copy %>
      <div>
        <%= form.label :amount_required, "#{Record.human_attribute_name(:amount_required)} (#{record.currency})", class: "block text-sm font-medium" %>
        <%= form.number_field :amount_required, value: amount_value(record.amount_required, record.currency), min: 0, step: amount_step(record.currency), class: field,
              data: { paid_amount_target: "due", action: "input->paid-amount#sync" } %>
      </div>
    <% else %>
      <input type="hidden" value="<%= amount_value(record.amount_required, record.currency) %>" data-paid-amount-target="due">
    <% end %>
    <fieldset class="space-y-2">
      <%= tag.legend mode == :new ? Record.human_attribute_name(:amount_paid) : t("records.form.how_much"), id: ("payment_heading" unless mode == :new),
            class: mode == :new ? "mb-2 block text-sm font-medium" : "mb-2 text-base font-bold" %>
      <div class="grid gap-2 <%= options.size == 2 ? "grid-cols-2" : "sm:grid-cols-3" %>">
        <% options.each do |option| %>
          <% hint = case option
                    when "none" then t("records.form.tile_none")
                    when "full" then (mode != :new && record.amount_required ? money(record.amount_required, record.currency) : t("records.form.tile_full"))
                    else t("records.form.tile_partial") end %>
          <label class="flex min-h-14 cursor-pointer items-start gap-2 rounded-xl border-2 border-gray-300 bg-white px-3 py-2 has-checked:border-emerald-700 has-checked:bg-green-50">
            <%= radio_button_tag :paid_choice, option, choice == option, id: "paid_choice_#{option}", class: "mt-1 h-4 w-4 shrink-0 accent-emerald-700",
                  data: { paid_amount_target: "choice", action: "paid-amount#choose" } %>
            <span><span class="block font-bold leading-snug"><%= t("records.form.paid_choice.#{option}") %></span>
              <span class="block text-xs text-gray-600"><%= hint %></span></span>
          </label>
        <% end %>
      </div>
      <div data-paid-amount-target="paidField">
        <%= form.number_field :amount_paid, value: amount_value(record.amount_paid, record.currency), min: 0, step: amount_step(record.currency), class: field,
              "aria-label": Record.human_attribute_name(:amount_paid), "aria-describedby": "amount_paid_warning", data: { paid_amount_target: "paid", action: "input->paid-amount#check" } %>
        <p id="amount_paid_warning" class="mt-1 text-sm font-medium text-red-700" role="alert" hidden data-paid-amount-target="warning"><%= t("records.form.paid_over_due") %></p>
      </div>
    </fieldset>
    <% if mode == :new %><p class="text-sm text-gray-500"><%= t("records.form.amounts_hint") %></p><% end %>

    <%= tag.div class: "space-y-3", data: new_payment_method_data do %>
      <div class="grid grid-cols-2 gap-2">
        <div>
          <%= form.label :paid_on, class: "block text-sm font-medium" %>
          <%= form.date_field :paid_on, class: field, data: { paid_amount_target: "paidOn" } %>
        </div>
        <div>
          <%= form.label :payment_method_id, class: "block text-sm font-medium" %>
          <%= form.select :payment_method_id, payment_method_options(record, add: true), { include_blank: t("records.form.none"), selected: payment_method_choice(record) }, class: field,
                data: { default_payment_target: "payment", new_payment_method_target: "menu", action: "new-payment-method#toggle" } %>
        </div>
      </div>
      <%= render "payment_methods/inline_fields", method: @new_payment_method&.new_record? ? @new_payment_method : nil %>
    <% end %>
    <% if mode == :pay %><p class="rounded-lg bg-green-50 px-3 py-2 text-sm text-green-900"><%= t("records.form.prefilled") %></p><% end %>
    <div>
      <%= form.label :payment_note, class: "block text-sm font-medium" %>
      <%= form.text_area :payment_note, rows: 3, maxlength: 2000, class: field %>
    </div>
  <% end %>
</section>
