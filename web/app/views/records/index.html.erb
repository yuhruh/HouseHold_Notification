<%# Bills › All: every record, filtered (at the side on a computer), as compact rows, with Export CSV of
    what the filters show and Import above the list. New Record is in the header %>
<% content_for :title, t("records.bills_switch.all_title") %>
<% records = @filter.page_records %>
<% owing = @filter.params[:status] == "outstanding" %>
<% writer = policy(Record).write? %>
<div class="w-full space-y-6 py-4">
  <%= render "shared/flash" %>
  <%= render "bills_switch", current: :all %>

  <div class="flex flex-col gap-6 lg:flex-row lg:items-start">
  <aside aria-label="<%= t(".filters") %>" class="lg:card-raised lg:w-64 lg:shrink-0 lg:rounded-xl lg:bg-white lg:p-4">
  <%= form_with url: household_records_path(Current.household), method: :get, class: "grid grid-cols-2 items-start gap-2 sm:grid-cols-4 lg:grid-cols-1 text-sm" do |f| %>
    <% p = @filter.params %>
    <%= f.select :year, @filter.years, { include_blank: t(".all_years"), selected: p[:year] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".year") %>
    <%= f.select :month, month_options, { include_blank: t(".all_months"), selected: p[:month] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".month") %>
    <%= f.select :type, Category::RECORD_TYPES.values.map { |v| [ t("records.types.#{v}"), v ] }, { include_blank: t(".all_types"), selected: p[:type] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".type") %>
    <%= f.select :category_id, Current.household.categories.ordered.map { |c| [ "#{t("records.types.#{c.record_type}")} · #{c.name}", c.id ] }, { include_blank: t(".all_categories"), selected: p[:category_id] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".category") %>
    <%= f.select :status, Records::Filter::STATUSES.map { |s| [ t("records.status.#{s}"), s ] }, { include_blank: t(".all_statuses"), selected: p[:status] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".status") %>
    <%= f.select :payment_method_id, Current.household.payment_methods.order(:name).map { |pm| [ pm.name, pm.id ] }, { include_blank: t(".all_payment_methods"), selected: p[:payment_method_id] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".payment_method") %>
    <%= f.search_field :q, value: p[:q], placeholder: t(".search"), class: "h-9 rounded-md border border-gray-400 px-2" %>
    <% if p[:currency] %><%= hidden_field_tag :currency, p[:currency] %><% end %>
    <% if p[:amount] %><%= hidden_field_tag :amount, p[:amount] %><% end %>
    <% if p[:from] %><%= hidden_field_tag :from, p[:from] %><% end %>
    <div class="col-span-full flex flex-wrap items-center justify-end gap-2">
      <%= f.button type: "submit", name: nil, class: "btn-press inline-flex items-center gap-1.5 rounded-xl bg-gray-200 text-gray-900 cursor-pointer px-3 py-1.5 font-medium" do %><%= image_tag "icons/filter.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t(".filter") %></span><% end %>
      <% if @filter.active? %><%= link_to t(".clear"), household_records_path(Current.household, from: p[:from]), class: "px-2 py-1.5 underline" %><% end %>
    </div>
  <% end %>
  </aside>

  <div class="min-w-0 flex-1 space-y-4">
  <section aria-label="<%= t(".summary") %>" class="card-raised overflow-x-auto rounded-xl bg-white">
    <table class="w-full text-sm border-separate border-spacing-0">
      <thead class="bg-gray-50 text-left [&_th]:border-b [&_th]:border-gray-400">
        <tr>
          <th class="px-3 py-2"><%= t(".by_period") %></th><th class="px-3 py-2 text-right"><%= t(".paid") %></th>
        </tr>
      </thead>
      <tbody>
        <% @filter.summary.each do |row| %>
          <tr><td class="px-3 py-1.5"><%= record_type_label(row.record_type) %> <span class="text-gray-500"><%= row.currency %></span></td>
            <td class="px-3 py-1.5 text-right"><%= amount_link(row, @filter.params, :paid) %></td></tr>
        <% end %>
        <% @filter.totals.each do |row| %>
          <tr class="font-semibold"><td class="px-3 py-1.5"><%= t(".total") %> <span class="text-gray-500"><%= row.currency %></span></td>
            <td class="px-3 py-1.5 text-right"><%= amount_link(row, @filter.params, :paid) %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <% if (amount = @filter.params[:amount]) %>
    <p class="flex flex-wrap justify-end items-center gap-2 text-sm">
      <span class="rounded-full bg-blue-50 px-3 py-1 text-blue-900"><%= t(".amount_filter.#{amount}") %><%= " · #{@filter.params[:currency]}" if @filter.params[:currency] %></span>
      <%= link_to t(".amount_filter.remove"), household_records_path(Current.household, @filter.params.except(:amount, :currency)), class: "text-blue-700 underline" %>
    </p>
  <% end %>

  <% if records.empty? %>
    <p class="text-gray-600"><%= @filter.active? ? t(".no_match") : t(".empty") %></p>
  <% else %>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <p class="text-sm text-gray-600"><%= t(".count", count: @filter.total) %></p>
      <span class="flex flex-wrap items-center gap-2">
        <%= link_to nav_label("export.png", t(".export_count", count: @filter.total)), household_records_path(Current.household, @filter.params.merge(format: :csv)), class: "btn-press press-sm inline-flex items-center gap-1.5 rounded-xl bg-amber-100 px-3 py-1.5 text-sm font-medium text-gray-900" %>
        <% if writer %><%= link_to nav_label("import.png", t(".import_csv")), new_household_import_path(Current.household), class: "btn-press press-sm inline-flex items-center gap-1.5 rounded-xl bg-white px-3 py-1.5 text-sm font-medium text-gray-900" %><% end %>
        <%= render "per_page", filter: @filter %>
      </span>
    </div>
    <%# One row per record: item, period, due or paid date, amount, status; columns from lg, stacked on a phone %>
    <% cols = "lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_6rem_9rem]" %>
    <ul class="card-raised divide-y divide-gray-200 overflow-hidden rounded-xl bg-white">
      <li aria-hidden="true" class="hidden gap-3 bg-gray-50 px-4 py-2 text-sm font-semibold lg:grid <%= cols %>">
        <span><%= t(".columns.item") %></span><span><%= t(".columns.period") %></span><span><%= t(".columns.date") %></span>
        <span><%= t(".status") %></span><span class="text-right"><%= t(".columns.amount") %></span>
      </li>
      <% records.each do |record| %>
        <%# Maintenance: what it cost once done, its expected cost until then; bills: what was paid, else what's due %>
        <% amount = record.settled ? (record.amount_paid || record.amount_required) : record.amount_required %>
        <% amount_text = if amount.nil? then nil
                         elsif record.maintenance? then t(record.settled ? "records.show.status_line.spent" : "records.show.status_line.expected_cost", amount: money(amount, record.currency)).upcase_first
                         else money(amount, record.currency) end %>
        <%# Unpaid: the due date, red once overdue; paid: the day it was paid (or done) %>
        <% date = if record.settled && record.paid_on then t(record.maintenance? ? ".done_on_date" : ".paid_on_date", date: l(record.paid_on))
                  else record.due_on ? t(".due_on", date: l(record.due_on)) : t(".no_due_date") end %>
        <% date_class = record.status == :overdue ? "font-medium text-red-700" : "text-gray-600" %>
        <li id="<%= dom_id(record) %>">
          <%= link_to household_record_path(Current.household, record), class: "grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-0.5 px-4 py-2.5 text-gray-900 hover:brightness-95 #{record_card_class(record)} #{cols}" do %>
            <span class="min-w-0">
              <span class="font-bold break-words"><%= record.title %></span>
              <% if record.details.present? %><span class="text-sm text-gray-600"><%= record.details %></span><% end %>
              <span class="block text-xs lg:hidden"><span class="text-gray-600"><%= record.period %></span> · <span class="<%= date_class %>"><%= date %></span></span>
            </span>
            <span class="hidden text-sm text-gray-700 lg:block"><%= record.period %> · <%= record_type_label(record.record_type) %></span>
            <span class="hidden text-sm lg:block"><span class="<%= date_class %>"><%= date %></span></span>
            <span class="flex flex-col items-end gap-1 lg:contents">
              <span><%= record_status_badge(record) %></span>
              <span class="text-sm lg:text-right">
                <% if owing %><span class="font-medium text-red-700" data-outstanding><%= t(".outstanding") %> <%= money(record.amount_required - (record.amount_paid || 0), record.currency) %></span>
                <% elsif amount_text %><span class="<%= 'text-gray-600' unless record.settled %>"><%= amount_text %></span><% end %>
              </span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <%= render "pagination", filter: @filter %>
  <% end %>
  </div>
  </div>
</div>
