<% content_for :title, t(".title") %>
<% writer = policy(Record).write? %>
<% records = @filter.page_records %>
<% owing = @filter.params[:status] == "outstanding" %>
<div class="w-full space-y-6 py-4">
  <%= render "shared/flash" %>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <%= page_title("records.png", t(".title")) %>
    <span class="flex gap-2">
      <%= link_to nav_label("export.png", t(".export")), household_records_path(Current.household, @filter.params.merge(format: :csv)), class: "btn-press inline-flex items-center gap-2 rounded-xl bg-amber-200 px-3.5 py-2 font-medium text-gray-900" %>
      <% if writer %>
        <%= link_to nav_label("import.png", t(".import")), new_household_import_path(Current.household), class: "btn-press inline-flex items-center gap-2 rounded-xl bg-white px-3.5 py-2 font-medium text-gray-900" %>
        <%= link_to nav_label("new_entry.png", t(".new")), new_household_record_path(Current.household), class: "btn-press inline-flex items-center gap-2 rounded-xl bg-indigo-200 px-3.5 py-2 font-medium text-gray-900" %>
      <% end %>
    </span>
  </div>

  <%= form_with url: household_records_path(Current.household), method: :get, class: "grid grid-cols-2 items-start gap-2 sm:grid-cols-4 lg:grid-cols-7 text-sm" do |f| %>
    <% p = @filter.params %>
    <%= f.select :year, @filter.years, { include_blank: t(".all_years"), selected: p[:year] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".year") %>
    <%= f.select :month, month_options, { include_blank: t(".all_months"), selected: p[:month] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".month") %>
    <%= f.select :type, Category::RECORD_TYPES.values.map { |v| [ t("records.types.#{v}"), v ] }, { include_blank: t(".all_types"), selected: p[:type] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".type") %>
    <%= f.select :category_id, Current.household.categories.ordered.map { |c| [ "#{t("records.types.#{c.record_type}")} · #{c.name}", c.id ] }, { include_blank: t(".all_categories"), selected: p[:category_id] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".category") %>
    <%= f.select :status, Records::Filter::STATUSES.map { |s| [ t("records.status.#{s}"), s ] }, { include_blank: t(".all_statuses"), selected: p[:status] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".status") %>
    <%= f.select :payment_method_id, Current.household.payment_methods.order(:name).map { |pm| [ pm.name, pm.id ] }, { include_blank: t(".all_payment_methods"), selected: p[:payment_method_id] }, class: "h-9 rounded-md border border-gray-400 px-2", "aria-label": t(".payment_method") %>
    <%= f.search_field :q, value: p[:q], placeholder: t(".search"), class: "h-9 rounded-md border border-gray-400 px-2" %>
    <% if p[:currency] %><%= hidden_field_tag :currency, p[:currency] %><% end %>
    <% if p[:amount] %><%= hidden_field_tag :amount, p[:amount] %><% end %>
    <div class="col-span-full flex flex-wrap items-center justify-end gap-2">
      <%= f.submit t(".filter"), name: nil, class: "btn-press rounded-xl bg-gray-200 text-gray-900 cursor-pointer px-3 py-1.5 font-medium" %>
      <% if @filter.active? %><%= link_to t(".clear"), household_records_path(Current.household), class: "px-2 py-1.5 underline" %><% end %>
    </div>
  <% end %>

  <section aria-label="<%= t(".summary") %>" class="card-raised overflow-x-auto rounded-xl bg-white">
    <table class="w-full text-sm border-separate border-spacing-0">
      <thead class="bg-gray-50 text-left [&_th]:border-b [&_th]:border-gray-400">
        <tr>
          <th class="px-3 py-2"><%= t(".by_period") %></th><th class="px-3 py-2 text-right"><%= t(".paid") %></th>
        </tr>
      </thead>
      <tbody>
        <% @filter.summary.each do |row| %>
          <tr><td class="px-3 py-1.5"><%= t("records.types.#{row.record_type}") %> <span class="text-gray-500"><%= row.currency %></span></td>
            <td class="px-3 py-1.5 text-right"><%= amount_link(row, @filter.params, :paid) %></td></tr>
        <% end %>
        <% @filter.totals.each do |row| %>
          <tr class="font-semibold"><td class="px-3 py-1.5"><%= t(".total") %> <span class="text-gray-500"><%= row.currency %></span></td>
            <td class="px-3 py-1.5 text-right"><%= amount_link(row, @filter.params, :paid) %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <% if (amount = @filter.params[:amount]) %>
    <p class="flex flex-wrap justify-end items-center gap-2 text-sm">
      <span class="rounded-full bg-blue-50 px-3 py-1 text-blue-900"><%= t(".amount_filter.#{amount}") %><%= " · #{@filter.params[:currency]}" if @filter.params[:currency] %></span>
      <%= link_to t(".amount_filter.remove"), household_records_path(Current.household, @filter.params.except(:amount, :currency)), class: "text-blue-700 underline" %>
    </p>
  <% end %>

  <% if records.empty? %>
    <p class="text-gray-600"><%= @filter.active? ? t(".no_match") : t(".empty") %></p>
  <% else %>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <p class="text-sm text-gray-600"><%= t(".count", count: @filter.total) %></p>
      <%= render "per_page", filter: @filter %>
    </div>
    <div class="card-raised overflow-x-auto rounded-xl bg-white">
      <table class="w-full text-sm border-separate border-spacing-0">
        <thead class="bg-gray-50 text-left [&_th]:border-b [&_th]:border-gray-400">
          <tr>
            <th class="px-2 py-2">✅</th><th class="px-2 py-2"><%= t(".period") %></th><th class="px-2 py-2"><%= t(".item") %></th>
            <th class="px-2 py-2"><%= t(".details") %></th>
            <th class="px-2 py-2 text-right"><%= t(".paid") %></th><% if owing %><th class="px-2 py-2 text-right"><%= t(".outstanding") %></th><% end %><th class="px-2 py-2"><%= t(".paid_on") %></th>
            <th class="px-2 py-2"><%= t(".status") %></th><% if writer %><th class="px-2 py-2"></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% records.each do |record| %>
            <tr id="<%= dom_id(record) %>" class="align-top <%= record_row_class(record) %>">
              <td class="px-2 py-1.5"><%= record_check(record) %></td>
              <td class="whitespace-nowrap px-2 py-1.5"><%= record.period %></td>
              <td class="px-2 py-1.5"><%= link_to record.title, household_record_path(Current.household, record), class: "text-blue-700 underline" %>
                <span class="block text-xs text-gray-500"><%= t("records.types.#{record.record_type}") %></span></td>
              <td class="min-w-40 max-w-xs whitespace-pre-line break-words px-2 py-1.5"><%= record.details %></td>
              <td class="whitespace-nowrap px-2 py-1.5 text-right"><%= money(record.amount_paid, record.currency) %></td>
              <% if owing %><td class="whitespace-nowrap px-2 py-1.5 text-right font-medium text-red-700"><%= money(record.amount_required - (record.amount_paid || 0), record.currency) %></td><% end %>
              <td class="whitespace-nowrap px-2 py-1.5"><%= record.paid_on && l(record.paid_on) %></td>
              <td class="px-2 py-1.5"><%= record_status_badge(record) %>
                <% unless record.settled %><span class="block whitespace-nowrap text-xs <%= record.status == :overdue ? "text-red-700" : "text-gray-500" %>"><%= record.due_on ? t(".due_on", date: l(record.due_on)) : t(".no_due_date") %></span><% end %></td>
              <% if writer %>
                <td class="px-2 py-1.5">
                  <% unless record.settled %>
                    <% if record.amount_required.nil? && !record.maintenance? %>
                      <%= link_to t(".mark_paid"), mark_paid_household_record_path(Current.household, record), class: "whitespace-nowrap rounded border border-green-700 px-2 py-0.5 text-green-800" %>
                    <% else %>
                      <%= button_to t(".mark_paid"), mark_paid_household_record_path(Current.household, record), class: "cursor-pointer whitespace-nowrap rounded border border-green-700 px-2 py-0.5 text-green-800" %>
                    <% end %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "pagination", filter: @filter %>
  <% end %>
</div>
