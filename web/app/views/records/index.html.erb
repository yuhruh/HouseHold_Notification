<% content_for :title, t(".title") %>
<% writer = policy(Record).write? %>
<% records = @filter.records %>
<% owing = @filter.params[:status] == "outstanding" %>
<div class="w-full space-y-6 py-4">
  <%= render "shared/flash" %>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <%= page_title("records.png", t(".title")) %>
    <% if writer %>
      <span class="flex gap-2">
        <%= link_to nav_label("import.png", t(".import")), new_household_import_path(Current.household), class: "inline-flex items-center gap-2 rounded-md border border-gray-400 px-3.5 py-2 font-medium hover:bg-gray-50" %>
        <%= link_to t(".new"), new_household_record_path(Current.household), class: "rounded-md bg-blue-600 px-3.5 py-2 font-medium text-white hover:bg-blue-500" %>
      </span>
    <% end %>
  </div>

  <%= form_with url: household_records_path(Current.household), method: :get, class: "grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-8 text-sm" do |f| %>
    <% p = @filter.params %>
    <%= f.select :year, @filter.years, { include_blank: t(".all_years"), selected: p[:year] }, class: "rounded-md border border-gray-400 px-2 py-1.5", "aria-label": t(".year") %>
    <%= f.select :month, month_options, { include_blank: t(".all_months"), selected: p[:month] }, class: "rounded-md border border-gray-400 px-2 py-1.5", "aria-label": t(".month") %>
    <%= f.select :type, Category::RECORD_TYPES.values.map { |v| [ t("records.types.#{v}"), v ] }, { include_blank: t(".all_types"), selected: p[:type] }, class: "rounded-md border border-gray-400 px-2 py-1.5", "aria-label": t(".type") %>
    <%= f.select :category_id, Current.household.categories.ordered.map { |c| [ "#{t("records.types.#{c.record_type}")} · #{c.name}", c.id ] }, { include_blank: t(".all_categories"), selected: p[:category_id] }, class: "rounded-md border border-gray-400 px-2 py-1.5", "aria-label": t(".category") %>
    <%= f.select :status, Records::Filter::STATUSES.map { |s| [ t("records.status.#{s}"), s ] }, { include_blank: t(".all_statuses"), selected: p[:status] }, class: "rounded-md border border-gray-400 px-2 py-1.5", "aria-label": t(".status") %>
    <%= f.select :payment_method_id, Current.household.payment_methods.order(:name).map { |pm| [ pm.name, pm.id ] }, { include_blank: t(".all_payment_methods"), selected: p[:payment_method_id] }, class: "rounded-md border border-gray-400 px-2 py-1.5", "aria-label": t(".payment_method") %>
    <%= f.search_field :q, value: p[:q], placeholder: t(".search"), class: "rounded-md border border-gray-400 px-2 py-1.5" %>
    <% if p[:currency] %><%= hidden_field_tag :currency, p[:currency] %><% end %>
    <div class="flex flex-wrap gap-2">
      <%= f.submit t(".filter"), name: nil, class: "cursor-pointer rounded-md bg-gray-800 px-3 py-1.5 font-medium text-white" %>
      <% if @filter.active? %><%= link_to t(".clear"), household_records_path(Current.household), class: "px-2 py-1.5 underline" %><% end %>
      <%= link_to t(".export"), household_records_path(Current.household, @filter.params.merge(format: :csv)), class: "px-2 py-1.5 underline" %>
    </div>
  <% end %>

  <section aria-label="<%= t(".summary") %>" class="overflow-x-auto rounded-lg border">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left">
        <tr><th class="px-3 py-2"><%= t(".by_period") %></th><th class="px-3 py-2 text-right"><%= t(".required") %></th>
          <th class="px-3 py-2 text-right"><%= t(".paid") %></th><th class="px-3 py-2 text-right"><%= t(".outstanding") %></th></tr>
      </thead>
      <tbody class="divide-y">
        <% @filter.summary.each do |row| %>
          <tr><td class="px-3 py-1.5"><%= t("records.types.#{row.record_type}") %> <span class="text-gray-500"><%= row.currency %></span></td>
            <td class="px-3 py-1.5 text-right"><%= money(row.required, row.currency) %></td>
            <td class="px-3 py-1.5 text-right"><%= money(row.paid, row.currency) %></td>
            <td class="px-3 py-1.5 text-right"><%= outstanding_link(row, @filter.params) %></td></tr>
        <% end %>
        <% @filter.totals.each do |row| %>
          <tr class="font-semibold"><td class="px-3 py-1.5"><%= t(".total") %> <span class="text-gray-500"><%= row.currency %></span></td>
            <td class="px-3 py-1.5 text-right"><%= money(row.required, row.currency) %></td>
            <td class="px-3 py-1.5 text-right"><%= money(row.paid, row.currency) %></td>
            <td class="px-3 py-1.5 text-right"><%= outstanding_link(row, @filter.params) %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <% if records.empty? %>
    <p class="text-gray-600"><%= @filter.active? ? t(".no_match") : t(".empty") %></p>
  <% else %>
    <p class="text-sm text-gray-600"><%= t(".count", count: records.size) %></p>
    <div class="overflow-x-auto rounded-lg border">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left">
          <tr>
            <th class="px-2 py-2">✅</th><th class="px-2 py-2"><%= t(".period") %></th><th class="px-2 py-2"><%= t(".item") %></th>
            <th class="px-2 py-2"><%= t(".details") %></th><th class="px-2 py-2 text-right"><%= t(".required") %></th>
            <th class="px-2 py-2 text-right"><%= t(".paid") %></th><% if owing %><th class="px-2 py-2 text-right"><%= t(".outstanding") %></th><% end %><th class="px-2 py-2"><%= t(".paid_on") %></th>
            <th class="px-2 py-2"><%= t(".status") %></th><% if writer %><th class="px-2 py-2"></th><% end %>
          </tr>
        </thead>
        <tbody class="divide-y">
          <% records.each do |record| %>
            <tr id="<%= dom_id(record) %>" class="align-top">
              <td class="px-2 py-1.5"><%= record_check(record) %></td>
              <td class="whitespace-nowrap px-2 py-1.5"><%= record.period %></td>
              <td class="px-2 py-1.5"><%= link_to record.title, household_record_path(Current.household, record), class: "text-blue-700 underline" %>
                <span class="block text-xs text-gray-500"><%= t("records.types.#{record.record_type}") %> · #<%= record.record_no %></span></td>
              <td class="max-w-48 truncate px-2 py-1.5" title="<%= record.details %>"><%= record.details %></td>
              <td class="whitespace-nowrap px-2 py-1.5 text-right"><%= money(record.amount_required, record.currency) %></td>
              <td class="whitespace-nowrap px-2 py-1.5 text-right"><%= money(record.amount_paid, record.currency) %></td>
              <% if owing %><td class="whitespace-nowrap px-2 py-1.5 text-right font-medium text-red-700"><%= money(record.amount_required - (record.amount_paid || 0), record.currency) %></td><% end %>
              <td class="whitespace-nowrap px-2 py-1.5"><%= record.paid_on && l(record.paid_on) %></td>
              <td class="px-2 py-1.5"><%= record_status_badge(record) %>
                <% if !record.settled && record.due_on.nil? %><span class="block text-xs text-gray-500"><%= t(".no_due_date") %></span><% end %></td>
              <% if writer %>
                <td class="px-2 py-1.5">
                  <% unless record.settled %>
                    <% if record.amount_required.nil? && !record.maintenance? %>
                      <%= link_to t(".mark_paid"), mark_paid_household_record_path(Current.household, record), class: "whitespace-nowrap rounded border border-green-700 px-2 py-0.5 text-green-800" %>
                    <% else %>
                      <%= button_to t(".mark_paid"), mark_paid_household_record_path(Current.household, record), class: "cursor-pointer whitespace-nowrap rounded border border-green-700 px-2 py-0.5 text-green-800" %>
                    <% end %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
