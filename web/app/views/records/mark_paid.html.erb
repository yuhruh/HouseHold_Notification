<% content_for :title, t(".title") %>
<div class="w-full mx-auto max-w-md space-y-6 py-4">
  <h1 class="text-center text-2xl font-bold"><%= t(".title") %></h1>
  <p><%= @record.title %> · <%= @record.period %></p>
  <% if @record.errors.any? %>
    <ul class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><% @record.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  <% end %>
  <%= form_with url: mark_paid_household_record_path(Current.household, @record), method: :post, class: "space-y-4" do |f| %>
    <%= f.label :amount, t(".amount", currency: @record.currency), class: "block text-sm font-medium" %>
    <%= f.number_field :amount, min: 0.01, step: "0.01", required: true, autofocus: true, class: "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
    <p class="text-sm text-gray-500"><%= t(".hint") %></p>
    <%= f.submit t(".submit"), class: "btn-press rounded-xl bg-green-200 text-green-900 cursor-pointer px-3.5 py-2 font-medium" %>
  <% end %>
</div>
