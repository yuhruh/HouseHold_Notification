<% content_for :title, @record.title %>
<% writer = policy(@record).write? %>
<div class="w-full max-w-2xl space-y-6 py-4">
  <%= render "shared/flash" %>
  <div class="flex flex-wrap items-center gap-3">
    <h1 class="text-3xl font-bold"><%= record_check(@record) %> <%= @record.title %></h1>
    <%= record_status_badge(@record) %>
  </div>
  <p class="text-sm text-gray-600"><%= t("records.types.#{@record.record_type}") %> · <%= @record.category.name %> · #<%= @record.record_no %><%= " · #{t('.sheet_id', id: @record.import_key)}" if @record.import_key %></p>

  <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
    <dt class="text-gray-500"><%= t("records.form.period") %></dt><dd><%= @record.period %></dd>
    <dt class="text-gray-500"><%= Record.human_attribute_name(:details) %></dt><dd class="whitespace-pre-line"><%= @record.details.presence || "–" %></dd>
    <dt class="text-gray-500"><%= Record.human_attribute_name(:amount_required) %></dt><dd><%= money(@record.amount_required, @record.currency) %></dd>
    <dt class="text-gray-500"><%= Record.human_attribute_name(:amount_paid) %></dt><dd><%= money(@record.amount_paid, @record.currency) %></dd>
    <dt class="text-gray-500"><%= Record.human_attribute_name(:due_on) %></dt><dd><%= @record.due_on ? l(@record.due_on) : t(".no_due_date") %></dd>
    <dt class="text-gray-500"><%= Record.human_attribute_name(:paid_on) %></dt><dd><%= @record.paid_on ? l(@record.paid_on) : "–" %></dd>
    <% if @record.due_on.nil? && !@record.settled %>
      <dt class="text-gray-500"><%= Record.human_attribute_name(:reminder_frequency) %></dt><dd><%= t("records.reminder_frequencies.#{@record.reminder_frequency}") %></dd>
    <% end %>
    <dt class="text-gray-500"><%= Record.human_attribute_name(:payment_method) %></dt><dd><%= @record.payment_method&.name || "–" %></dd>
    <dt class="text-gray-500"><%= Record.human_attribute_name(:payment_note) %></dt><dd class="whitespace-pre-line"><%= @record.payment_note.presence || "–" %></dd>
    <dt class="text-gray-500"><%= Record.human_attribute_name(:next_due_on) %></dt><dd><%= @record.next_due_on ? l(@record.next_due_on) : "–" %></dd>
    <% if @record.recurring_template %>
      <dt class="text-gray-500"><%= t("households.show.templates") %></dt>
      <dd><%= link_to @record.recurring_template.title, (writer ? edit_household_recurring_template_path(Current.household, @record.recurring_template) : household_recurring_templates_path(Current.household)), class: "text-blue-700 underline" %></dd>
    <% end %>
  </dl>

  <%= render "records/reminder_actions", record: @record, snooze: @snooze&.until_on %>

  <% if writer %>
    <div class="flex flex-wrap gap-2">
      <% unless @record.settled %>
        <% if @record.amount_required.nil? && !@record.maintenance? %>
          <%= link_to t("records.index.mark_paid"), mark_paid_household_record_path(Current.household, @record), class: "rounded-md bg-green-700 px-3.5 py-2 font-medium text-white" %>
        <% else %>
          <%= button_to t("records.index.mark_paid"), mark_paid_household_record_path(Current.household, @record), class: "cursor-pointer rounded-md bg-green-700 px-3.5 py-2 font-medium text-white" %>
        <% end %>
      <% end %>
      <% if @record.recurring_template_id.nil? %>
        <%= link_to t(".make_recurring"), new_household_recurring_template_path(Current.household, from_record: @record.id), class: "rounded-md border border-gray-400 px-3.5 py-2 font-medium hover:bg-gray-50" %>
      <% end %>
      <%= link_to t(".edit"), edit_household_record_path(Current.household, @record), class: "rounded-md border border-gray-400 px-3.5 py-2 font-medium hover:bg-gray-50" %>
      <%= button_to t(".delete"), household_record_path(Current.household, @record), method: :delete, form: { data: { turbo_confirm: t(".delete_confirm") } }, class: "cursor-pointer rounded-md border border-red-300 px-3.5 py-2 font-medium text-red-700 hover:bg-red-50" %>
    </div>
  <% end %>

  <%= render "photos/gallery", record: @record %>

  <section class="space-y-2">
    <h2 class="text-lg font-semibold"><%= t(".activity") %></h2>
    <ul class="divide-y rounded-lg border text-sm">
      <% @events.each do |event| %>
        <li class="px-4 py-2"><%= t("records.events.#{event.action}") %>
          <% if event.action.in?(%w[updated marked_paid]) && event.diff.any? %>
            <span class="block text-gray-600"><%= event.diff.keys.map { |k| Record.human_attribute_name(k) }.join("、") %></span>
          <% end %>
          <span class="block text-gray-500"><%= l(event.created_at, format: :short) %> · <%= event.user&.display_name.presence || event.user&.email_address || t(".former_member") %></span></li>
      <% end %>
    </ul>
  </section>
</div>
