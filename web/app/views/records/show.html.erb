<% content_for :title, @record.title %>
<% writer = policy(@record).write? %>
<div class="w-full mx-auto max-w-2xl space-y-6 py-4">
  <%= render "shared/flash" %>
  <div class="space-y-1">
    <h1 class="text-center text-3xl font-bold"><%= @record.title %></h1>
    <p class="text-center text-sm text-gray-600"><%= record_type_label(@record.record_type) %> · <%= @record.category.name %></p>
    <% if @record.external_ref %><p class="text-center text-xs font-semibold text-orange-800"><%= @record.external_ref.start_with?("taipower:") ? t(".synced_taipower") : t(".synced") %></p><% end %>
  </div>
  <%= render "status_line", record: @record %>

  <% task = @record.maintenance? %>
  <% paid_any = @record.paid_on.present? || @record.amount_paid.to_d.positive? %>
  <% card = "card-raised space-y-3 rounded-xl bg-white p-4" %>
  <% press = "btn-press press-sm inline-flex shrink-0 items-center gap-1.5 rounded-xl bg-white px-3 py-1 text-sm font-medium" %>
  <% small = "#{press} text-gray-900" %>
  <% list = "grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm" %>

  <%# Not paid yet: one big button for "I paid it" (maintenance: Mark Done). It opens the payment form, filled
      in (paid in full, today); the bill's own details are changed from their card with Edit Details %>
  <% if writer && !@record.settled %>
    <%= link_to edit_household_record_path(Current.household, @record, pay: 1), class: "btn-press flex min-h-14 w-full items-center gap-3 rounded-xl bg-green-200 px-4 py-2.5 text-green-900" do %>
      <%= image_tag(task ? "icons/maintenance.png" : "icons/paid.png", alt: "", class: "h-7 w-7 shrink-0 object-contain") %>
      <span><span class="block text-lg font-bold leading-snug"><%= task ? t(".mark_done") : t(".record_payment") %></span>
        <span class="block text-sm"><%= task ? t(".mark_done_hint") : t(".record_payment_hint") %></span></span>
    <% end %>
  <% end %>

  <section class="<%= card %>" aria-labelledby="bill_details_heading">
    <div class="flex items-center justify-between gap-3">
      <h2 id="bill_details_heading" class="text-lg font-semibold"><%= t(task ? "records.form.task" : "records.form.billing") %></h2>
      <% if writer %>
        <%= link_to edit_household_record_path(Current.household, @record), class: small do %><%= image_tag "icons/edit.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".edit_details") %></span><% end %>
      <% end %>
    </div>
    <dl class="<%= list %>">
      <dt class="text-gray-500"><%= t("records.form.period") %></dt><dd><%= @record.period %></dd>
      <dt class="text-gray-500"><%= Record.human_attribute_name(:details) %></dt><dd class="whitespace-pre-line"><%= @record.details.presence || "–" %></dd>
      <% unless task && @record.settled %><%# done maintenance: its Cost is what counts %>
        <dt class="text-gray-500"><%= record_attr_label(@record, :amount_required) %></dt><dd><%= money(@record.amount_required, @record.currency) %></dd>
      <% end %>
      <% if @record.payable_from %>
        <dt class="text-gray-500"><%= Record.human_attribute_name(:payable_from) %></dt><dd><%= l(@record.payable_from) %></dd>
      <% end %>
      <dt class="text-gray-500"><%= Record.human_attribute_name(:due_on) %></dt><dd><%= @record.due_on ? l(@record.due_on) : t(".no_due_date") %></dd>
      <% if @record.due_on.nil? && !@record.settled %>
        <dt class="text-gray-500"><%= Record.human_attribute_name(:reminder_frequency) %></dt><dd><%= t("records.reminder_frequencies.#{@record.reminder_frequency}") %></dd>
      <% end %>
      <dt class="text-gray-500"><%= Record.human_attribute_name(:next_due_on) %></dt><dd><%= @record.next_due_on ? l(@record.next_due_on) : "–" %></dd>
      <% if @record.recurring_template %>
        <dt class="text-gray-500"><%= t("households.show.templates") %></dt>
        <dd><%= link_to @record.recurring_template.title, (writer ? edit_household_recurring_template_path(Current.household, @record.recurring_template) : household_recurring_templates_path(Current.household)), class: "text-blue-700 underline" %></dd>
      <% end %>
    </dl>
  </section>

  <section class="<%= card %>" aria-labelledby="payment_details_heading">
    <div class="flex items-center justify-between gap-3">
      <h2 id="payment_details_heading" class="text-lg font-semibold"><%= t(task ? "records.form.done" : "records.form.payment") %></h2>
      <% if writer && paid_any %>
        <%= link_to edit_household_record_path(Current.household, @record, payment: 1), class: small do %><%= image_tag "icons/edit.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= task ? t(".edit_done") : t(".edit_payment") %></span><% end %>
      <% end %>
    </div>
    <% if paid_any %>
      <dl class="<%= list %>">
        <dt class="text-gray-500"><%= record_attr_label(@record, :amount_paid) %></dt><dd><%= money(@record.amount_paid, @record.currency) %></dd>
        <dt class="text-gray-500"><%= record_attr_label(@record, :paid_on) %></dt><dd><%= @record.paid_on ? l(@record.paid_on) : "–" %></dd>
        <dt class="text-gray-500"><%= Record.human_attribute_name(:payment_method) %></dt><dd><%= @record.payment_method&.name || "–" %></dd>
        <dt class="text-gray-500"><%= record_attr_label(@record, :payment_note) %></dt><dd class="whitespace-pre-line"><%= @record.payment_note.presence || "–" %></dd>
      </dl>
    <% else %>
      <p class="text-sm text-gray-600"><%= writer ? t(task ? ".not_done_hint" : ".not_paid_hint") : t(task ? ".status_line.not_done" : ".status_line.not_paid") %></p>
    <% end %>
  </section>

  <%# The rest, quieter: snooze and restart reminders (everyone), Make This Recurring and Delete (writers) %>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "records/reminder_actions", record: @record, snooze: @snooze&.until_on %>
    <% if writer %>
      <% if @record.recurring_template_id.nil? %>
        <%= link_to new_household_recurring_template_path(Current.household, from_record: @record.id), class: small do %><%= image_tag "icons/recurring.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".make_recurring") %></span><% end %>
      <% end %>
      <%= button_to household_record_path(Current.household, @record), method: :delete, form: { data: { turbo_confirm: t(".delete_confirm") } }, class: "#{press} cursor-pointer text-red-700" do %><%= image_tag "icons/delete.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".delete") %></span><% end %>
    <% end %>
  </div>

  <%= render "photos/gallery", record: @record %>

  <%= render "past_records", record: @record, past: @past, count: @past_count if @past_count.positive? %>

  <%# Folded like What's New: the log can get long %>
  <details id="activity" class="space-y-2">
    <summary class="cursor-pointer text-lg font-semibold text-blue-800"><h2 class="inline"><%= t(".activity") %> (<%= @events.size %>)</h2></summary>
    <ul class="mt-2 divide-y rounded-lg border text-sm">
      <% @events.each do |event| %>
        <li class="px-4 py-2"><%= t("records.events.#{event.action}") %>
          <% if event.action.in?(%w[updated marked_paid]) && event.diff.any? %>
            <span class="block text-gray-600"><%= event.diff.keys.map { |k| Record.human_attribute_name(k) }.join("、") %></span>
          <% end %>
          <span class="block text-gray-500"><%= l(event.created_at, format: :short) %> · <%= event.action.start_with?("taipower_") ? t(".auto_sync_taipower") : event.action.start_with?("gas_") ? t(".auto_sync") : event.user&.display_name.presence || event.user&.email_address || t(".former_member") %></span></li>
      <% end %>
    </ul>
  </details>
</div>
