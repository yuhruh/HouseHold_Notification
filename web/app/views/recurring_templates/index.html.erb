<% content_for :title, t(".title") %>
<% writer = policy(RecurringTemplate).write? %>
<div class="w-full mx-auto max-w-3xl space-y-6 py-4">
  <%= render "shared/flash" %>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <%= page_title("recurring.png", t(".title")) %>
    <% if writer %><%= link_to new_household_recurring_template_path(Current.household), class: "btn-press inline-flex items-center gap-1.5 rounded-xl bg-blue-200 text-gray-900 px-3.5 py-2 font-medium" do %><%= image_tag "icons/recurring.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t(".new") %></span><% end %><% end %>
  </div>
  <p class="text-sm text-gray-600"><%= t(".intro") %></p>
  <% if @templates.empty? %>
    <p class="text-gray-600"><%= t(".empty") %></p>
  <% else %>
    <ul class="divide-y rounded-lg border">
      <% @templates.each do |template| %>
        <% next_period = template.next_period(@today) %>
        <li class="space-y-2 px-4 py-3">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <p class="font-medium"><%= template.title %><%= " · #{template.details}" if template.details.present? %></p>
              <p class="text-sm text-gray-600"><%= t("records.types.#{template.record_type}") %> · <%= interval_label(template.interval_months) %> · <%= template_amount(template) %>
                · <%= t(".next", period: next_period.to_s, date: l(template.generation_date(next_period))) %></p>
              <p class="text-xs text-gray-500"><%= t(".bills", count: template.records.size) %></p>
            </div>
            <% if writer %>
              <span class="flex gap-3 text-sm">
                <%= link_to edit_household_recurring_template_path(Current.household, template), class: "inline-flex items-center gap-1 underline" do %><%= image_tag "icons/edit.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".edit") %></span><% end %>
                <%= button_to household_recurring_template_path(Current.household, template), method: :delete, form: { data: { turbo_confirm: t(".delete_confirm") } }, class: "inline-flex items-center gap-1 cursor-pointer text-red-700 underline" do %><%= image_tag "icons/delete.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= t(".delete") %></span><% end %>
              </span>
            <% end %>
          </div>
          <% template.ambiguous_periods(@today).each do |period| %>
            <% index = period.start_year * 12 + period.start_month - 1 %>
            <div class="rounded bg-amber-50 p-3 text-sm">
              <p class="font-medium text-amber-900"><%= t(".ambiguous", count: Recurring::Generator.matching_bills(template, period).count, period: period.to_s) %></p>
              <% if writer %>
                <div class="mt-2 flex flex-wrap gap-2">
                  <% Recurring::Generator.matching_bills(template, period).each do |record| %>
                    <%= button_to t(".link_this", title: record.title, details: record.details.presence || "–", amount: money(record.amount_required, record.currency)), link_household_recurring_template_path(Current.household, template, period_index: index, record_id: record.id), class: "cursor-pointer rounded border border-amber-700 px-2 py-1" %>
                  <% end %>
                  <%= button_to t(".create_new"), link_household_recurring_template_path(Current.household, template, period_index: index), class: "cursor-pointer rounded border px-2 py-1" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
