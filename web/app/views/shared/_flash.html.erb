<% if flash[:alert] %>
  <p class="mb-5 rounded-lg bg-red-50 px-3 py-2 font-medium text-red-700" id="alert"><%= flash[:alert] %></p>
<% end %>
<% if flash[:notice] %>
  <%# notice_more: a second line under it (after a restock: which batch to use first) %>
  <p class="mb-5 rounded-lg bg-green-50 px-3 py-2 font-medium text-green-700" id="notice"><%= flash[:notice] %><% if flash[:notice_more].present? %><span class="mt-0.5 block text-sm text-green-900"><%= flash[:notice_more] %></span><% end %></p>
<% end %>
