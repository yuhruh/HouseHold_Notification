<% content_for :title, "Google sign-in check" %>
<div class="w-full max-w-2xl space-y-6">
  <h1 class="text-2xl font-bold">Google sign-in check (X1, X2, X10)</h1>
  <% if notice %><p class="rounded bg-green-50 p-3 text-green-800"><%= notice %></p><% end %>
  <% if alert %><p class="rounded bg-red-50 p-3 text-red-800"><%= alert %></p><% end %>

  <ol class="list-decimal space-y-1 pl-5 text-sm">
    <li><strong>X2 / X10:</strong> press Sign in with Google and pick your account. A family member does the same on their own device with their own Google account (not a test user).</li>
    <li><strong>X1:</strong> while still signed in to Google, press Re-authenticate. Google must ask for the password again (not a one-click account pick), and the result below must say auth_time is fresh.</li>
  </ol>

  <div class="flex flex-wrap gap-2">
    <%= button_to "Sign in with Google", spike_google_start_path(mode: "signin"), data: { turbo: false }, class: "rounded bg-blue-600 px-3 py-2 text-white" %>
    <%= button_to "Re-authenticate", spike_google_start_path(mode: "reauth"), data: { turbo: false }, class: "rounded bg-gray-800 px-3 py-2 text-white" %>
  </div>

  <% if @result %>
    <section class="space-y-2">
      <h2 class="text-lg font-semibold">Last result</h2>
      <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="font-medium">Mode</dt><dd><%= @result["reauth"] ? "Re-authenticate (prompt=login, max_age=0)" : "Sign in" %></dd>
        <dt class="font-medium">Email</dt><dd><%= @result["email"] %> (verified: <%= @result["email_verified"] %>)</dd>
        <dt class="font-medium">Name</dt><dd><%= @result["name"] %></dd>
        <dt class="font-medium">Requested at</dt><dd><%= Time.zone.at(@result["requested_at"]).iso8601 %></dd>
        <dt class="font-medium">auth_time</dt><dd><%= @result["auth_time"] ? Time.zone.at(@result["auth_time"]).iso8601 : "(not returned)" %></dd>
        <dt class="font-medium">Token issued</dt><dd><%= Time.zone.at(@result["iat"]).iso8601 %></dd>
      </dl>
      <% if @result["reauth"] %>
        <p class="rounded p-3 <%= @result["fresh_auth"] ? "bg-green-50 text-green-800" : "bg-red-50 text-red-800" %>">
          <%= @result["fresh_auth"] ? "X1 token check passes: auth_time is after the request." : "X1 token check fails: auth_time is missing or older than the request." %>
          Did Google ask for your password? That part you confirm yourself.
        </p>
      <% end %>
    </section>
  <% end %>

  <p><%= link_to "← M0 checks", spike_checks_path, class: "text-blue-700 underline" %></p>
</div>
