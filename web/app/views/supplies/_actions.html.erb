<%# −1 Used one (in place, with a toast; off at 0) and Bought more (a dialog on a computer) %>
<% if policy(supply).update? && supply.archived_at.nil? %>
  <div class="flex shrink-0 items-center gap-2">
    <%= button_to household_supply_counts_path(Current.household, supply), params: { used_one: 1 }, disabled: supply.level.zero?,
          form: { data: { turbo_stream: true } }, "aria-label": t("supplies.actions.used_one_label", item: supply.name),
          class: "btn-press cursor-pointer rounded-xl bg-white px-3 py-1.5 text-sm font-bold text-gray-900 disabled:cursor-not-allowed disabled:opacity-50" do %>
      −1<span class="<%= 'sr-only' if local_assigns[:compact] %>"> <%= t("supplies.actions.used_one") %></span>
    <% end %>
    <%= link_to new_household_supply_purchase_path(Current.household, supply), data: modal_link_data,
          class: "btn-press rounded-xl bg-green-100 px-3 py-1.5 text-sm font-bold text-green-900" do %>
      <%= local_assigns[:compact] ? t("supplies.actions.bought") : t("supplies.actions.bought_more") %>
    <% end %>
  </div>
<% end %>
