<%# The Forecast card: what's left now and the bar's Total over its right end, how fast it goes, when it
    runs out and when the alert comes, with −1 / Restock at its top right and "Inventory: __ left".
    With several brands in stock: "In stock by brand" (each brand's share and its own −1, the one to use
    first on top) and Inventory is one closed line that opens to a number per brand. A brand restocked
    before it ran out lists its batches under it (expiry date, bought, how many, a −1 each); with one
    brand, "In stock by expiry date" lists them instead.
    Replaced in place after a count %>
<% status = forecast.status %>
<% brands = supply_brands(supply, forecast) %>
<% writer = policy(supply).update? && supply.archived_at.nil? %>
<section id="<%= dom_id(supply, :forecast) %>" class="card-raised space-y-3 rounded-2xl p-4 <%= supply_tone(status, :card) %>" aria-labelledby="<%= dom_id(supply, :forecast_title) %>">
  <div class="relative flex flex-wrap items-start justify-between gap-3">
    <div class="flex items-center gap-2">
      <h2 id="<%= dom_id(supply, :forecast_title) %>" class="text-lg font-bold"><%= t("supplies.show.forecast") %></h2>
      <%= supply_badge(status) %>
    </div>
    <%= render "supplies/actions", supply:, forecast:, menu: :page %>
  </div>
  <p class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1"><span><span class="text-2xl font-extrabold"><%= t("supplies.show.now", left: supply_left(supply, forecast)) %></span><% if (inside = supply_inside(supply, forecast)) %> <span class="text-gray-600"><%= t("supplies.inside", count: forecast.estimated? && forecast.on_hand_rounded.positive? ? "~#{inside}" : inside) %></span><% end %></span><%= supply_total(supply, forecast) %></p>
  <div class="h-2.5 w-full overflow-hidden rounded-full bg-gray-200" aria-hidden="true"><div class="h-full rounded-full <%= SuppliesHelper::BAR.fetch(status) %>" style="width: <%= forecast.fill_percent %>%"></div></div>
  <ul class="space-y-1 text-sm">
    <% if forecast.enough_data? %>
      <li><%= t("supplies.show.rate", rate: supply_rate(supply, forecast)) %></li>
    <% end %>
    <li class="<%= supply_line_class(forecast) %> font-semibold"><%= supply_line(supply, forecast) %></li>
    <% if forecast.buy_by && !forecast.out? %>
      <li><%= t("supplies.show.alert_on", date: l([ forecast.buy_by, forecast.today ].max, format: :short)) %></li>
    <% end %>
    <li class="text-gray-600"><%= forecast.samples.any? ? t("supplies.show.based_on", count: forecast.samples.size) : t("supplies.show.learning_hint", button: supply_used_one(supply)) %></li>
  </ul>
  <% if brands.several_batches? %>
    <%# One brand bought again before it ran out: each batch by its expiry date, with its own −1 %>
    <div class="rounded-xl border border-gray-300 bg-white/60 px-3 pt-2.5 pb-1">
      <h3 class="text-sm font-extrabold"><%= t("supplies.brands.by_expiry_title") %></h3>
      <ul class="divide-y divide-gray-200">
        <% brands.batches.each do |batch| %>
          <li class="flex items-center justify-between gap-3 py-2">
            <span class="min-w-0">
              <%= supply_batch_title(batch) %>
              <span class="block text-xs text-gray-600"><%= supply_batch_source(batch) %></span>
            </span>
            <span class="flex shrink-0 items-center gap-3 pb-1">
              <span class="font-extrabold"><%= supply_count(supply, batch.left) %></span>
              <% if writer && batch.purchase %><%= render "supplies/batch_used_one", supply:, batch: %><% end %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  <% elsif brands.several? %>
    <%# What is left of each brand, with its own −1; the item's count above is their total. A brand with
        several batches has the −1 on each batch instead %>
    <div class="rounded-xl border border-gray-300 bg-white/60 px-3 pt-2.5 pb-1">
      <h3 class="text-sm font-extrabold"><%= t("supplies.brands.title") %></h3>
      <ul class="divide-y divide-gray-200">
        <% brands.list.each do |brand| %>
          <li class="py-2">
            <div class="flex items-center justify-between gap-3">
              <span class="min-w-0">
                <%= supply_brand_title(brand) %>
                <span class="block text-xs text-gray-600"><%= supply_brand_source(brand, price: true, dates: !brand.several_batches?) %></span>
              </span>
              <span class="flex shrink-0 items-center gap-3 pb-1">
                <% if brand.left.positive? %>
                  <span class="text-right"><span class="font-extrabold"><%= supply_count(supply, brand.left) %></span>
                    <% if (inside = supply_brand_inside(supply, brand)) %><span class="block text-xs text-gray-600"><%= inside %></span><% end %></span>
                <% else %>
                  <span class="text-sm font-semibold text-gray-600"><%= t("supplies.brands.probably_used") %></span>
                <% end %>
                <% if writer && !brand.several_batches? %>
                  <%= button_to "−1", household_supply_counts_path(Current.household, supply), params: { used_one: 1, product: brand.key },
                        form: { data: { turbo_stream: true } }, "aria-label": t("supplies.brands.used_one_label", product: supply_brand_name(brand)),
                        class: "btn-press min-w-12 cursor-pointer rounded-xl bg-white px-3 py-1.5 text-sm font-bold text-gray-900" %>
                <% end %>
              </span>
            </div>
            <% if brand.several_batches? %>
              <ul class="mt-1.5 space-y-1 border-l-2 border-gray-200 pl-2.5 text-xs text-gray-700">
                <% brand.batches.each do |batch| %>
                  <li class="flex items-center justify-between gap-2">
                    <span class="min-w-0"><span class="<%= batch.first ? 'font-bold text-gray-900' : '' %>"><%= supply_expiry(batch.expires_on) %></span> · <%= supply_batch_source(batch, full: false) %></span>
                    <span class="flex shrink-0 items-center gap-2.5 pb-0.5">
                      <span class="text-sm font-extrabold text-gray-900"><%= number_with_delimiter(batch.left) %></span>
                      <% if writer && batch.purchase %><%= render "supplies/batch_used_one", supply:, batch:, small: true %><% end %>
                    </span>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <% if writer && brands.several? %>
    <%# One number per brand; the count saved is their sum. One line until it's tapped, and closed
        again once saved (the card is replaced), so several long brand names don't crowd the card %>
    <details class="group border-t border-gray-200 pt-1">
      <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
        <span class="text-sm font-bold"><%= t("supplies.show.inventory") %></span>
        <span class="text-sm text-gray-600"><%= t("supplies.show.open_count") %> <span class="inline-block group-open:rotate-180" aria-hidden="true">▾</span></span>
      </summary>
      <%= form_with url: household_supply_counts_path(Current.household, supply), data: { turbo_stream: true }, class: "space-y-2 pb-1" do |form| %>
        <% brands.list.each do |brand| %>
          <label class="flex items-center justify-between gap-3 text-sm">
            <span class="min-w-0 [overflow-wrap:anywhere]"><%= supply_brand_name(brand) %></span>
            <span class="inline-flex shrink-0 items-center gap-1.5">
              <%= hidden_field_tag "supply_count[brands][][name]", brand.key, id: nil %><%= number_field_tag "supply_count[brands][][left]", brand.left, min: 0, step: 1, required: true, inputmode: "numeric", id: nil, class: "w-16 rounded-md border border-gray-400 px-2 py-1" %>
              <%= t("supplies.units.#{supply.unit}_other") %>
            </span>
          </label>
        <% end %>
        <div class="flex justify-end pt-1 pb-1.5">
          <%= form.button t("supplies.show.update_count"), type: "submit", name: nil, class: "btn-press cursor-pointer rounded-xl bg-blue-200 px-3 py-1.5 text-sm font-bold text-gray-900" %>
        </div>
      <% end %>
    </details>
  <% elsif writer %>
    <%= form_with model: SupplyCount.new, url: household_supply_counts_path(Current.household, supply), data: { turbo_stream: true }, class: "flex flex-wrap items-center gap-2 border-t border-gray-200 pt-3" do |form| %>
      <%= form.label :level, t("supplies.show.counted"), class: "text-sm font-semibold" %>
      <span class="inline-flex items-center gap-1 text-sm">
        <%= form.number_field :level, min: 0, step: 1, required: true, inputmode: "numeric", class: "w-20 rounded-md border border-gray-400 px-2 py-1" %>
        <%= t("supplies.show.left_unit", unit: t("supplies.units.#{supply.unit}_other")) %></span>
      <%= form.button t("supplies.show.update_count"), type: "submit", name: nil, class: "btn-press cursor-pointer rounded-xl bg-blue-200 px-3 py-1.5 text-sm font-bold text-gray-900" %>
    <% end %>
  <% end %>
</section>
