<%# New item and Edit. The count is only asked for a new item; after that it changes through −1,
    "I have N left" and Bought more, so the forecast learns. From a scan, fields the lookup filled in
    are tinted green, and "I just bought these" logs the first purchase too %>
<% field = "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
<% scan = local_assigns[:scan] || {} %>
<% filled = ->(name) { scan[:filled].to_a.include?(name) ? "#{field} bg-green-50 border-green-700" : field } %>
<%# Category: the ledger's own (an archived one only while this item is still in it), then "＋ New
    category…", which shows a field for its name (new_category: what was typed, when the form comes back) %>
<% new_category = local_assigns[:new_category] %>
<% categories = Current.household.supply_categories.active.ordered.to_a %>
<% categories |= [ supply.category ] if supply.category&.persisted? %>
<%= form_with model: [ Current.household, supply ], class: "space-y-4", data: { turbo_frame: "_top" } do |form| %>
  <% if supply.errors.any? %>
    <ul class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><% supply.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  <% end %>
  <% if scan[:barcode] %>
    <%= hidden_field_tag :barcode, scan[:barcode] %>
    <% if scan[:not_found] %><%= hidden_field_tag :not_found, 1 %><% end %>
    <% scan[:filled].to_a.each do |name| %><%= hidden_field_tag "filled[]", name, id: nil %><% end %>
    <% if scan[:product_name].present? %><%= hidden_field_tag :product_name, scan[:product_name], id: nil %><% end %>
    <% if scan[:not_found] %>
      <%# No database knows it: a pop-up asks for the details, then the name field %>
      <% if supply.errors.empty? %><%= render "shared/notice", title: t("supplies.form.not_found_title"), body: t("supplies.form.not_found", code: scan[:barcode]), focus: "#supply_name" %><% end %>
      <p class="rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900"><%= t("supplies.form.not_found_short", code: scan[:barcode]) %></p>
    <% else %>
      <p class="rounded-lg bg-green-50 px-3 py-2 text-sm text-green-900"><%= t("supplies.form.found", code: scan[:barcode], source: t("supplies.sources.#{scan[:source].presence || 'unknown'}")) %></p>
    <% end %>
    <%# Another brand of something already tracked: add it to that item instead of making a second one %>
    <% if supply.new_record? && Current.household.supplies.active.exists? && SupplyBarcode.free?(Current.household, scan[:barcode]) %>
      <div class="flex flex-wrap items-center justify-between gap-2.5 rounded-xl border-2 border-sky-300 bg-sky-50 px-3 py-2.5">
        <p class="text-sm text-sky-900"><%= t("supplies.form.existing_question_html") %><span class="block text-xs"><%= t("supplies.form.existing_hint") %></span></p>
        <%= link_to restock_household_supplies_path(Current.household, barcode: scan[:barcode], product_name: scan[:product_name].presence), class: "btn-press inline-flex min-h-11 items-center gap-1 rounded-xl bg-sky-100 px-3 py-1.5 text-sm font-bold text-gray-900" do %>
          <%= t("supplies.form.existing_link") %>
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <div>
    <%= form.label :name, class: "block text-sm font-medium" %>
    <%= form.text_field :name, required: true, maxlength: 60, autofocus: supply.name.blank?, class: filled.("name") %>
    <% if scan[:original_name].present? %><p class="mt-1 text-xs text-gray-600"><%= t("supplies.form.original_name", name: scan[:original_name]) %></p><% end %>
  </div>
  <div class="space-y-4" data-controller="new-category">
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= form.label :supply_category_id, class: "block text-sm font-medium" %>
        <%= form.select :supply_category_id, categories.map { [ it.name, it.id ] } + [ [ t("supplies.form.new_category"), SuppliesController::NEW_CATEGORY ] ],
              { selected: new_category ? SuppliesController::NEW_CATEGORY : supply.supply_category_id }, class: filled.("kind"),
              data: { new_category_target: "select", action: "new-category#toggle" } %>
      </div>
      <div>
        <%= form.label :unit, class: "block text-sm font-medium" %>
        <%= form.select :unit, Supply::UNITS.map { [ t("supplies.units.#{it}_other"), it ] }, {}, class: filled.("unit") %>
      </div>
    </div>
    <div data-new-category-target="field" <%= "hidden" unless new_category %>>
      <%= label_tag :new_category_name, t("supplies.form.new_category_name"), class: "block text-sm font-medium" %>
      <%= text_field_tag :new_category_name, new_category, maxlength: 40, required: !new_category.nil?, class: field, data: { new_category_target: "input" } %>
      <p class="mt-1 text-xs text-gray-600"><%= t("supplies.form.new_category_hint") %></p>
    </div>
  </div>
  <% if supply.new_record? %>
    <div>
      <%= form.label :level, t("supplies.form.level"), class: "block text-sm font-medium" %>
      <%= form.number_field :level, min: 0, step: 1, required: true, inputmode: "numeric", class: field %>
    </div>
  <% end %>
  <%= render "supplies/purchase_fields", supply:, purchase: local_assigns[:purchase] || SupplyPurchase.new(purchased_on: Current.household.today) %>
  <div>
    <%= form.label :guess_days_per_unit, t("supplies.form.guess"), class: "block text-sm font-medium" %>
    <span class="flex items-center gap-2 text-sm"><%= t("supplies.form.guess_before") %>
      <%= form.number_field :guess_days_per_unit, min: 1, step: 1, inputmode: "numeric", class: "w-24 rounded-md border border-gray-400 px-3 py-2" %>
      <%= t("supplies.form.guess_after") %></span>
    <p class="mt-1 text-xs text-gray-600"><%= t("supplies.form.guess_hint") %></p>
  </div>
  <details class="rounded-xl border border-gray-300 p-3" <%= "open" if supply.errors[:lead_days].any? || supply.errors[:alert_when_left].any? %>>
    <summary class="cursor-pointer text-sm font-semibold"><%= t("supplies.form.more", lead: supply.lead_days, left: supply.alert_when_left) %></summary>
    <div class="mt-3 space-y-3">
      <div>
        <%= form.label :lead_days, t("supplies.form.lead_days"), class: "block text-sm font-medium" %>
        <%= form.number_field :lead_days, min: 0, max: 30, step: 1, inputmode: "numeric", class: "w-24 rounded-md border border-gray-400 px-3 py-2" %>
        <p class="mt-1 text-xs text-gray-600"><%= t("supplies.form.lead_days_hint") %></p>
      </div>
      <div>
        <%= form.label :alert_when_left, t("supplies.form.alert_when_left"), class: "block text-sm font-medium" %>
        <%= form.number_field :alert_when_left, min: 0, step: 1, inputmode: "numeric", class: "w-24 rounded-md border border-gray-400 px-3 py-2" %>
        <p class="mt-1 text-xs text-gray-600"><%= t("supplies.form.alert_when_left_hint") %></p>
      </div>
    </div>
  </details>
  <div class="flex flex-wrap items-center gap-3">
    <%= form.button type: "submit", name: nil, class: "btn-press inline-flex cursor-pointer items-center gap-1.5 rounded-xl bg-blue-200 px-3.5 py-2 font-medium text-gray-900" do %><%= image_tag "icons/save.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("records.form.save") %></span><% end %>
    <%= modal_cancel(supply.new_record? ? household_supplies_path(Current.household) : household_supply_path(Current.household, supply)) %>
  </div>
<% end %>
<% if supply.persisted? %>
  <%= button_to archive_household_supply_path(Current.household, supply), form: { data: { turbo_frame: "_top", turbo_confirm: (supply.archived_at ? nil : t("supplies.form.archive_confirm")) } },
        class: "btn-press mt-6 inline-flex cursor-pointer items-center gap-1.5 rounded-xl bg-white px-3.5 py-2 text-sm font-medium text-gray-900" do %>
    <%= image_tag "icons/archive.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= supply.archived_at ? t("supplies.form.restore") : t("supplies.form.archive") %></span>
  <% end %>
  <% unless supply.archived_at %><p class="mt-1 text-xs text-gray-600"><%= t("supplies.form.archive_hint") %></p><% end %>
  <%# Saved once per product? Combine moves this item into the one it really is, as a brand of it %>
  <div>
    <%= link_to t("supplies.form.combine"), new_household_supply_combine_path(Current.household, supply), data: { turbo_frame: "_top" },
          class: "btn-press mt-6 inline-flex cursor-pointer items-center gap-1.5 rounded-xl bg-white px-3.5 py-2 text-sm font-medium text-gray-900" %>
  </div>
  <p class="mt-1 text-xs text-gray-600"><%= t("supplies.form.combine_hint") %></p>
  <%# Delete is for good (Archive only hides), so it asks first and says what goes with the item %>
  <%= button_to household_supply_path(Current.household, supply), method: :delete,
        form: { data: { turbo_frame: "_top", turbo_confirm: t("supplies.form.delete_confirm", item: supply.name, purchases: t("supplies.form.delete_purchases", count: supply.purchases.size)) } },
        class: "btn-press mt-6 inline-flex cursor-pointer items-center gap-1.5 rounded-xl bg-red-100 px-3.5 py-2 text-sm font-medium text-red-800" do %>
    <%= image_tag "icons/delete.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("supplies.form.delete") %></span>
  <% end %>
  <p class="mt-1 text-xs text-gray-600"><%= t("supplies.form.delete_hint") %></p>
<% end %>
