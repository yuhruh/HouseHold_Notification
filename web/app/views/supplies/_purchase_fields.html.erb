<%# The purchase on the item forms (Supplies::PurchaseDetails). New item: "I already bought these",
    when, how many and the price, so with "how many now" the forecast has a usage rate from day one.
    Edit: the latest purchase to correct (its Ledger expense follows), or "Add what you paid" when
    there is none yet. With two or more to choose from (@choices: the latest of each product and every
    batch still in stock), they are listed first, with what is left of each (@left): choosing one
    reloads only this part (the supply_purchase frame) with it, and purchase_id says which one Save
    corrects %>
<% field = "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
<% editing = purchase.persisted? %>
<% choices = @choices if editing %>
<% title = if supply.new_record? then t("supplies.form.bought_title")
           elsif choices then t("supplies.form.correct_purchase_title", count: choices.size)
           elsif editing then t("supplies.form.last_purchase_title", date: l(purchase.purchased_on, format: :long))
           else t("supplies.form.add_purchase_title") end %>
<% open = @open_purchase || editing || params[:log_purchase] == "1" %>
<% section = capture do %>
<details class="rounded-xl border border-gray-300 p-3" <%= "open" if open %>>
  <summary class="cursor-pointer text-sm font-semibold"><%= title %></summary>
  <% if choices %>
    <%= hidden_field_tag :purchase_id, purchase.id, id: nil %>
    <div class="mt-3 space-y-1.5" role="group" aria-labelledby="supply-which-product">
      <p id="supply-which-product" class="text-sm font-bold"><%= t("supplies.form.which_product") %></p>
      <% choices.each do |choice| %>
        <% chosen = choice.id == purchase.id %>
        <% left = @left[choice.id].to_i %>
        <%= link_to edit_household_supply_path(Current.household, supply, purchase_id: choice.id), data: { turbo_frame: "supply_purchase" }, "aria-current": ("true" if chosen),
              class: "flex min-h-13 items-start gap-2.5 rounded-xl px-3 py-2 #{chosen ? 'border-2 border-blue-700 bg-blue-50' : 'border border-gray-400 bg-white'}" do %>
          <span aria-hidden="true" class="mt-0.5 inline-flex h-4.5 w-4.5 shrink-0 items-center justify-center rounded-full border-2 <%= chosen ? 'border-blue-700' : 'border-gray-500' %>"><% if chosen %><span class="h-2 w-2 rounded-full bg-blue-700"></span><% end %></span>
          <span class="min-w-0">
            <span class="block text-sm font-bold [overflow-wrap:anywhere]"><%= choice.product_name.presence || supply.name %></span>
            <span class="block text-xs text-gray-700"><%= safe_join([ (t("supplies.form.no_brand") if choice.product_name.blank?), l(choice.purchased_on, format: :short),
                                                                   supply_count(supply, choice.quantity), supply_cost(choice), choice.store.presence ].compact, " · ") %></span>
            <% if left.positive? %>
              <span class="block text-xs text-gray-700"><%= safe_join([ (supply_expiry(choice.expires_on) if choice.expires_on), t("supplies.brands.left", count: left) ].compact, " · ") %></span>
            <% end %>
          </span>
        <% end %>
      <% end %>
    </div>
    <p class="mt-3 border-t border-gray-200 pt-2 text-sm font-bold [overflow-wrap:anywhere]"><%= t("supplies.form.purchase_chosen_title", product: purchase.product_name.presence || supply.name, date: l(purchase.purchased_on, format: :long)) %></p>
  <% end %>
  <%# The price can be in another currency (supplies/_price_field): its panel opens under the price
      and the store. A new item's unit can still change, so the panel leaves the price per unit out %>
  <%= tag.div class: "mt-3 space-y-3", data: supply_paid_data(unit: (t("supplies.units.#{supply.unit}_one") unless supply.new_record?)) do %>
    <p class="text-xs text-gray-600"><%= supply.new_record? ? t("supplies.form.bought_hint") : editing ? t("supplies.form.last_purchase_hint") : t("supplies.form.add_purchase_hint") %></p>
    <%= fields_for :purchase, purchase do |p| %>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= p.label :purchased_on, t("supplies.form.bought_on"), class: "block text-sm font-medium" %>
          <%= p.date_field :purchased_on, max: Current.household.today, class: field, data: { paid_currency_target: "date", action: "change->paid-currency#refresh" } %>
        </div>
        <div>
          <%= p.label :quantity, t("supplies.form.bought_quantity"), class: "block text-sm font-medium" %>
          <%= p.number_field :quantity, min: 1, step: 1, inputmode: "numeric", class: field, data: { paid_currency_target: "quantity", action: "input->paid-currency#render" } %>
        </div>
        <%= render "supplies/price_field", form: p, record: purchase, label: t("supplies.purchases.form.total_price") %>
        <div class="col-span-2 has-[>[hidden]]:hidden"><%= render "supplies/pack_size_field", form: p, supply:, hidden: !supply.in_packs? %></div>
        <div>
          <%= p.label :store, t("supplies.purchases.form.store"), class: "block text-sm font-medium" %>
          <%= p.text_field :store, maxlength: 60, class: field %>
        </div>
        <div class="col-span-2 has-[>[hidden]]:hidden"><%= render "supplies/paid_panel", form: p, record: purchase %></div>
        <div class="col-span-2">
          <%= p.label :expires_on, t("supplies.purchases.form.expires_on"), class: "block text-sm font-medium" %>
          <%= p.date_field :expires_on, class: field %>
        </div>
        <% unless supply.new_record? %>
          <div class="col-span-2" data-controller="brand-name" data-brand-name-item-value="<%= supply.name %>">
            <%= p.label :product_name, t("supplies.purchases.form.product_name"), class: "block text-sm font-medium" %>
            <%= p.text_field :product_name, maxlength: Priced::PRODUCT_NAME_MAX, placeholder: supply.name, class: field,
                  data: { pack_size_target: "product", brand_name_target: "input", action: "input->pack-size#fill input->brand-name#check" } %>
            <%= render "supplies/product_is_item", supply:, value: purchase.product_name %>
            <p class="mt-1 text-xs text-gray-600"><%= t("supplies.form.product_name_hint") %></p>
          </div>
        <% end %>
      </div>
    <% end %>
    <% if purchase.record_id %>
      <p class="text-xs text-gray-600"><%= t("supplies.form.ledger_follows") %></p>
    <% else %>
      <label class="flex items-center gap-2 text-sm"><%= check_box_tag :add_to_ledger, "1", params[:add_to_ledger] == "1" %> <%= t("supplies.purchases.form.add_to_ledger") %></label>
    <% end %>
  <% end %>
</details>
<% end %>
<%= supply.persisted? ? turbo_frame_tag("supply_purchase") { section } : section %>
