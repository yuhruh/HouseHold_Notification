<%# One item in the list: a card on a phone, a table row from 1024px. Replaced in place after −1, then moved to its new place in the order (supplies-order).
    Under the name only its category, and Last bought is the store and price without the product's name.
    Several brands in stock: −1 opens its menu under the row, which says how many of each (the cards and
    the item's page show the numbers and the products too).
    Your star in front of the name, other people's (tags) after the category.
    An item with enough for now (OK) also says the day it moves to To Buy, under when it runs out.
    Details (the same button as the To Buy / Favorites cards) shows where to open the item; the name opens it too.
    On a phone Details, Used 1 and Restock are one size (44px tall, 14px text) and Details has no arrow, so the
    three fit on one line in English from 390px wide %>
<% status = forecast.status %>
<% last = supply.latest_purchase %>
<li id="<%= dom_id(supply, :row) %>" data-supplies-order-target="item" class="relative rounded-2xl border-2 border-(--card-line) p-3 <%= supply_tone(status, :card) %> lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,1.2fr)_minmax(0,1.8fr)_minmax(0,1.6fr)_22.5rem] lg:items-center lg:gap-4 lg:rounded-none lg:border-0 lg:border-b lg:px-4 lg:last:rounded-b-[0.875rem]">
  <div class="flex items-start gap-2.5 lg:items-center">
    <%= render "supplies/favorite", supply:, tags: false %>
    <div class="min-w-0 flex-1">
      <%= link_to supply.name, household_supply_path(Current.household, supply), class: "font-bold hover:underline" %>
      <p class="flex flex-wrap items-center gap-1.5 text-xs text-gray-600"><span><%= supply.category.name %></span><%= supply_star_tags(supply) %></p>
    </div>
    <span class="lg:hidden"><%= supply_badge(status) %></span>
  </div>
  <div class="mt-2 lg:mt-0">
    <p class="flex items-baseline justify-between gap-2"><span class="font-semibold"><%= supply_left_number(supply, forecast) %></span><%= supply_total(supply, forecast, unit: false) %></p>
    <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-gray-200" aria-hidden="true"><div class="h-full rounded-full <%= SuppliesHelper::BAR.fetch(status) %>" style="width: <%= forecast.fill_percent %>%"></div></div>
  </div>
  <div class="mt-2 lg:mt-0">
    <span class="hidden lg:inline"><%= supply_badge(status) %></span>
    <p class="text-sm <%= supply_line_class(forecast) %>"><%= supply_line(supply, forecast) %></p>
    <% if status == :ok && forecast.to_buy_on %><p class="text-sm text-gray-700"><%= t("supplies.card.moves_on", date: l(forecast.to_buy_on, format: :short)) %></p><% end %>
  </div>
  <p class="mt-1 text-xs text-gray-600 lg:mt-0"><%= last ? supply_parts([ last.store.presence, supply_price_line(last) ]) : t("supplies.index.no_purchase") %></p>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-2 lg:mt-0 lg:justify-end">
    <%= link_to household_supply_path(Current.household, supply), "aria-label": t("supplies.index.details_label", item: supply.name),
          class: "btn-press inline-flex min-h-11 items-center gap-1 rounded-xl bg-blue-200 px-3 py-2 text-sm font-medium text-gray-900 lg:min-h-0 lg:py-1.5" do %><%= image_tag("icons/details.png", alt: "", class: "h-5 w-5 object-contain") %><span><%= t("records.index.open") %></span><svg class="hidden h-5 w-5 lg:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg><% end %>
    <%= render "supplies/actions", supply:, forecast:, menu: :row %>
  </div>
</li>
