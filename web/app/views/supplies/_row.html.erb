<%# One item in the list: a card on a phone, a table row from 1024px. Replaced in place after −1 %>
<% status = forecast.status %>
<% last = supply.latest_purchase %>
<li id="<%= dom_id(supply, :row) %>" class="rounded-2xl border-2 border-(--card-line) p-3 <%= SuppliesHelper::CARD.fetch(status) %> lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,1.3fr)_minmax(0,2fr)_minmax(0,1.6fr)_auto] lg:items-center lg:gap-4 lg:rounded-none lg:border-0 lg:border-b lg:px-4">
  <div class="flex items-start justify-between gap-2 lg:block">
    <div class="min-w-0">
      <%= link_to supply.name, household_supply_path(Current.household, supply), class: "font-bold hover:underline" %>
      <p class="text-xs text-gray-600"><%= supply_kind(supply.kind) %></p>
    </div>
    <span class="lg:hidden"><%= supply_badge(status) %></span>
  </div>
  <div class="mt-2 lg:mt-0">
    <p class="font-semibold"><%= supply_left(supply, forecast) %></p>
    <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-gray-200" aria-hidden="true"><div class="h-full rounded-full <%= SuppliesHelper::BAR.fetch(status) %>" style="width: <%= forecast.fill_percent %>%"></div></div>
  </div>
  <div class="mt-2 lg:mt-0">
    <span class="hidden lg:inline"><%= supply_badge(status) %></span>
    <p class="text-sm <%= supply_line_class(forecast) %>"><%= supply_line(supply, forecast) %></p>
  </div>
  <p class="mt-1 text-xs text-gray-600 lg:mt-0"><%= last ? safe_join([ last.store.presence, supply_price_line(last) ].compact, " · ") : t("supplies.index.no_purchase") %></p>
  <div class="mt-3 flex justify-end lg:mt-0"><%= render "supplies/actions", supply:, forecast:, compact: true %></div>
</li>
