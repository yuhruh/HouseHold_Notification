<%# One item in the list: a card on a phone, a table row from 1024px. Replaced in place after −1.
    Details (the same button as the To Buy / Stocked cards) shows where to open the item; the name opens it too %>
<% status = forecast.status %>
<% last = supply.latest_purchase %>
<li id="<%= dom_id(supply, :row) %>" class="rounded-2xl border-2 border-(--card-line) p-3 <%= supply_tone(status, :card) %> lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,1.2fr)_minmax(0,1.8fr)_minmax(0,1.6fr)_18rem] lg:items-center lg:gap-4 lg:rounded-none lg:border-0 lg:border-b lg:px-4">
  <div class="flex items-start justify-between gap-2 lg:block">
    <div class="min-w-0">
      <%= link_to supply.name, household_supply_path(Current.household, supply), class: "font-bold hover:underline" %>
      <p class="text-xs text-gray-600"><%= supply_kind(supply.kind) %></p>
    </div>
    <span class="lg:hidden"><%= supply_badge(status) %></span>
  </div>
  <div class="mt-2 lg:mt-0">
    <p class="flex items-baseline justify-between gap-2"><span class="font-semibold"><%= supply_left(supply, forecast) %></span><%= supply_total(supply, forecast, unit: false) %></p>
    <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-gray-200" aria-hidden="true"><div class="h-full rounded-full <%= SuppliesHelper::BAR.fetch(status) %>" style="width: <%= forecast.fill_percent %>%"></div></div>
  </div>
  <div class="mt-2 lg:mt-0">
    <span class="hidden lg:inline"><%= supply_badge(status) %></span>
    <p class="text-sm <%= supply_line_class(forecast) %>"><%= supply_line(supply, forecast) %></p>
  </div>
  <p class="mt-1 text-xs text-gray-600 lg:mt-0"><%= last ? safe_join([ last.store.presence, supply_price_line(last) ].compact, " · ") : t("supplies.index.no_purchase") %></p>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-2 lg:mt-0 lg:justify-end">
    <%= link_to household_supply_path(Current.household, supply), "aria-label": t("supplies.index.details_label", item: supply.name),
          class: "btn-press inline-flex min-h-11 items-center gap-1 rounded-xl bg-blue-200 px-3.5 py-2 font-medium text-gray-900 lg:min-h-0 lg:px-3 lg:py-1.5 lg:text-sm" do %><%= image_tag("icons/details.png", alt: "", class: "h-5 w-5 object-contain") %><span><%= t("records.index.open") %></span><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg><% end %>
    <%= render "supplies/actions", supply:, forecast:, compact: true %>
  </div>
</li>
