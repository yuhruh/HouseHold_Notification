<%# Supplies: three views under the title, like Bills (records/_bills_switch): To Buy (opens first), Stocked
    and All, each with its count. A phone gets one full-width three-part switch (44px taps); from 640px
    they're tabs underlined in the view's colour: red To Buy, sky Stocked, dark All. Under the pointer a
    tab rounds its top corners and fills: the current one in its own tint, the others in grey %>
<% household = Current.household %>
<% tabs = [ [ "to_buy", household_supplies_path(household), counts[:to_buy], "bg-red-600 text-white", "bg-blue-100 text-blue-900 sm:border-red-600 sm:hover:bg-blue-50" ],
            [ "stocked", household_supplies_path(household, tab: "stocked"), counts[:stocked], "bg-sky-100 text-sky-900", "bg-sky-100 text-sky-900 sm:border-sky-700 sm:hover:bg-sky-50" ],
            [ "all", household_supplies_path(household, tab: "all"), counts[:all], "bg-gray-200 text-gray-800", "bg-gray-100 text-gray-900 sm:border-gray-800 sm:hover:bg-gray-50" ] ] %>
<div class="space-y-3">
  <%# No add button here: as on Bills, the header's New (tab bar's New on a phone) is the one place to add %>
  <%= page_title("ledger.png", t("supplies.index.title")) %>
  <nav aria-label="<%= t("supplies.switch.label") %>"
       class="grid grid-cols-3 gap-1 rounded-2xl border-2 border-(--card-line) bg-white p-1 sm:flex sm:gap-1 sm:rounded-none sm:border-0 sm:border-b-2 sm:border-gray-300 sm:bg-transparent sm:p-0">
    <% tabs.each do |view, path, count, badge, here_class| %>
      <% here = view == current %>
      <%= link_to path, class: "flex min-h-11 items-center justify-center gap-1.5 rounded-xl text-sm sm:-mb-0.5 sm:rounded-none sm:border-b-4 sm:px-5 sm:text-base sm:bg-transparent sm:hover:rounded-t-xl #{here ? "font-extrabold #{here_class}" : 'font-semibold text-gray-700 hover:bg-gray-50 sm:border-transparent'}", "aria-current": (here ? "page" : nil) do %>
        <span><%= t("supplies.switch.#{view}") %></span>
        <% if count.positive? %><span class="rounded-full px-1.5 text-[11px] font-bold sm:text-xs <%= badge %>"><%= count %></span><% end %>
      <% end %>
    <% end %>
  </nav>
</div>
