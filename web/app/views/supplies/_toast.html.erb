<%# After −1 or a count: what's left now, Undo (deletes that count) and, at the alert level, Bought more %>
<div data-controller="supply-toast" role="status" class="fixed inset-x-4 bottom-28 z-50 mx-auto flex max-w-md items-center gap-3 rounded-xl border-2 border-gray-800 bg-white p-3 shadow-[4px_4px_0_var(--color-gray-800)] min-[1550px]:bottom-4 min-[1550px]:right-4 min-[1550px]:left-auto <%= 'text-red-800' if local_assigns[:error] %>">
  <p class="min-w-0 flex-1 text-sm font-semibold"><%= text %></p>
  <% if count %>
    <%= button_to t("supplies.toast.undo"), household_supply_count_path(Current.household, count.supply, count), method: :delete,
          class: "btn-press cursor-pointer rounded-xl bg-white px-3 py-1.5 text-sm font-bold text-gray-900", form: { data: { turbo_stream: true } } %>
    <% if local_assigns[:restock] %>
      <%= link_to t("supplies.actions.bought_more"), new_household_supply_purchase_path(Current.household, count.supply), data: modal_link_data,
            class: "btn-press rounded-xl bg-green-100 px-3 py-1.5 text-sm font-bold text-green-900" %>
    <% end %>
  <% end %>
  <button type="button" data-action="supply-toast#dismiss" aria-label="<%= t("app_update.close") %>" class="h-9 w-9 shrink-0 cursor-pointer text-xl text-gray-600">×</button>
</div>
