<%# One line of "Which one did you use?" (supplies/actions): a brand, or one batch of a brand bought
    again before it ran out. `title` and `detail` say which; the −1 posts `choice` (product or batch) %>
<%= button_to household_supply_counts_path(Current.household, supply), params: { used_one: 1, **choice },
      form: { data: { turbo_stream: true } }, "aria-label": label,
      class: "btn-press flex min-h-13 w-full cursor-pointer items-center justify-between gap-3 rounded-xl bg-white px-3 py-1.5 text-left text-gray-900 [--press:3px]" do %>
  <span class="min-w-0">
    <%= title %>
    <span class="block text-xs text-gray-700"><%= detail %></span>
  </span>
  <span class="shrink-0 text-sm font-extrabold" aria-hidden="true">−1</span>
<% end %>
