<% content_for :title, t(".title") %>
<% writer = policy(Supply).create? %>
<% chip = "inline-flex min-h-9 items-center gap-1 rounded-full border-2 px-3 text-sm font-semibold" %>
<% card_list = "flex flex-col space-y-3 lg:space-y-2" %>
<div class="w-full space-y-6 py-4 lg:space-y-3">
  <% if @summary[:total].zero? && params[:archived].blank? %>
    <div class="flex items-center justify-between gap-3">
      <%= page_title("ledger.png", t(".title")) %>
    </div>
    <%= render "shared/flash" %>
    <div class="card-raised mx-auto max-w-md space-y-4 rounded-2xl bg-white p-6 text-center">
      <p class="text-lg font-bold"><%= t(".empty_title") %></p>
      <p class="text-gray-700"><%= t(".empty_body") %></p>
      <% if writer %>
        <%= render "supplies/add_menu", label: t(".add_first"), menu_class: "inline-block", align: :center %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/flash" %>
    <%# The title, tabs and intro stay pinned under the header while the items scroll under them, as on Bills.
        On All, as on Bills › All, a computer also pins the filters and the table's column headings (the
        top of the table card, so the rows scroll under it) and a phone scrolls the whole page %>
    <% pinned = @tab == "all" ? "space-y-3 lg:sticky lg:top-(--header-h) lg:z-20 lg:mb-0! lg:-mx-2 lg:bg-mauve-100 lg:px-2 lg:pt-2" : "sticky top-(--header-h) z-20 -mx-2 space-y-2 bg-mauve-100 px-2 py-3 lg:py-2" %>
    <div class="<%= pinned %>">
      <%= render "supplies/switch", current: @tab, counts: @counts %>
      <p class="text-sm text-gray-700"><%= t(".intro.#{@tab}") %></p>
      <% if @tab == "all" %>
        <div class="flex flex-wrap items-center gap-2">
          <nav aria-label="<%= t(".filters") %>" class="flex flex-wrap gap-2">
            <% [ [ nil, t(".all"), @summary[:total] ], [ "buy_soon", t(".buy_soon"), @summary[:buy_soon] ], [ "expiring", t(".expiring"), @summary[:expiring] ] ].each do |filter, label, count| %>
              <% here = @filter == filter && @kind.nil? && params[:archived].blank? %>
              <%= link_to household_supplies_path(Current.household, tab: "all", filter:), class: "#{chip} #{here ? 'border-blue-700 bg-blue-100 text-blue-900' : 'border-(--card-line) bg-white'}", "aria-current": (here ? "page" : nil) do %>
                <%= label %> <span class="font-extrabold"><%= count %></span>
              <% end %>
            <% end %>
            <% @kinds_in_use.each do |kind| %>
              <%= link_to supply_kind(kind), household_supplies_path(Current.household, kind:), class: "#{chip.sub('inline-flex ', '')} hidden lg:inline-flex #{@kind == kind ? 'border-blue-700 bg-blue-100 text-blue-900' : 'border-(--card-line) bg-white'}" %>
            <% end %>
          </nav>
          <p class="text-sm font-semibold text-gray-700 lg:ml-2"><%= t(".monthly") %> ~<%= money(@summary[:monthly].round, Current.household.default_currency) %></p>
          <%= form_with url: household_supplies_path(Current.household), method: :get, class: "ml-auto hidden lg:block" do |form| %>
            <%= form.hidden_field :tab, value: "all", id: nil %>
            <%= form.search_field :q, value: @query, placeholder: t(".search"), "aria-label": t(".search"), class: "w-64 rounded-xl border border-gray-400 px-3 py-1.5" %>
          <% end %>
        </div>
        <% if @items.any? %>
          <div aria-hidden="true" class="hidden grid-cols-[minmax(0,2fr)_minmax(0,1.2fr)_minmax(0,1.8fr)_minmax(0,1.6fr)_18rem] gap-4 rounded-t-2xl border-x-2 border-t-2 border-b-2 border-(--card-line) bg-gray-50 px-4 py-2 text-xs font-bold text-gray-700 shadow-[4px_0_0_var(--card-line)] lg:grid">
            <span><%= t(".col_item") %></span><span><%= t(".col_left") %></span><span><%= t(".col_status") %></span><span><%= t(".col_last") %></span><span></span>
          </div>
        <% end %>
      <% end %>
    </div>

    <% case @tab %>
    <% when "to_buy" %>
      <% if @next_up %>
        <%= link_to household_supplies_path(Current.household, tab: "stocked"), class: "flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-xl border-2 border-sky-300 bg-sky-50 px-4 py-2.5 text-sm font-semibold text-sky-900 hover:bg-sky-100 dark:bg-sky-50/60" do %>
          <span><%= t(".next_up", item: @next_up.first.name, date: l(@next_up.last.to_buy_on, format: :short)) %></span>
          <span class="whitespace-nowrap"><%= t(".see_stocked") %> ›</span>
        <% end %>
      <% end %>
      <% groups = @to_buy.select { |_, list| list.any? } %>
      <% if groups.empty? %>
        <p class="text-gray-600"><%= t(".nothing_to_buy") %></p>
      <% else %>
        <div class="grid items-start gap-6 lg:gap-4 <%= { 2 => "lg:grid-cols-2", 3 => "lg:grid-cols-2 xl:grid-cols-3" }[groups.size] %>">
          <% groups.each do |key, list| %>
            <section class="space-y-3 lg:space-y-2">
              <div>
                <h2 class="text-lg font-semibold <%= SuppliesHelper::TONE.fetch(key)[:ink] %>"><%= t(".groups.#{key}") %> (<%= list.size %>)</h2>
                <p class="text-sm text-gray-600"><%= t(".hints.#{key}") %></p>
              </div>
              <ul class="<%= card_list %>">
                <% list.each do |supply, forecast| %><%= render "supplies/card", supply:, forecast: %><% end %>
              </ul>
            </section>
          <% end %>
        </div>
      <% end %>

    <% when "stocked" %>
      <% if @stocked.empty? && @no_data.empty? %>
        <p class="text-gray-600"><%= t(".nothing_stocked") %></p>
      <% else %>
        <div class="grid items-start gap-6 lg:grid-cols-2 lg:gap-4 xl:grid-cols-3">
          <% @stocked.each do |month, list| %>
            <section class="space-y-3 lg:space-y-2">
              <h2 class="text-lg font-semibold"><%= month ? l(month, format: :supply_month) : t(".groups.later") %> (<%= list.size %>)</h2>
              <ul class="<%= card_list %>">
                <% list.each do |supply, forecast| %><%= render "supplies/card", supply:, forecast: %><% end %>
              </ul>
            </section>
          <% end %>
          <% if @no_data.any? %>
            <section class="space-y-3 lg:space-y-2">
              <div>
                <h2 class="text-lg font-semibold"><%= t(".groups.no_data") %> (<%= @no_data.size %>)</h2>
                <p class="text-sm text-gray-600"><%= t(".hints.no_data") %></p>
              </div>
              <ul class="<%= card_list %>">
                <% @no_data.each do |supply, forecast| %><%= render "supplies/card", supply:, forecast: %><% end %>
              </ul>
            </section>
          <% end %>
        </div>
      <% end %>

    <% else %>
      <% if @items.empty? %>
        <p class="rounded-2xl border-2 border-dashed border-gray-300 p-6 text-center text-gray-600"><%= t(".none_match") %></p>
      <% else %>
        <div class="lg:card-raised lg:overflow-hidden lg:rounded-b-2xl lg:border-t-0! lg:bg-white">
          <ul class="space-y-3 lg:space-y-0">
            <% @items.each do |supply, forecast| %>
              <%= render "supplies/row", supply:, forecast: %>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <p class="text-center text-sm">
    <% if params[:archived].present? %>
      <%= link_to t(".back_to_list"), household_supplies_path(Current.household, tab: "all"), class: "text-blue-700 hover:underline" %>
    <% elsif @archived_count.positive? && (@tab == "all" || @summary[:total].zero?) %>
      <%= link_to t(".archived", count: @archived_count), household_supplies_path(Current.household, archived: 1), class: "text-blue-700 hover:underline" %>
    <% end %>
  </p>
  <div id="supply_toast"></div>
</div>
