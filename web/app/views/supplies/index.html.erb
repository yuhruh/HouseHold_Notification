<% content_for :title, t(".title") %>
<% writer = policy(Supply).create? %>
<% card_list = "flex flex-col space-y-3 lg:space-y-2" %>
<%# To Buy and Favorites: their groups or cards one under another in one column at every width, as wide as an item's page %>
<% column = "mx-auto w-full max-w-3xl" %>
<%# supplies-order: after Used 1 or Undo the list is fetched again and morphed, so the item moves to its place without a refresh %>
<div id="supplies_list" data-controller="supplies-order" data-action="turbo:submit-end->supplies-order#changed" class="w-full space-y-6 py-4 lg:space-y-3">
  <% if @summary[:total].zero? && params[:archived].blank? %>
    <div class="flex items-center justify-between gap-3">
      <%= page_title("ledger.png", t(".title")) %>
    </div>
    <%= render "shared/flash" %>
    <div class="card-raised mx-auto max-w-md space-y-4 rounded-2xl bg-white p-6 text-center">
      <p class="text-lg font-bold"><%= t(".empty_title") %></p>
      <p class="text-gray-700"><%= t(".empty_body") %></p>
      <% if writer %>
        <%= render "supplies/add_menu", label: t(".add_first"), menu_class: "inline-block", align: :center %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/flash" %>
    <%# The title, tabs and intro stay pinned under the header while the items scroll under them, as on Bills.
        On All, as on Bills › All, a computer also pins the filters and the table's column headings (the
        top of the table card, so the rows scroll under it) and a phone scrolls the whole page %>
    <% pinned = @tab == "all" ? "space-y-3 lg:sticky lg:top-(--header-h) lg:z-20 lg:mb-0! lg:-mx-2 lg:bg-mauve-100 lg:px-2 lg:pt-2" : "sticky top-(--header-h) z-20 -mx-2 space-y-2 bg-mauve-100 px-2 py-3 lg:py-2" %>
    <div class="<%= pinned %>">
      <%= render "supplies/switch", current: @tab, counts: @counts %>
      <% whose = @tab == "favorites" && @supply_starrers.several? %>
      <p class="text-sm text-gray-700"><%= t(whose ? ".intro.favorites_whose" : ".intro.#{@tab}") %></p>
      <% if whose && @counts[:favorites].positive? %>
        <%# Whose stars: everyone's, or one person's. Each person's chip has their colour, so the row is also the key %>
        <nav aria-label="<%= t(".starred_by") %>" class="flex flex-wrap items-center gap-2">
          <span aria-hidden="true" class="text-sm font-semibold text-gray-700"><%= t(".starred_by") %></span>
          <%= supply_star_chip(t(".everyone"), household_supplies_path(Current.household, tab: "favorites"), count: @counts[:favorites], count_id: "supplies_starred_count_all", chosen: @by.nil?) %>
          <% @star_counts.each do |person, count| %>
            <% me = person.user == Current.user %>
            <% next unless count.positive? || me || person == @by %>
            <%= supply_star_chip(me ? t(".me") : person.name, household_supplies_path(Current.household, tab: "favorites", by: person.user.id), count:, count_id: "supplies_starred_count_#{person.user.id}", chosen: person == @by, person:) %>
          <% end %>
        </nav>
      <% end %>
      <% if @tab == "all" %>
        <%# The filters are switches, any number at once; each link keeps the others (and the search) and flips its own %>
        <% view = ->(categories: @chosen, expiring: @expiring) { household_supplies_path(Current.household, { tab: "all", filter: ("expiring" if expiring), category: categories.map(&:id).presence, q: @query.presence }.compact) } %>
        <div class="space-y-2.5">
          <nav aria-label="<%= t(".filters") %>" class="flex flex-wrap items-center gap-2">
            <span aria-hidden="true" class="text-sm font-semibold text-gray-700"><%= t(".filters") %></span>
            <% if @summary[:expiring].positive? || @expiring %>
              <%= supply_filter_chip(t(".expiring"), view.(expiring: !@expiring), chosen: @expiring, count: @summary[:expiring]) %>
            <% end %>
            <% @categories_in_use.each do |category| %>
              <% chosen = @chosen.include?(category) %>
              <%= supply_filter_chip(category.name, view.(categories: (chosen ? @chosen - [ category ] : @chosen + [ category ]).sort_by { [ it.position, it.id ] }), chosen:) %>
            <% end %>
          </nav>
          <%# Under the chips: Edit categories (the ledger's own categories are added, renamed and archived in Settings), then
              what the list adds up to or how much of it is showing, and on a computer the search at the right %>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <% if policy(SupplyCategory).write? %>
              <%= link_to nav_label("edit.png", t(".edit_categories")), household_categories_path(Current.household, anchor: "supplies"), class: "btn-press press-sm inline-flex min-h-11 items-center gap-1.5 rounded-xl bg-white px-3 text-sm font-bold text-gray-900 lg:min-h-9" %>
            <% end %>
            <% if @narrowed %>
              <p class="flex w-full items-center gap-3 text-sm font-semibold text-gray-700 lg:w-auto">
                <span><%= t(".showing", shown: @items.size, total: @summary[:total]) %></span>
                <%= link_to t(".clear_all"), household_supplies_path(Current.household, tab: "all"), class: "inline-flex min-h-9 items-center text-blue-700 hover:underline" %>
              </p>
            <% else %>
              <p class="w-full text-sm font-semibold text-gray-700 lg:w-auto"><%= t(".monthly") %> ~<%= money(@summary[:monthly].round, Current.household.default_currency) %></p>
            <% end %>
            <%= form_with url: household_supplies_path(Current.household), method: :get, class: "ml-auto hidden lg:block" do |form| %>
              <%= form.hidden_field :tab, value: "all", id: nil %>
              <% if @expiring %><%= form.hidden_field :filter, value: "expiring", id: nil %><% end %>
              <% @chosen.each do |category| %><%= hidden_field_tag "category[]", category.id, id: nil %><% end %>
              <%= form.search_field :q, value: @query, placeholder: t(".search"), "aria-label": t(".search"), class: "w-72 rounded-xl border border-gray-400 px-3 py-1.5" %>
            <% end %>
          </div>
        </div>
        <% if @items.any? %>
          <div aria-hidden="true" class="hidden grid-cols-[minmax(0,2fr)_minmax(0,1.2fr)_minmax(0,1.8fr)_minmax(0,1.6fr)_22.5rem] gap-4 rounded-t-2xl border-x-2 border-t-2 border-b-2 border-(--card-line) bg-gray-50 px-4 py-2 text-xs font-bold text-gray-700 shadow-[4px_0_0_var(--card-line)] lg:grid">
            <span><%= t(".col_item") %></span><span><%= t(".col_left") %></span><span><%= t(".col_status") %></span><span><%= t(".col_last") %></span><span></span>
          </div>
        <% end %>
      <% end %>
    </div>

    <% case @tab %>
    <% when "to_buy" %>
      <% if @next_up %>
        <%# The item with enough for now that moves here first. The line opens All, where every such item says its date %>
        <%= link_to household_supplies_path(Current.household, tab: "all"), class: "#{column} flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-xl border-2 border-sky-300 bg-sky-50 px-4 py-2.5 text-sm font-semibold text-sky-900 hover:bg-sky-100 dark:bg-sky-50/60" do %>
          <span><%= t(".next_up", item: @next_up.first.name, date: l(@next_up.last.to_buy_on, format: :short)) %></span>
          <span class="whitespace-nowrap"><%= t(".see_all") %> ›</span>
        <% end %>
      <% end %>
      <% groups = @to_buy.select { |_, list| list.any? } %>
      <% if groups.empty? %>
        <p class="<%= column %> text-gray-600"><%= t(".nothing_to_buy") %></p>
      <% else %>
        <div class="<%= column %> flex flex-col gap-6">
          <% groups.each do |key, list| %>
            <section class="space-y-3 lg:space-y-2">
              <div>
                <h2 class="text-lg font-semibold <%= SuppliesHelper::TONE.fetch(key)[:ink] %>"><%= t(".groups.#{key}") %> (<%= list.size %>)</h2>
                <p class="text-sm text-gray-600"><%= t(".hints.#{key}") %></p>
              </div>
              <ul class="<%= card_list %>">
                <% list.each do |supply, forecast| %><%= render "supplies/card", supply:, forecast: %><% end %>
              </ul>
            </section>
          <% end %>
        </div>
      <% end %>

    <% when "favorites" %>
      <% if @favorites.empty? %>
        <p class="<%= column %> text-gray-600"><%= if @by.nil? then t(writer ? ".no_favorites" : ".no_favorites_viewer")
                                                    elsif @by.user == Current.user then t(".no_favorites_mine")
                                                    else t(".no_favorites_by", name: @by.name)
                                                    end %></p>
      <% else %>
        <ul class="<%= column %> <%= card_list %>">
          <% @favorites.each do |supply, forecast| %><%= render "supplies/card", supply:, forecast: %><% end %>
        </ul>
      <% end %>

    <% else %>
      <% if @items.empty? %>
        <p class="rounded-2xl border-2 border-dashed border-gray-300 p-6 text-center text-gray-600"><%= t(".none_match") %></p>
      <% else %>
        <%# Not clipped: a row's "Which one did you use?" menu hangs below it; the last row rounds its own corners %>
        <div class="lg:card-raised lg:rounded-b-2xl lg:border-t-0! lg:bg-white">
          <ul class="space-y-3 lg:space-y-0">
            <% @items.each do |supply, forecast| %>
              <%= render "supplies/row", supply:, forecast: %>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <p class="text-center text-sm">
    <% if params[:archived].present? %>
      <%= link_to t(".back_to_list"), household_supplies_path(Current.household, tab: "all"), class: "text-blue-700 hover:underline" %>
    <% elsif @archived_count.positive? && (@tab == "all" || @summary[:total].zero?) %>
      <%= link_to t(".archived", count: @archived_count), household_supplies_path(Current.household, archived: 1), class: "text-blue-700 hover:underline" %>
    <% end %>
  </p>
  <div id="supply_toast"></div>
</div>
