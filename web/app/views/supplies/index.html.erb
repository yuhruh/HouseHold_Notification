<% content_for :title, t(".title") %>
<% writer = policy(Supply).create? %>
<% chip = "inline-flex min-h-9 items-center gap-1 rounded-full border-2 px-3 text-sm font-semibold" %>
<div class="w-full space-y-5 py-4">
  <div class="flex items-center justify-between gap-3">
    <%= page_title("ledger.png", t(".title")) %>
    <% if writer %>
      <%= render "supplies/add_menu", label: t(".add"), menu_class: "hidden lg:block", align: :right %>
    <% end %>
  </div>
  <%= render "shared/flash" %>

  <% if @summary[:total].zero? && params[:archived].blank? %>
    <div class="card-raised mx-auto max-w-md space-y-4 rounded-2xl bg-white p-6 text-center">
      <p class="text-lg font-bold"><%= t(".empty_title") %></p>
      <p class="text-gray-700"><%= t(".empty_body") %></p>
      <% if writer %>
        <%= render "supplies/add_menu", label: t(".add_first"), menu_class: "inline-block", align: :center %>
      <% end %>
    </div>
  <% else %>
    <div class="grid grid-cols-3 gap-2 lg:gap-4">
      <%= link_to household_supplies_path(Current.household, filter: "buy_soon"), class: "rounded-2xl border-2 border-(--card-line) bg-red-50 p-3" do %>
        <span class="block text-xs font-semibold text-red-800"><%= t(".buy_soon") %></span><span class="text-2xl font-extrabold text-red-800"><%= @summary[:buy_soon] %></span>
      <% end %>
      <%= link_to household_supplies_path(Current.household, filter: "expiring"), class: "rounded-2xl border-2 border-(--card-line) bg-orange-50 p-3" do %>
        <span class="block text-xs font-semibold text-orange-800"><%= t(".expiring") %></span><span class="text-2xl font-extrabold text-orange-800"><%= @summary[:expiring] %></span>
      <% end %>
      <div class="rounded-2xl border-2 border-(--card-line) bg-white p-3">
        <span class="block text-xs font-semibold text-gray-700"><%= t(".monthly") %></span><span class="text-lg font-extrabold lg:text-2xl">~<%= money(@summary[:monthly].round, Current.household.default_currency) %></span>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <nav aria-label="<%= t(".filters") %>" class="flex flex-wrap gap-2">
        <% [ [ nil, t(".all"), @summary[:total] ], [ "buy_soon", t(".buy_soon"), @summary[:buy_soon] ], [ "expiring", t(".expiring"), @summary[:expiring] ] ].each do |filter, label, count| %>
          <% here = @filter == filter && @kind.nil? && params[:archived].blank? %>
          <%= link_to household_supplies_path(Current.household, filter:), class: "#{chip} #{here ? 'border-blue-700 bg-blue-100 text-blue-900' : 'border-(--card-line) bg-white'}", "aria-current": (here ? "page" : nil) do %>
            <%= label %> <span class="font-extrabold"><%= count %></span>
          <% end %>
        <% end %>
        <% @kinds_in_use.each do |kind| %>
          <%= link_to supply_kind(kind), household_supplies_path(Current.household, kind:), class: "#{chip.sub('inline-flex ', '')} hidden lg:inline-flex #{@kind == kind ? 'border-blue-700 bg-blue-100 text-blue-900' : 'border-(--card-line) bg-white'}" %>
        <% end %>
      </nav>
      <%= form_with url: household_supplies_path(Current.household), method: :get, class: "ml-auto hidden lg:block" do |form| %>
        <%= form.search_field :q, value: @query, placeholder: t(".search"), "aria-label": t(".search"), class: "w-64 rounded-xl border border-gray-400 px-3 py-1.5" %>
      <% end %>
    </div>

    <% if @items.empty? %>
      <p class="rounded-2xl border-2 border-dashed border-gray-300 p-6 text-center text-gray-600"><%= t(".none_match") %></p>
    <% else %>
      <div class="lg:card-raised lg:overflow-hidden lg:rounded-2xl lg:bg-white">
        <div class="hidden grid-cols-[minmax(0,2fr)_minmax(0,1.3fr)_minmax(0,2fr)_minmax(0,1.6fr)_auto] gap-4 border-b-2 border-(--card-line) bg-gray-50 px-4 py-2 text-xs font-bold text-gray-700 lg:grid">
          <span><%= t(".col_item") %></span><span><%= t(".col_left") %></span><span><%= t(".col_status") %></span><span><%= t(".col_last") %></span><span class="sr-only"><%= t(".col_actions") %></span>
        </div>
        <ul class="space-y-3 lg:space-y-0">
          <% @items.each do |supply, forecast| %>
            <%= render "supplies/row", supply:, forecast: %>
          <% end %>
        </ul>
      </div>
    <% end %>

  <% end %>
  <p class="text-center text-sm">
    <% if params[:archived].present? %>
      <%= link_to t(".back_to_list"), household_supplies_path(Current.household), class: "text-blue-700 hover:underline" %>
    <% elsif @archived_count.positive? %>
      <%= link_to t(".archived", count: @archived_count), household_supplies_path(Current.household, archived: 1), class: "text-blue-700 hover:underline" %>
    <% end %>
  </p>
  <div id="supply_toast"></div>
</div>
