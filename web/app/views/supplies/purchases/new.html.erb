<% content_for :title, t(".title", item: @supply.name) %>
<% field = "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
<% stores = Current.household.supply_purchases.where.not(store: nil).distinct.order(:store).pluck(:store) %>
<% products = (@supply.purchases.map(&:product_name) + @supply.prices.map(&:product_name) + @supply.barcodes.map(&:product_name)).compact.uniq.sort %>
<%= render layout: "shared/modal_or_page", locals: { title: t(".title", item: @supply.name), icon: "expense.png" } do %>
  <%= form_with model: @purchase, url: household_supply_purchases_path(Current.household, @supply), class: "space-y-4",
        data: { turbo_frame: "_top", **supply_paid_data(unit: t("supplies.units.#{@supply.unit}_one")), **supply_pack_data(@supply, prefilled: @pack_prefilled),
                controller: "paid-currency pack-size" } do |form| %>
    <% if @purchase.errors.any? %>
      <ul class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><% @purchase.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    <% end %>
    <%# One item can be several brands: the product this purchase was, for comparing prices. A scan
        fills it in and, for a barcode no item has yet, saving remembers the barcode for this item %>
    <% if @barcode %><%= hidden_field_tag :barcode, @barcode, id: nil %><% end %>
    <% if @barcode && @link %>
      <p class="rounded-lg bg-sky-50 px-3 py-2 text-sm text-sky-900"><%= t("supplies.purchases.form.barcode_note_html", code: @barcode, item: @supply.name) %></p>
    <% end %>
    <div data-controller="brand-name" data-brand-name-item-value="<%= @supply.name %>">
      <%= form.label :product_name, t("supplies.purchases.form.product_name"), class: "block text-sm font-medium" %>
      <%= form.text_field :product_name, maxlength: Priced::PRODUCT_NAME_MAX, list: "supply-products", placeholder: @supply.name, class: (@scanned_name ? "#{field} border-green-700 bg-green-50" : field),
            data: { pack_size_target: "product", brand_name_target: "input", action: "input->pack-size#fill input->brand-name#check" } %>
      <%= render "supplies/product_is_item", supply: @supply, value: @purchase.product_name %>
      <datalist id="supply-products"><% products.each do |product| %><option value="<%= product %>"></option><% end %></datalist>
      <p class="mt-1 text-xs text-gray-600"><%= t(@scanned_name ? "supplies.purchases.form.product_name_scanned" : "supplies.purchases.form.product_name_hint", item: @supply.name) %></p>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= form.label :quantity, t("supplies.purchases.form.quantity", unit: t("supplies.units.#{@supply.unit}_other")), class: "block text-sm font-medium" %>
        <%= form.number_field :quantity, min: 1, step: 1, required: true, inputmode: "numeric", class: field, data: { paid_currency_target: "quantity", action: "input->paid-currency#render" } %>
      </div>
      <%= render "supplies/price_field", form:, record: @purchase, label: t("supplies.purchases.form.total_price"), required: true %>
    </div>
    <% if @supply.in_packs? %><%= render "supplies/pack_size_field", form:, supply: @supply %><% end %>
    <%= render "supplies/paid_panel", form:, record: @purchase %>
    <p class="text-xs text-gray-600"><%= t("supplies.purchases.form.unit_price_hint") %></p>
    <div>
      <%= form.label :store, t("supplies.purchases.form.store"), class: "block text-sm font-medium" %>
      <%= form.text_field :store, maxlength: 60, list: "supply-stores", class: field %>
      <datalist id="supply-stores"><% stores.each do |store| %><option value="<%= store %>"></option><% end %></datalist>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= form.label :purchased_on, t("supplies.purchases.form.purchased_on"), class: "block text-sm font-medium" %>
        <%= form.date_field :purchased_on, required: true, max: Current.household.today, class: field, data: { paid_currency_target: "date", action: "change->paid-currency#refresh" } %>
      </div>
      <div>
        <%= form.label :expires_on, t("supplies.purchases.form.expires_on"), class: "block text-sm font-medium" %>
        <%= form.date_field :expires_on, class: field %>
      </div>
    </div>
    <% if @use_first %>
      <%# Some still left with a date: so this one's date gets entered too, and the item page can say which to use first %>
      <% product = @use_first.purchase&.product_name.presence %>
      <p class="-mt-2 rounded-lg bg-sky-50 px-3 py-2 text-sm text-sky-900"><%= t(product ? "supplies.purchases.form.still_left_product_html" : "supplies.purchases.form.still_left_html",
                                                                            amount: supply_count(@supply, @use_first.left), product:, date: supply_expiry(@use_first.expires_on)) %></p>
    <% end %>
    <div>
      <%= form.label :left_before, t("supplies.purchases.form.left_before"), class: "block text-sm font-medium" %>
      <%= form.number_field :left_before, min: 0, step: 1, required: true, inputmode: "numeric", class: "w-24 rounded-md border border-gray-400 px-3 py-2" %>
      <p class="mt-1 text-xs text-gray-600"><%= t("supplies.purchases.form.left_before_hint") %></p>
    </div>
    <label class="flex items-start gap-2 text-sm"><%= check_box_tag :add_to_ledger, "1", params[:add_to_ledger] == "1", class: "mt-1" %>
      <span><%= t("supplies.purchases.form.add_to_ledger") %><span class="block text-xs text-gray-600"><%= t("supplies.purchases.form.add_to_ledger_hint", category: Supplies::LedgerRecord::CATEGORY[I18n.locale.to_s == "en" ? :name_en : :name_zh]) %></span></span></label>
    <div class="flex flex-wrap items-center gap-3">
      <%= form.button type: "submit", name: nil, class: "btn-press inline-flex cursor-pointer items-center gap-1.5 rounded-xl bg-blue-200 px-3.5 py-2 font-medium text-gray-900" do %><%= image_tag "icons/save.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("records.form.save") %></span><% end %>
      <%= modal_cancel(household_supply_path(Current.household, @supply)) %>
    </div>
  <% end %>
<% end %>
