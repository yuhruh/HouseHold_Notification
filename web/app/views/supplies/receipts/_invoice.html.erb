<%# One invoice on Review items: its store (named once, remembered by tax ID), date, total and number,
    then a row per item: name, quantity (editable), unit price, subtotal, and what it is. A :ok invoice
    has Exclude this invoice (and, once excluded, Not a supplies store); a folded one under Not included
    shows the same rows inside. Field names: invoices[key][…]. Shown again after a refused Save, every
    field has what was posted, and a line still on "Choose…" (undecided: [key, line index]) is in red.
    Under each line, why it was matched (remembered, an item's name, one of its brands). "Add as new
    supply…" opens the New supply box under it (receipt-line), whose Category can be "＋ New category…"
    (new-category, as on Add Item): its name is typed there and it's made on Save %>
<% receipt = entry.receipt %>
<% currency = Current.household.default_currency %>
<% base = "invoices[#{entry.key}]" %>
<% posted = @batch.posted_for(entry) %>
<% undecided = local_assigns[:undecided] || Set.new %>
<% first_undecided = undecided.min_by { |key, index| [ key.to_i, index ] } %>
<% tags = { remembered: "bg-green-100 text-green-800", suggested: "bg-blue-100 text-blue-800", skipped: "bg-gray-100 text-gray-700",
            fee: "bg-gray-100 text-gray-700", not_found: "bg-amber-100 text-amber-900", brand: "bg-green-100 text-green-800" } %>
<%# Add to: the household's supplies under their category (the same ones as the item form), empty ones left out %>
<% groups = supplies.group_by(&:category).sort_by { |category, _| [ category.position, category.id ] }.map { |category, list| [ category.name, list.map { [ it.name, it.id.to_s ] } ] } %>
<% cols = "lg:grid lg:grid-cols-[minmax(0,2.2fr)_5rem_6rem_6rem_minmax(0,2.4fr)] lg:items-start lg:gap-3" %>
<section id="invoice_<%= entry.key %>" class="group card-raised overflow-hidden rounded-2xl bg-white has-[.receipt-exclude:checked]:opacity-60" aria-labelledby="invoice_<%= entry.key %>_title">
  <div class="flex flex-wrap items-end justify-between gap-3 border-b border-gray-200 bg-gray-50 px-4 py-3">
    <div class="min-w-0 space-y-1">
      <h2 id="invoice_<%= entry.key %>_title" class="sr-only"><%= entry.store.presence || receipt.invoice_no %></h2>
      <label class="block text-xs font-semibold text-gray-600" for="invoice_<%= entry.key %>_store"><%= t(".store") %></label>
      <%= text_field_tag "#{base}[store]", posted.fetch("store", entry.store), id: "invoice_#{entry.key}_store", maxlength: 60, list: "receipt-stores",
            class: "w-56 rounded-md border border-gray-400 px-2 py-1 font-bold" %>
      <p class="text-sm text-gray-700"><%= safe_join([ l(receipt.issued_on, format: :long), money(receipt.total, currency), receipt.invoice_no, entry.file.presence ].compact, " · ") %></p>
      <% if receipt.seller_tax_id && entry.store.blank? %><p class="text-xs text-gray-600"><%= t(".store_once", tax_id: receipt.seller_tax_id) %></p><% end %>
    </div>
    <% if entry.status == :ok %>
      <div class="flex flex-col items-end gap-1.5">
        <label class="btn-press inline-flex cursor-pointer items-center gap-2 rounded-xl bg-white px-3 py-1.5 text-sm font-medium text-gray-900">
          <%= check_box_tag "#{base}[exclude]", "1", posted["exclude"] == "1", id: "invoice_#{entry.key}_exclude", class: "receipt-exclude" %> <%= t(".exclude") %>
        </label>
        <% if receipt.seller_tax_id %>
          <label class="hidden items-center gap-2 text-sm text-gray-700 group-has-[.receipt-exclude:checked]:inline-flex">
            <%= check_box_tag "#{base}[skip_store]", "1", posted["skip_store"] == "1", id: "invoice_#{entry.key}_skip_store" %> <%= t(".not_supplies_store") %>
          </label>
        <% end %>
      </div>
    <% end %>
  </div>

  <div aria-hidden="true" class="hidden <%= cols %> border-b border-gray-200 px-4 py-1.5 text-xs font-bold text-gray-600">
    <span><%= t(".col_item") %></span><span><%= t(".col_qty") %></span><span class="text-right"><%= t(".col_price") %></span><span class="text-right"><%= t(".col_subtotal") %></span><span><%= t(".col_add_to") %></span>
  </div>
  <ul class="divide-y divide-gray-200">
    <% entry.rows.each do |row| %>
      <% name = "#{base}[lines][#{row.index}]" %>
      <% id = "invoice_#{entry.key}_line_#{row.index}" %>
      <% line = posted.dig("lines", row.index.to_s).to_h.stringify_keys %>
      <% choice = @batch.posted ? line["choice"].to_s : row.choice %>
      <% missing = undecided.include?([ entry.key, row.index ]) %>
      <% tag = row.tag || (:not_found if row.choice.blank?) %>
      <% why = case row.tag
               when :remembered then t(".why.remembered", store: entry.store.presence || t(".this_store"), item: row.supply.name)
               when :suggested then t(".why.suggested", item: row.matched)
               when :brand then t(".why.brand", item: row.supply.name, brand: row.matched)
               when nil then t(".why.not_found") if row.choice.blank?
               end %>
      <% adding = choice == "new" %>
      <% new_category = line["supply_category_id"] == Supplies::ImportReceipt::NEW_CATEGORY %>
      <% unnamed = missing && adding && new_category %><%# refused: "＋ New category…" with no name %>
      <li class="space-y-2 px-4 py-3 <%= cols %> lg:space-y-0 <%= "bg-red-50" if missing %>" data-controller="receipt-line">
        <p class="font-semibold"><%= row.item.text %></p>
        <label class="flex items-center gap-2 text-sm lg:block">
          <span class="lg:sr-only"><%= t(".col_qty") %></span>
          <%= number_field_tag "#{name}[quantity]", line.fetch("quantity", [ row.item.quantity.round, 1 ].max), id: "#{id}_quantity", min: 1, step: 1, class: "w-16 rounded-md border border-gray-400 px-2 py-1" %>
        </label>
        <p class="text-sm lg:text-right"><span class="text-gray-600 lg:sr-only"><%= t(".col_price") %> </span><%= money(row.item.unit_price, currency, exact: true) %></p>
        <p class="text-sm font-semibold lg:text-right"><span class="font-normal text-gray-600 lg:sr-only"><%= t(".col_subtotal") %> </span><%= money(row.item.amount, currency) %></p>
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-2">
            <label class="sr-only" for="<%= id %>_choice"><%= t(".is") %></label>
            <%= select_tag "#{name}[choice]", safe_join([ options_for_select([ [ t(".choose"), "" ] ], choice), grouped_options_for_select(groups, choice),
                                                          content_tag(:optgroup, options_for_select([ [ t(".add_new"), "new" ], [ t(".skip"), "skip" ] ], choice), label: "—") ]),
                  id: "#{id}_choice", autofocus: first_undecided == [ entry.key, row.index ] && !unnamed,
                  "aria-invalid": (true if missing && !unnamed), "aria-describedby": ("#{id}_missing" if missing && !unnamed),
                  data: { receipt_line_target: "choice", action: "receipt-line#toggle" },
                  class: "min-w-0 flex-1 rounded-md px-2 py-1.5 #{missing && !unnamed ? 'border-2 border-red-700 bg-white' : 'border border-gray-400'}" %>
            <% if tag %><span class="rounded-full px-2 py-0.5 text-xs font-bold whitespace-nowrap <%= tags[tag] %>"><%= t(".tags.#{tag}") %></span><% end %>
          </div>
          <% if missing && !unnamed %><p id="<%= id %>_missing" class="text-sm font-bold text-red-700"><%= t(".choose_or_skip") %></p><% end %>
          <% if why %><p class="text-xs text-gray-700 [overflow-wrap:anywhere]"><%= why %></p><% end %>
          <label class="flex items-center gap-1 text-sm text-gray-700">× <%= number_field_tag "#{name}[units_per_line]", line.fetch("units_per_line", row.units_per_line), id: "#{id}_units", min: 1, step: 1, class: "w-16 rounded-md border border-gray-400 px-2 py-1" %> <%= t(".units_each") %></label>
          <%# Shown only for "Add as new supply…"; hidden, its fields are left out of Save (receipt-line) %>
          <div class="space-y-2 rounded-xl border-2 border-dashed border-blue-400 bg-blue-50 p-3 text-sm" data-receipt-line-target="box" <%= "hidden" unless adding %>>
            <p class="font-bold text-blue-900"><%= t(".new_supply") %></p>
            <div>
              <%= label_tag "#{id}_name", t(".new_name"), class: "block text-xs font-semibold" %>
              <%= text_field_tag "#{name}[name]", line.fetch("name", row.item.text.truncate(60, omission: "")), id: "#{id}_name", maxlength: 60,
                    class: "w-full rounded-md border border-gray-400 bg-white px-2 py-1", data: { receipt_line_target: "name" } %>
            </div>
            <div class="space-y-2" data-controller="new-category">
              <div class="grid grid-cols-3 gap-2">
                <div class="col-span-2">
                  <%= label_tag "#{id}_kind", t(".new_kind"), class: "block text-xs font-semibold" %>
                  <%= select_tag "#{name}[supply_category_id]", options_for_select(categories.map { [ it.name, it.id.to_s ] } + [ [ t("supplies.form.new_category"), Supplies::ImportReceipt::NEW_CATEGORY ] ],
                                                                                 line["supply_category_id"].presence || categories.find(&:fallback?)&.id.to_s),
                        id: "#{id}_kind", class: "w-full rounded-md border border-gray-400 bg-white px-2 py-1", data: { new_category_target: "select", action: "new-category#toggle" } %>
                </div>
                <div>
                  <%= label_tag "#{id}_unit", t(".new_unit"), class: "block text-xs font-semibold" %>
                  <%= select_tag "#{name}[unit]", options_for_select(Supply::UNITS.map { [ t("supplies.units.#{it}_other"), it ] }, line["unit"].presence || "piece"), id: "#{id}_unit", class: "w-full rounded-md border border-gray-400 bg-white px-2 py-1" %>
                </div>
              </div>
              <div data-new-category-target="field" <%= "hidden" unless new_category %>>
                <%= label_tag "#{id}_new_category", t("supplies.form.new_category_name"), class: "block text-xs font-semibold" %>
                <%= text_field_tag "#{name}[new_category_name]", line["new_category_name"], id: "#{id}_new_category", maxlength: 40, required: adding && new_category,
                      autofocus: (unnamed if first_undecided == [ entry.key, row.index ]), "aria-invalid": (true if unnamed), "aria-describedby": ("#{id}_missing" if unnamed),
                      class: "w-full rounded-md bg-white px-2 py-1 #{unnamed ? 'border-2 border-red-700' : 'border border-gray-400'}", data: { new_category_target: "input" } %>
                <% if unnamed %><p id="<%= id %>_missing" class="mt-1 font-bold text-red-700"><%= t("supplies.form.new_category_blank") %></p><% end %>
                <p class="mt-1 text-xs text-gray-600"><%= t("supplies.form.new_category_hint") %></p>
              </div>
            </div>
            <p class="text-xs text-gray-600"><%= t(".new_supply_hint") %></p>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
</section>
