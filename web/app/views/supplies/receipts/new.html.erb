<% content_for :title, t(".title") %>
<% field = "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
<% tags = { remembered: "bg-green-100 text-green-800", suggested: "bg-blue-100 text-blue-800", skipped: "bg-gray-100 text-gray-700" } %>
<div class="mx-auto w-full max-w-2xl space-y-5 py-4">
  <%= page_title("import.png", t(".title")) %>
  <%= form_with url: receipt_household_supplies_path(Current.household), method: :post, class: "space-y-5" do |form| %>
    <%= hidden_field_tag :left, @codes[0] %>
    <%= hidden_field_tag :right, @codes[1] %>
    <div class="card-raised grid grid-cols-2 gap-3 rounded-2xl bg-white p-4 text-sm">
      <div class="col-span-2">
        <%= label_tag :store, t(".store"), class: "block font-medium" %>
        <%= text_field_tag :store, @store, maxlength: 60, list: "receipt-stores", required: true, class: field %>
        <datalist id="receipt-stores"><% @stores.each do |store| %><option value="<%= store %>"></option><% end %></datalist>
        <% if @receipt.seller_tax_id && @store.blank? %><p class="mt-1 text-xs text-gray-600"><%= t(".store_once", tax_id: @receipt.seller_tax_id) %></p><% end %>
      </div>
      <p><span class="block text-gray-600"><%= t(".date") %></span><span class="font-semibold"><%= l(@receipt.issued_on, format: :long) %></span></p>
      <p><span class="block text-gray-600"><%= t(".invoice_no") %></span><span class="font-semibold"><%= @receipt.invoice_no %></span></p>
      <p class="col-span-2"><span class="block text-gray-600"><%= t(".total") %></span><span class="text-xl font-extrabold"><%= money(@receipt.total, Current.household.default_currency) %></span></p>
    </div>

    <% if @rows.empty? %>
      <p class="rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900"><%= t(".no_items") %></p>
    <% else %>
      <ul class="space-y-3">
        <% @rows.each do |row| %>
          <% name = "lines[#{row.index}]" %>
          <li class="space-y-2 rounded-2xl border-2 border-(--card-line) bg-white p-3">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="font-semibold"><%= row.item.text %></span>
              <span class="text-sm text-gray-700"><%= t(".line", quantity: row.item.quantity.to_s("F").delete_suffix(".0"), amount: money(row.item.amount, Current.household.default_currency)) %></span>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <% if row.tag %><span class="rounded-full px-2 py-0.5 text-xs font-bold <%= tags[row.tag] %>"><%= t(".tags.#{row.tag}") %></span><% end %>
              <label class="sr-only" for="line_<%= row.index %>_choice"><%= t(".is") %></label>
              <%= select_tag "#{name}[choice]", options_for_select([ [ t(".choose"), "" ] ] + @supplies.map { [ it.name, it.id.to_s ] } + [ [ t(".add_new"), "new" ], [ t(".skip"), "skip" ] ], row.choice),
                    id: "line_#{row.index}_choice", class: "min-w-0 flex-1 rounded-md border border-gray-400 px-2 py-1.5" %>
              <label class="flex items-center gap-1 text-sm">× <%= number_field_tag "#{name}[units_per_line]", row.units_per_line, min: 1, step: 1, class: "w-16 rounded-md border border-gray-400 px-2 py-1" %> <%= t(".units_each") %></label>
            </div>
            <details class="text-sm">
              <summary class="cursor-pointer text-gray-700"><%= t(".new_details") %></summary>
              <div class="mt-2 grid grid-cols-3 gap-2">
                <%= text_field_tag "#{name}[name]", row.item.text.truncate(60, omission: ""), maxlength: 60, "aria-label": t(".new_name"), class: "col-span-3 rounded-md border border-gray-400 px-2 py-1" %>
                <%= select_tag "#{name}[kind]", options_for_select(Supply::KINDS.map { [ supply_kind(it), it ] }, "other"), "aria-label": t(".new_kind"), class: "col-span-2 rounded-md border border-gray-400 px-2 py-1" %>
                <%= select_tag "#{name}[unit]", options_for_select(Supply::UNITS.map { [ t("supplies.units.#{it}_other"), it ] }, "piece"), "aria-label": t(".new_unit"), class: "rounded-md border border-gray-400 px-2 py-1" %>
              </div>
            </details>
          </li>
        <% end %>
      </ul>
      <p class="text-xs text-gray-600"><%= t(".hint") %></p>
    <% end %>

    <label class="flex items-start gap-2 text-sm"><%= check_box_tag :add_to_ledger, "1", false, class: "mt-1" %>
      <span><%= t(".add_to_ledger", total: money(@receipt.total, Current.household.default_currency)) %></span></label>
    <div class="flex flex-wrap items-center gap-3">
      <%= form.button type: "submit", name: nil, class: "btn-press inline-flex cursor-pointer items-center gap-1.5 rounded-xl bg-blue-200 px-3.5 py-2 font-medium text-gray-900" do %><%= image_tag "icons/save.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t(".save") %></span><% end %>
      <%= cancel_link(scan_household_supplies_path(Current.household, mode: "receipt")) %>
    </div>
  <% end %>
</div>
