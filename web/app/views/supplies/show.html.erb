<% content_for :title, @supply.name %>
<div class="mx-auto w-full max-w-3xl space-y-5 py-4">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h1 class="text-3xl font-bold"><%= @supply.name %></h1>
      <p class="text-sm text-gray-600"><%= t("supplies.show.subtitle", unit: t("supplies.units.#{@supply.unit}_one"), kind: @supply.category.name) %><% if @supply.archived_at %> · <%= t("supplies.show.archived") %><% end %></p>
    </div>
    <%# Your own star (Favorite) and Edit; under them, whose other stars the item has %>
    <div class="flex shrink-0 flex-col items-end gap-2">
      <div class="flex flex-wrap items-center justify-end gap-2.5">
        <div id="<%= dom_id(@supply, :favorite) %>"><%= render "supplies/favorite", supply: @supply, full: true %></div>
        <% if policy(@supply).edit? %>
          <%= link_to nav_label("edit.png", t("supplies.actions.edit")), edit_household_supply_path(Current.household, @supply), data: modal_link_data,
                class: "btn-press inline-flex shrink-0 items-center gap-1.5 rounded-xl bg-white px-3.5 py-2 font-medium text-gray-900" %>
        <% end %>
      </div>
      <div id="<%= dom_id(@supply, :starred_by) %>"><%= supply_starred_by(@supply) %></div>
    </div>
  </div>
  <%= render "shared/flash" %>
  <%= render "supplies/forecast", supply: @supply, forecast: @forecast %>

  <details class="card-raised rounded-2xl bg-white">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 [&::-webkit-details-marker]:hidden">
      <span class="font-bold"><%= t("supplies.show.where_to_buy") %></span>
      <span class="min-w-0 truncate text-sm text-gray-600"><%= @stores.any? ? t("supplies.show.cheapest_at", store: @stores.first[:store], prices: supply_unit_prices(@stores.first[:best])) : t("supplies.show.no_purchases") %> ▾</span>
    </summary>
    <% if @stores.any? %>
      <ul class="divide-y divide-gray-200 border-t border-gray-200 px-4">
        <% @stores.each_with_index do |store, index| %>
          <li class="flex flex-wrap items-baseline justify-between gap-2 py-2 text-sm">
            <span><span class="font-semibold"><%= store[:store] %></span><% if index.zero? && @stores.size > 1 %> <span class="ml-1 rounded-full bg-green-100 px-2 py-0.5 text-xs font-bold text-green-800">★ <%= t("supplies.show.cheapest") %></span><% end %><% if store[:best].product_name %><span class="block text-xs text-gray-600"><%= store[:best].product_name %></span><% end %></span>
            <span><%= supply_price_line(store[:best]) %> <span class="text-gray-600">(<%= t("supplies.show.times", count: store[:times]) %>)</span></span>
          </li>
        <% end %>
        <li class="py-2 text-sm font-semibold"><%= supply_spending(@supply) %></li>
      </ul>
    <% end %>
  </details>

  <%= render "supplies/history", supply: @supply, history: @history %>
  <%= render "supplies/price_history", supply: @supply, price_history: @price_history %>
  <div id="supply_toast"></div>
</div>
