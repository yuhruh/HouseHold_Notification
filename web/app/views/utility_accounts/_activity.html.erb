<%# A utility account's recent activity, newest first, folded behind › until opened. `scope` is the
    page's locale scope (its activity, no_activity, open_bill and lines.<kind> keys) %>
<% household = Current.household %>
<% if account.activity.empty? %>
  <div class="space-y-1">
    <h3 class="font-semibold"><%= t("#{scope}.activity") %></h3>
    <p class="text-sm text-gray-600"><%= t("#{scope}.no_activity") %></p>
  </div>
<% else %>
  <details class="group">
    <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 [&::-webkit-details-marker]:hidden">
      <svg aria-hidden="true" class="h-4 w-4 shrink-0 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
      <h3 class="font-semibold"><%= t("#{scope}.activity") %></h3>
      <span class="rounded-full bg-gray-200 px-2 py-0.5 text-xs font-semibold text-gray-800"><%= account.activity.size %></span>
      <span class="ml-auto text-sm text-gray-600"><%= t("utility_accounts.activity.latest", time: l(Time.zone.parse(account.activity.first["at"]), format: :short)) %></span>
    </summary>
    <% records = household.records.where(id: account.activity.flat_map { [ it["record_id"], *it["record_ids"] ] }.compact).index_by(&:id) %>
    <ul class="mt-2 divide-y rounded-lg border text-sm">
      <% account.activity.each do |line| %>
        <li class="px-3 py-2 <%= 'bg-amber-50' if line["kind"].in?(%w[amount_differs needs_a_look ignored unreadable]) %>">
          <% detail = line["reason"] ? t("utilities.forwarded_mail.#{line["reason"]}", detail: line["detail"]) : line["detail"] %>
          <%= t("#{scope}.lines.#{line["kind"]}", period: line["period"], amount: line["amount"], recorded: line["recorded"], due: line["due_on"], detail:) %>
          <% Array(line["record_id"] || line["record_ids"]).filter_map { records[it] }.each do |record| %>
            <%= link_to t("#{scope}.open_bill"), household_record_path(household, record), class: "text-blue-700 underline" %>
          <% end %>
          <span class="block text-gray-500"><%= l(Time.zone.parse(line["at"]), format: :short) %></span>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>
