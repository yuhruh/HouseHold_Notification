<%# Ledger settings › Electricity / › Water (ForwardedBillsPage): status, the shared "Set up forwarding"
    steps and the bill settings. `s` is the utility's own locale scope, `f` the shared one. %>
<% account = @account %>
<% kind = account.model_name.singular.delete_suffix("_account") %>
<% s = "#{account.model_name.plural}.show" %>
<% f = "utility_accounts.forwarding" %>
<% icon = { "electricity" => "electricity.png", "water" => "water.svg" }.fetch(kind) %>
<% filter = { "electricity" => "from:taipower.com.tw", "water" => "from:water.gov.tw" }.fetch(kind) %>
<% inbox = account.inbox if account.persisted? %>
<% page_path = public_send("household_#{account.model_name.singular}_path", Current.household) %>
<% content_for :title, t("#{s}.title") %>
<% household = Current.household %>
<% owner = policy(account).manage? %>
<% field = "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600 disabled:bg-gray-100 disabled:text-gray-700" %>
<% button = "btn-press inline-flex items-center justify-center gap-1.5 rounded-xl text-gray-900 cursor-pointer px-3.5 py-2 font-medium" %>
<% pill = "inline-block rounded-full px-2.5 py-0.5 text-xs font-bold" %>
<% pill_color = { good: "bg-green-100 text-green-800", todo: "bg-amber-100 text-amber-900", idle: "bg-gray-200 text-gray-800" } %>
<% today = Time.current.in_time_zone(household.time_zone).to_date %>
<% content_for :settings_section do %>
<div class="w-full mx-auto max-w-5xl space-y-5 py-4">
  <%= render "shared/flash" %>
  <%= page_title(icon, t("#{s}.title")) %>
  <% if account.errors.any? %>
    <ul class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><% account.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  <% end %>

  <%# Bill settings: on its own until Electricity is turned on, then in the right-hand column %>
  <% bill_settings = capture do %>
    <section class="card-raised-sm space-y-4 rounded-xl bg-white p-4" aria-labelledby="utility-settings">
      <h2 id="utility-settings" class="text-lg font-semibold"><%= t("#{f}.bill_settings_title") %></h2>
      <%= form_with model: account, url: page_path, method: :patch, class: "space-y-4" do |form| %>
        <fieldset class="space-y-4" <%= "disabled" unless owner %>>
          <div class="space-y-1">
            <%= form.label :customer_code, class: "block text-sm font-medium" do %><%= account.class.human_attribute_name(:customer_code) %> <span class="font-normal text-gray-600"><%= t("#{f}.optional") %></span><% end %>
            <%= form.text_field :customer_code, inputmode: "numeric", autocomplete: "off", maxlength: 14, class: field %>
            <p class="text-sm text-gray-600"><%= t("#{s}.customer_code_hint") %></p>
          </div>
          <div class="space-y-1">
            <%= form.label :category_id, class: "block text-sm font-medium" %>
            <%= form.collection_select :category_id, household.categories.active.where(record_type: "expense").ordered, :id, :name, { prompt: account.category ? nil : t("#{f}.choose") }, required: true, class: field %>
          </div>
          <div class="space-y-1">
            <%= form.label :payment_method_id, class: "block text-sm font-medium" %>
            <%= form.collection_select :payment_method_id, household.payment_methods.active.order(:name), :id, :name, { include_blank: t("#{f}.no_payment_method") }, class: field %>
            <p class="text-sm text-gray-600"><%= t("#{f}.payment_method_hint") %></p>
          </div>
          <% if owner %>
            <%= form.button type: "submit", name: nil, class: "#{button} bg-blue-200" do %><%= image_tag "icons/save.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= account.persisted? ? t("#{f}.save") : t("#{f}.turn_on") %></span><% end %>
          <% end %>
        </fieldset>
      <% end %>
      <% if owner && account.persisted? %>
        <div class="border-t pt-4">
          <%= button_to page_path, method: :delete, form: { data: { turbo_confirm: t("#{s}.disconnect_confirm") } }, class: "#{button} bg-white text-red-700" do %><%= image_tag "icons/disconnect.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("#{f}.disconnect") %></span><% end %>
        </div>
      <% elsif !owner %>
        <p class="rounded-lg bg-gray-100 px-3 py-2 text-sm text-gray-700"><%= t("#{f}.owner_only") %></p>
      <% end %>
    </section>
  <% end %>

  <% if account.new_record? %>
    <p class="text-gray-700"><%= t("#{s}.intro") %></p>
    <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2">
      <%= bill_settings %>
      <section class="card-raised-sm space-y-3 rounded-xl bg-white p-4" aria-labelledby="utility-how">
        <h2 id="utility-how" class="text-lg font-semibold"><%= t("#{f}.how_title") %></h2>
        <ul class="list-disc space-y-1 pl-5 text-sm text-gray-700">
          <% t("#{s}.how").each do |line| %><li><%= line %></li><% end %>
        </ul>
        <p class="rounded-lg bg-blue-50 px-3 py-2 text-sm text-blue-900"><%= owner ? t("#{f}.turn_on_hint") : t("#{f}.not_on_yet") %></p>
      </section>
    </div>
  <% else %>
    <% state = account.connected? ? :working : (inbox&.pending_confirmation? ? :confirm : :waiting) %>
    <% late = account.missing_mail_expected_on(today) %>
    <% address = inbox&.address %>

    <section class="card-raised-sm flex flex-wrap items-center gap-x-8 gap-y-3 rounded-xl p-4 <%= state == :working ? 'bg-green-50' : 'bg-amber-50' %>" aria-labelledby="utility-status">
      <div class="min-w-0 flex-[1_1_20rem] space-y-1">
        <h2 id="utility-status" class="flex items-center gap-2 text-lg font-bold">
          <span class="h-3 w-3 shrink-0 rounded-full <%= state == :working ? 'bg-green-600' : 'bg-amber-500' %>" aria-hidden="true"></span>
          <%= t("#{s}.status.#{state}") %>
        </h2>
        <p class="text-sm text-gray-700"><%= t("#{s}.status.#{state}_hint") %></p>
      </div>
      <dl class="grid grid-cols-3 gap-x-6 gap-y-0.5 text-sm">
        <dt class="text-gray-600"><%= account.class.human_attribute_name(:customer_code) %></dt>
        <dt class="text-gray-600"><%= t("#{s}.last_bill") %></dt>
        <dt class="text-gray-600"><%= t("#{f}.next_email") %></dt>
        <dd class="font-semibold"><%= account.masked_code || t("#{s}.from_first_email") %></dd>
        <dd class="font-semibold"><%= account.last_bill_on ? t("#{f}.issued", date: l(account.last_bill_on)) : t("#{f}.not_yet") %></dd>
        <dd class="font-semibold <%= 'text-amber-800' if late %>"><%= t("#{f}.around", date: l(account.next_mail_expected_on)) %><%= " · #{t("#{f}.late")}" if late %></dd>
      </dl>
    </section>

    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-5">
      <section id="forwarding-setup" class="card-raised-sm space-y-1 rounded-xl bg-white p-4 lg:col-span-3" aria-labelledby="forwarding-setup-title">
        <h2 id="forwarding-setup-title" class="pb-2 text-lg font-semibold"><%= t("#{f}.setup_title") %></h2>
        <% if address %>
          <ol class="divide-y border-t">
            <%# 1. Send the setup email %>
            <% forwarders = inbox.forwarders %>
            <% sent = forwarders.count(&:setup_sent_at) %>
            <li class="flex gap-3 py-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-700 font-bold text-white" aria-hidden="true">1</span>
              <div class="min-w-0 flex-1 space-y-3">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <h3 class="font-semibold"><%= t("#{s}.step1.title") %></h3>
                  <span class="<%= pill %> <%= pill_color[sent.positive? || state == :working ? :good : :todo] %>"><%= t("#{f}.step1.pill", sent:, total: forwarders.size) %></span>
                </div>
                <p class="text-sm text-gray-600"><%= t("#{f}.step1.hint") %></p>
                <ul class="divide-y rounded-lg border">
                  <% forwarders.each do |person| %>
                    <li class="flex flex-wrap items-center gap-x-3 gap-y-2 px-3 py-2.5">
                      <div class="min-w-0 flex-[1_1_14rem]">
                        <p class="break-all font-medium"><%= person.email %> <span class="text-xs font-semibold text-gray-600">· <%= t("#{f}.roles.#{person.role}") %></span></p>
                        <p class="text-sm <%= person.setup_sent_at ? 'text-gray-600' : 'text-amber-800' %>"><%= person.setup_sent_at ? t("#{f}.sent_at", time: l(person.setup_sent_at, format: :short)) : t("#{f}.not_sent") %></p>
                      </div>
                      <% if owner %>
                        <%= button_to setup_email_household_forwarding_inbox_path(household), params: { email: person.email, from: kind }, class: "#{button} bg-blue-100 text-sm" do %><%= image_tag "icons/email.png", alt: "", class: "h-4 w-4 object-contain" %><span><%= person.setup_sent_at ? t("#{f}.resend") : t("#{f}.send") %></span><% end %>
                        <% if person.added? %>
                          <%= button_to forwarder_household_forwarding_inbox_path(household), method: :delete, params: { email: person.email, from: kind }, form: { data: { turbo_confirm: t("#{f}.remove_confirm", email: person.email) } }, class: "#{button} bg-white px-2.5", "aria-label": t("#{f}.remove", email: person.email) do %><%= image_tag "icons/delete.png", alt: "", class: "h-5 w-5 object-contain" %><% end %>
                        <% end %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
                <% if owner %>
                  <%= form_with url: forwarder_household_forwarding_inbox_path(household), method: :post, class: "space-y-1" do |form| %>
                    <%= hidden_field_tag :from, kind %>
                    <%= form.label :email, t("#{f}.add_label"), for: "add-forwarder", class: "block text-sm font-medium" %>
                    <div class="flex flex-wrap gap-2">
                      <%= form.email_field :email, id: "add-forwarder", required: true, autocomplete: "off", placeholder: t("#{f}.add_placeholder"), class: "#{field} min-w-0 flex-[1_1_14rem] w-auto" %>
                      <%= form.button type: "submit", name: nil, class: "#{button} bg-blue-200" do %><%= image_tag "icons/add.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("#{f}.add_button") %></span><% end %>
                    </div>
                    <p class="text-sm text-gray-600"><%= t("#{f}.add_hint") %></p>
                  <% end %>
                <% else %>
                  <p class="rounded-lg bg-gray-100 px-3 py-2 text-sm text-gray-700"><%= t("#{f}.setup_owner_only") %></p>
                <% end %>
                <details class="group text-sm">
                  <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 font-medium text-gray-800 [&::-webkit-details-marker]:hidden">
                    <svg aria-hidden="true" class="h-4 w-4 shrink-0 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                    <%= t("#{f}.yourself") %>
                  </summary>
                  <div class="space-y-3 pt-2">
                    <div class="space-y-1">
                      <label for="forwarding-address" class="block text-sm font-medium"><%= t("#{f}.forward_to") %></label>
                      <div class="flex gap-2" data-controller="clipboard" data-clipboard-text-value="<%= address %>" data-clipboard-done-value="<%= t("#{f}.copied") %>">
                        <input id="forwarding-address" type="text" value="<%= address %>" readonly class="<%= field %> min-w-0 flex-1 text-sm">
                        <button type="button" data-action="clipboard#copy" class="<%= button %> shrink-0 bg-blue-100"><span data-clipboard-target="label"><%= t("#{f}.copy") %></span></button>
                      </div>
                    </div>
                    <ol class="space-y-2">
                      <% t("#{f}.steps", filter:).each_with_index do |step, i| %>
                        <li class="flex items-start gap-2"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gray-700 text-xs font-bold text-white"><%= i + 1 %></span><span><%= step %></span></li>
                      <% end %>
                    </ol>
                  </div>
                </details>
              </div>
            </li>

            <%# 2. Confirm Gmail's request %>
            <% pending = inbox.pending_confirmation? %>
            <% confirmed = !pending && inbox.confirmed? %>
            <li class="flex gap-3 py-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-700 font-bold text-white" aria-hidden="true">2</span>
              <div class="min-w-0 flex-1 space-y-3">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <h3 class="font-semibold"><%= t("#{f}.step2.title") %></h3>
                  <span class="<%= pill %> <%= pill_color[pending ? :todo : (confirmed ? :good : :idle)] %>"><%= t("#{f}.step2.#{pending ? "your_turn" : (confirmed ? "confirmed" : "nothing")}") %></span>
                </div>
                <% if pending %>
                  <div class="space-y-2 rounded-xl border-2 border-(--card-line) bg-blue-50 p-3" aria-labelledby="forwarding-confirm">
                    <h4 id="forwarding-confirm" class="font-semibold"><%= t("#{f}.confirm_title") %></h4>
                    <p class="text-sm text-gray-700 break-words"><%= t("#{f}.confirm_from", email: inbox.forwarding_from, time: l(inbox.forwarding_code_at, format: :short)) %></p>
                    <% if inbox.forwarding_link.present? %>
                      <%= link_to inbox.forwarding_link, target: "_blank", rel: "noopener noreferrer", class: "#{button} bg-green-100" do %><%= image_tag "icons/paid.png", alt: "", class: "h-5 w-5 object-contain" %><span><%= t("#{f}.confirm_button") %></span><% end %>
                      <p class="text-sm text-gray-700"><%= t("#{f}.confirm_next") %></p>
                    <% else %>
                      <div class="flex flex-wrap items-center gap-2" data-controller="clipboard" data-clipboard-text-value="<%= inbox.forwarding_code %>" data-clipboard-done-value="<%= t("#{f}.copied") %>">
                        <output class="rounded-xl border-2 border-(--card-line) bg-white px-3 py-1 text-3xl font-extrabold tracking-widest tabular-nums"><%= inbox.forwarding_code %></output>
                        <button type="button" data-action="clipboard#copy" class="<%= button %> bg-blue-100"><span data-clipboard-target="label"><%= t("#{f}.copy") %></span></button>
                      </div>
                      <p class="text-sm text-gray-700"><%= t("#{f}.code_next") %></p>
                    <% end %>
                  </div>
                <% end %>
                <p class="text-sm text-gray-600"><%= t("#{f}.step2.#{confirmed ? "confirmed_hint" : "hint"}") %></p>
              </div>
            </li>

            <%# 3. The filter forwards 台電's emails %>
            <li class="flex gap-3 pt-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-700 font-bold text-white" aria-hidden="true">3</span>
              <div class="min-w-0 flex-1 space-y-2">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <h3 class="font-semibold"><%= t("#{s}.step3.title") %></h3>
                  <% if late %>
                    <span class="<%= pill %> <%= pill_color[:todo] %>"><%= t("#{f}.step3.late", date: l(late)) %></span>
                  <% elsif state == :working %>
                    <span class="<%= pill %> <%= pill_color[:good] %>"><%= t("#{f}.step3.working", time: l(account.last_success_at, format: :short)) %></span>
                  <% else %>
                    <span class="<%= pill %> <%= pill_color[:idle] %>"><%= t("#{f}.step3.waiting", date: l(account.next_mail_expected_on)) %></span>
                  <% end %>
                </div>
                <p class="text-sm text-gray-600"><%= t("#{s}.step3.hint") %></p>
              </div>
            </li>
          </ol>
        <% else %>
          <p class="rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900"><%= t("#{f}.no_mailbox") %></p>
        <% end %>
      </section>

      <div class="space-y-6 lg:col-span-2">
        <%= bill_settings %>
        <section class="card-raised-sm rounded-xl bg-white p-4" aria-label="<%= t("#{s}.activity") %>">
          <%= render "utility_accounts/activity", account:, scope: s %>
        </section>
      </div>
    </div>
  <% end %>
</div>
<% end %>
<%= render "household_settings/layout", current: account.model_name.singular.to_sym %>
