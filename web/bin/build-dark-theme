#!/usr/bin/env ruby
# Writes app/assets/tailwind/dark.css: Tailwind's palettes mirrored for dark mode (header theme menu).
# Run again after upgrading Tailwind so the colours match its palette.
require "tmpdir"

root = File.expand_path("..", __dir__)
css = Dir.mktmpdir do |dir|
  File.write("#{dir}/in.css", %(@import "tailwindcss" theme(static);\n))
  system("bundle", "exec", "tailwindcss", "-i", "#{dir}/in.css", "-o", "#{dir}/out.css", chdir: root, exception: true, err: File::NULL)
  File.read("#{dir}/out.css")
end

palettes = css.scan(/--color-([a-z]+)-(\d+):\s*([^;]+);/).each_with_object(Hash.new { |h, k| h[k] = {} }) { |(p, s, v), h| h[p][s] = v.strip }
white = css[/--color-white:\s*([^;]+);/, 1].strip
lines = []
palettes.each do |palette, shades|
  keys = %w[50 100 200 300 400 500 600 700 800 900 950].select { |k| shades[k] }
  # gray is the page's own scale, so white joins it (white <-> gray-950); the others mirror 50 <-> 950
  list = keys.map { |k| [ "#{palette}-#{k}", shades[k] ] }
  list.unshift([ "white", white ]) if palette == "gray"
  list.each_with_index { |(name, _), i| lines << "--color-#{name}: #{list[-1 - i][1]};" }
end
lines << "--color-black: #{white};"
vars = ->(indent) { lines.map { |l| (" " * indent) + l }.join("\n") }

File.write("#{root}/app/assets/tailwind/dark.css", <<~CSS)
  /* Dark mode (header theme menu): the cookie puts data-theme="light|dark|system" on <html>.
     Every palette is mirrored (50 <-> 950, 100 <-> 900, ...; white <-> gray-950), so existing
     classes like bg-white, text-gray-700 or bg-red-50 turn dark without dark: variants.
     Generated by bin/build-dark-theme; don't edit by hand. */
  @custom-variant dark {
    &:where([data-theme="dark"], [data-theme="dark"] *) { @slot; }
    @media (prefers-color-scheme: dark) {
      &:where([data-theme="system"], [data-theme="system"] *) { @slot; }
    }
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    background-color: var(--color-white);
    color: var(--color-gray-950);
  #{vars.(2)}
  }

  @media (prefers-color-scheme: dark) {
    :root[data-theme="system"] {
      color-scheme: dark;
      background-color: var(--color-white);
      color: var(--color-gray-950);
  #{vars.(4)}
    }
  }
CSS
puts "Wrote app/assets/tailwind/dark.css (#{palettes.size} palettes)"
