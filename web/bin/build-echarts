#!/usr/bin/env bash
# Builds vendor/javascript/echarts.js from vendor/echarts/entry.js (custom build, PRD §8 / X6).
# Needs Node; the app itself doesn't. Bump the versions here to upgrade.
set -euo pipefail

ECHARTS_VERSION=6.1.0
ESBUILD_VERSION=0.28.2

root="$(cd "$(dirname "$0")/.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

cp "$root/vendor/echarts/entry.js" "$work/"
cd "$work"
npm init -y >/dev/null
npm install --silent --no-audit --no-fund "echarts@$ECHARTS_VERSION" "esbuild@$ESBUILD_VERSION"
npx esbuild entry.js --bundle --minify --format=esm --legal-comments=eof \
  --banner:js="/* ECharts $ECHARTS_VERSION custom build (bar, line, pie, boxplot, scatter). Generated by bin/build-echarts. */" \
  --outfile="$root/vendor/javascript/echarts.js"
